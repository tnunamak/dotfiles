{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.local/bin/research-capture-detect' 2>/dev/null"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.local/bin/research-capture-nudge' 2>/dev/null"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.config/tmux/scripts/tmux-agent-label-hook.sh' codex working"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.local/bin/research-capture-detect-codex' 2>/dev/null"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.config/tmux/scripts/tmux-agent-label-hook.sh' codex idle"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.local/bin/research-autocapture' 2>/dev/null"
          }
        ]
      }
    ]
  }
}
