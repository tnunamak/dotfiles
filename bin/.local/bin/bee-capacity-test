#!/usr/bin/env python3
"""Safely test a non-persistent four-slot Bee candidate.

The controller is deliberately *not* the transaction owner.  It can preflight,
stop the known-good unit, start a transient candidate, prove the candidate, and
send heartbeats.  A separately supervised transient user service owns the
durable receipt and is solely responsible for this terminal transition:

    stop candidate -> prove its cgroup empty -> start known-good -> verify
    exact identity/argv/environment/GPU/port/health -> write restore ack

If the controller, candidate, terminal, or controller cgroup disappears, a
stale heartbeat grants that owner cleanup authority.  This relies on the user
systemd manager surviving; losing that manager also loses both user services.

No persistent unit/drop-in is changed.  Default operation is a no-effect plan.
The candidate is a non-blocking transient *service*, never a scope.  Its
wrapper is run via ``env -i`` so a user manager's arbitrary inherited
environment cannot leak into the trial.
"""

from __future__ import annotations

import argparse
import concurrent.futures
import fcntl
import hashlib
import hmac
import json
import os
import shlex
import stat
import subprocess
import sys
import time
import urllib.error
import urllib.request
import uuid
from dataclasses import dataclass
from pathlib import Path
from threading import Barrier
from typing import Callable, Iterable, Protocol


DEFAULT_UNIT = "llama-bee.service"
DEFAULT_CANDIDATE_PORT = 5151
DEFAULT_KNOWN_GOOD_PORT = 5051
DEFAULT_PARALLEL = 4
DEFAULT_CTX = 131072
DEFAULT_GPU_INDEX = 1
DEFAULT_PHASE_TIMEOUT_SECONDS = 180.0
DEFAULT_HEARTBEAT_SECONDS = 15.0
DEFAULT_ROLLBACK_DEADLINE_SECONDS = 1200.0
DEFAULT_POLL_SECONDS = 2.0
DEFAULT_VRAM_FLOOR_MIB = 2048
DEFAULT_START_SCRIPT = str(Path.home() / ".local/bin/llama-bee-start")
DEFAULT_N_GPU_LAYERS = 999
DEFAULT_BATCH_SIZE = 2048
DEFAULT_UBATCH_SIZE = 512
MAX_N_GPU_LAYERS = 999
MAX_BATCH_SIZE = 2048
MEBIBYTE = 1024 * 1024
MAX_CACHE_RAM_BYTES = 32 * 1024 * 1024 * 1024
REQUEST_COUNT = 4
CANDIDATE_SLICE = "app-beecapacity.slice"

# This is the complete interface the wrapper currently consumes.  It is an
# allowlist, not a prefix match: an unknown manager variable can never hitch a
# ride into the candidate.  Required managed fields are intentionally here.
ALLOWED_BEE_ENV = frozenset({
    "LLAMA_BEE_APPLICATIONS_DIR", "LLAMA_BEE_DIR", "LLAMA_BEE_SERVER",
    "LLAMA_BEE_GPU_BUDGET_FILE", "LLAMA_BEE_MODEL", "LLAMA_BEE_MMPROJ",
    "LLAMA_BEE_PORT", "LLAMA_BEE_PARALLEL", "LLAMA_BEE_CTX",
    "LLAMA_BEE_CTX_CHECKPOINTS", "LLAMA_BEE_CHECKPOINT_MIN_STEP",
    "LLAMA_BEE_CACHE_RAM", "LLAMA_BEE_CTK", "LLAMA_BEE_CTV",
    "LLAMA_BEE_CHAT_TEMPLATE", "LLAMA_BEE_CHAT_TEMPLATE_KWARGS",
    "LLAMA_BEE_MTP", "LLAMA_BEE_MTP_MAX", "LLAMA_BEE_NO_MMPROJ_OFFLOAD",
    "LLAMA_BEE_TENSOR_SPLIT", "LLAMA_BEE_VISIBLE_DEVICES",
})
REQUIRED_MANAGED_ENV = frozenset({"LLAMA_BEE_MODEL", "LLAMA_BEE_CTK", "LLAMA_BEE_CTV"})
SAFE_RUNTIME_ENV = {"PATH": "/usr/bin:/bin"}
CANDIDATE_OVERRIDE_ENV = frozenset({
    "LLAMA_BEE_CANDIDATE_OVERRIDES", "LLAMA_BEE_CANDIDATE_N_GPU_LAYERS",
    "LLAMA_BEE_CANDIDATE_BATCH_SIZE", "LLAMA_BEE_CANDIDATE_UBATCH_SIZE",
    "LLAMA_BEE_CANDIDATE_SERVER_PATH", "LLAMA_BEE_CANDIDATE_SERVER_SHA256",
    "LLAMA_BEE_CANDIDATE_CHECKPOINT_MIN_STEP", "LLAMA_BEE_CANDIDATE_CACHE_RAM_MIB",
})


@dataclass(frozen=True)
class CandidateSpec:
    """The complete, bounded candidate-only command surface.

    Every supplied value is serialized into both the operator approval and the
    durable receipt.  They are never accepted as free-form argv or inherited
    environment.  Optional controls remain absent unless an operator supplies
    them, preserving the known-good wrapper's current behavior by default.
    """
    start_script: str
    port: int = DEFAULT_CANDIDATE_PORT
    parallel: int = DEFAULT_PARALLEL
    ctx_size: int = DEFAULT_CTX
    gpu_index: int = DEFAULT_GPU_INDEX
    n_gpu_layers: int = DEFAULT_N_GPU_LAYERS
    batch_size: int = DEFAULT_BATCH_SIZE
    ubatch_size: int = DEFAULT_UBATCH_SIZE
    server_path: str | None = None
    server_sha256: str | None = None
    checkpoint_min_step: int | None = None
    cache_ram_bytes: int | None = None

    def __post_init__(self) -> None:
        for name in ("port", "parallel", "ctx_size", "gpu_index", "n_gpu_layers", "batch_size", "ubatch_size"):
            if type(getattr(self, name)) is not int:
                raise ValueError(f"{name} must be an integer")
        if not 1 <= self.port <= 65535:
            raise ValueError("port must be in 1..65535")
        if self.parallel <= 0 or self.ctx_size <= 0 or self.gpu_index < 0:
            raise ValueError("port, parallel, and context must be positive; GPU index cannot be negative")
        if not 0 <= self.n_gpu_layers <= MAX_N_GPU_LAYERS:
            raise ValueError(f"n_gpu_layers must be in 0..{MAX_N_GPU_LAYERS}")
        if not 1 <= self.batch_size <= MAX_BATCH_SIZE:
            raise ValueError(f"batch_size must be in 1..{MAX_BATCH_SIZE}")
        if not 1 <= self.ubatch_size <= self.batch_size:
            raise ValueError("ubatch_size must be in 1..batch_size")
        if (self.server_path is None) != (self.server_sha256 is None):
            raise ValueError("server_path and server_sha256 must be supplied together")
        if self.server_path is not None:
            if type(self.server_path) is not str or not self.server_path:
                raise ValueError("server_path must be a non-empty string")
            path = Path(self.server_path)
            if not path.is_absolute() or ".." in path.parts or path.name != "llama-server":
                raise ValueError("server_path must be an absolute, normalized llama-server path")
            if type(self.server_sha256) is not str or len(self.server_sha256) != 64 or any(character not in "0123456789abcdef" for character in self.server_sha256):
                raise ValueError("server_sha256 must be a lowercase SHA-256 hex digest")
        if self.checkpoint_min_step is not None:
            if type(self.checkpoint_min_step) is not int or not 0 <= self.checkpoint_min_step <= self.ctx_size:
                raise ValueError("checkpoint_min_step must be in 0..ctx_size")
        if self.cache_ram_bytes is not None:
            if type(self.cache_ram_bytes) is not int or not 0 <= self.cache_ram_bytes <= MAX_CACHE_RAM_BYTES:
                raise ValueError(f"cache_ram_bytes must be in 0..{MAX_CACHE_RAM_BYTES}")
            if self.cache_ram_bytes % MEBIBYTE:
                raise ValueError("cache_ram_bytes must be an exact multiple of 1048576")

    def to_json(self) -> dict:
        result = {
            "start_script": self.start_script, "port": self.port, "parallel": self.parallel,
            "ctx_size": self.ctx_size, "gpu_index": self.gpu_index,
            "n_gpu_layers": self.n_gpu_layers, "batch_size": self.batch_size,
            "ubatch_size": self.ubatch_size,
        }
        for name in ("server_path", "server_sha256", "checkpoint_min_step", "cache_ram_bytes"):
            value = getattr(self, name)
            if value is not None:
                result[name] = value
        return result

    @staticmethod
    def from_json(data: dict) -> "CandidateSpec":
        required = {"start_script", "port", "parallel", "ctx_size", "gpu_index", "n_gpu_layers", "batch_size", "ubatch_size"}
        optional = {"server_path", "server_sha256", "checkpoint_min_step", "cache_ram_bytes"}
        if not required <= set(data) or set(data) - required - optional:
            raise ValueError("candidate_spec contains unexpected or missing approved candidate fields")
        return CandidateSpec(**data)

    def verify_server_identity(self, allowed_root: Path | None = None) -> None:
        """Prove an explicitly selected candidate binary is policy-bound and unchanged."""
        if self.server_path is None:
            return
        path = Path(self.server_path)
        try:
            root = (allowed_root or Path.home() / "applications").resolve(strict=True)
            resolved = path.resolve(strict=True)
        except OSError as error:
            raise ValueError(f"candidate server policy path cannot be resolved: {error}") from error
        if resolved != path or root not in resolved.parents or not stat.S_ISREG(resolved.stat().st_mode) or not os.access(resolved, os.X_OK):
            raise ValueError("server_path must be an executable non-symlink below ~/applications")
        before = resolved.stat()
        digest = hashlib.sha256()
        with resolved.open("rb") as source:
            for block in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(block)
        after = resolved.stat()
        if (before.st_dev, before.st_ino, before.st_size, before.st_mtime_ns) != (after.st_dev, after.st_ino, after.st_size, after.st_mtime_ns):
            raise ValueError("server binary changed while its identity was verified")
        if not hmac.compare_digest(digest.hexdigest(), self.server_sha256):
            raise ValueError("server binary SHA-256 does not match server_sha256")

    def environment(self, loaded: dict[str, str]) -> dict[str, str]:
        """Replay only approved managed state plus this typed candidate spec."""
        unknown = set(loaded) - ALLOWED_BEE_ENV
        missing = REQUIRED_MANAGED_ENV - set(loaded)
        conflicts = set(loaded) & CANDIDATE_OVERRIDE_ENV
        if unknown or missing or conflicts:
            raise ValueError(f"loaded environment is not a clean candidate base (unknown={sorted(unknown)}, missing={sorted(missing)}, conflicts={sorted(conflicts)})")
        env = dict(loaded)
        env.update({
            "LLAMA_BEE_PORT": str(self.port), "LLAMA_BEE_PARALLEL": str(self.parallel),
            "LLAMA_BEE_CTX": str(self.ctx_size), "LLAMA_BEE_VISIBLE_DEVICES": str(self.gpu_index),
            "LLAMA_BEE_CANDIDATE_OVERRIDES": "1",
            "LLAMA_BEE_CANDIDATE_N_GPU_LAYERS": str(self.n_gpu_layers),
            "LLAMA_BEE_CANDIDATE_BATCH_SIZE": str(self.batch_size),
            "LLAMA_BEE_CANDIDATE_UBATCH_SIZE": str(self.ubatch_size),
        })
        if self.server_path is not None:
            env.pop("LLAMA_BEE_SERVER", None)
            env.update({"LLAMA_BEE_CANDIDATE_SERVER_PATH": self.server_path,
                        "LLAMA_BEE_CANDIDATE_SERVER_SHA256": self.server_sha256})
        if self.checkpoint_min_step is not None:
            env.pop("LLAMA_BEE_CHECKPOINT_MIN_STEP", None)
            env["LLAMA_BEE_CANDIDATE_CHECKPOINT_MIN_STEP"] = str(self.checkpoint_min_step)
        if self.cache_ram_bytes is not None:
            env.pop("LLAMA_BEE_CACHE_RAM", None)
            env["LLAMA_BEE_CANDIDATE_CACHE_RAM_MIB"] = str(self.cache_ram_bytes // MEBIBYTE)
        return env

    def argv(self, loaded: dict[str, str]) -> list[str]:
        # env -i is essential for user services: Environment= alone cannot
        # subtract arbitrary variables inherited by the user service manager.
        # The wrapper's shebang needs PATH; HOME is reconstructed only from
        # the loaded approved wrapper path, not inherited from the controller.
        script_path = Path(self.start_script).expanduser()
        home = str(script_path.parents[2]) if script_path.is_absolute and len(script_path.parents) > 2 else str(Path.home())
        clean_runtime = {**SAFE_RUNTIME_ENV, "HOME": home}
        pairs = [f"{key}={value}" for key, value in sorted({**clean_runtime, **self.environment(loaded)}.items())]
        return ["/usr/bin/env", "-i", *pairs, self.start_script, "--kv-unified"]


class CommandRunner(Protocol):
    def __call__(self, command: list[str], timeout: float) -> subprocess.CompletedProcess[bytes]: ...


def default_runner(command: list[str], timeout: float) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(command, capture_output=True, timeout=timeout)


def state_directory() -> Path:
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "bee-capacity-test"


def parse_systemctl_show(output: str) -> dict[str, str]:
    return dict(line.split("=", 1) for line in output.splitlines() if "=" in line)


def parse_environment_dict(line: str) -> dict[str, str]:
    return {key: value for token in shlex.split(line) if "=" in token for key, value in [token.split("=", 1)]}


def parse_exec_argv(exec_start: str) -> tuple[str, ...]:
    """Parse systemd's one-command ``ExecStart={ ... argv[]=... ; }`` form."""
    marker = "argv[]="
    if marker not in exec_start:
        return ()
    value = exec_start.split(marker, 1)[1].split(" ;", 1)[0].strip()
    try:
        return tuple(shlex.split(value))
    except ValueError:
        return ()


def canonical_hash(text: str) -> str:
    normalized = text.replace("\r\n", "\n").replace("\r", "\n")
    if normalized and not normalized.endswith("\n"):
        normalized += "\n"
    return hashlib.sha256(normalized.encode()).hexdigest()


def derive_known_good_port(environment: dict[str, str], exec_argv: tuple[str, ...]) -> int | None:
    """Use loaded effective config, never the candidate's alternate port."""
    candidate = environment.get("LLAMA_BEE_PORT")
    if candidate is None:
        for index, value in enumerate(exec_argv):
            if value == "--port" and index + 1 < len(exec_argv):
                candidate = exec_argv[index + 1]
                break
    if candidate is None:
        return DEFAULT_KNOWN_GOOD_PORT
    try:
        port = int(candidate)
    except ValueError:
        return None
    return port if 1 <= port <= 65535 else None


def parse_gpu_index(environment: dict[str, str]) -> int | None:
    value = environment.get("LLAMA_BEE_VISIBLE_DEVICES", str(DEFAULT_GPU_INDEX))
    try:
        return int(value)
    except ValueError:
        return None


@dataclass(frozen=True)
class ApprovedSnapshot:
    """Operator-provided content hashes.  Preflight never blesses new drift."""
    fragment_hash: str
    drop_in_hashes: dict[str, str]
    exec_start: tuple[str, ...]
    environment: dict[str, str]
    candidate_spec: CandidateSpec | None = None

    @staticmethod
    def from_json(data: dict) -> "ApprovedSnapshot":
        return ApprovedSnapshot(
            fragment_hash=data["fragment_hash"],
            drop_in_hashes=dict(data["drop_in_hashes"]),
            exec_start=tuple(data["exec_start"]),
            environment=dict(data["environment"]),
            candidate_spec=CandidateSpec.from_json(data["candidate_spec"]) if data.get("candidate_spec") is not None else None,
        )

    def content_hash(self) -> str:
        contents = {
            "fragment_hash": self.fragment_hash,
            "drop_in_hashes": self.drop_in_hashes,
            "exec_start": self.exec_start,
            "environment": self.environment,
        }
        if self.candidate_spec is not None:
            contents["candidate_spec"] = self.candidate_spec.to_json()
        return canonical_hash(json.dumps(contents, sort_keys=True, separators=(",", ":")))


@dataclass(frozen=True)
class KnownGoodSnapshot:
    unit: str
    fragment_path: str
    fragment_hash: str
    drop_in_hashes: dict[str, str]
    environment: dict[str, str]
    exec_start: tuple[str, ...]
    main_pid: int
    control_group: str
    port: int
    gpu_index: int
    approved_hash: str

    def identity(self) -> dict:
        return {
            "fragment_path": self.fragment_path, "fragment_hash": self.fragment_hash,
            "drop_in_hashes": self.drop_in_hashes, "environment": self.environment,
            "exec_start": self.exec_start, "port": self.port, "gpu_index": self.gpu_index,
            "approved_hash": self.approved_hash,
        }

    def to_json(self) -> dict:
        return {**self.identity(), "unit": self.unit, "main_pid": self.main_pid, "control_group": self.control_group}

    @staticmethod
    def from_json(data: dict) -> "KnownGoodSnapshot":
        return KnownGoodSnapshot(
            unit=data["unit"], fragment_path=data["fragment_path"], fragment_hash=data["fragment_hash"],
            drop_in_hashes=dict(data["drop_in_hashes"]), environment=dict(data["environment"]),
            exec_start=tuple(data["exec_start"]), main_pid=int(data["main_pid"]),
            control_group=data["control_group"], port=int(data["port"]), gpu_index=int(data["gpu_index"]),
            approved_hash=data["approved_hash"],
        )


@dataclass(frozen=True)
class PreflightFailure:
    reason: str


class PreflightInspector:
    """Read-only loaded-unit identity capture and approval comparison."""

    def __init__(self, runner: CommandRunner, systemctl_bin: str, unit: str, approved: ApprovedSnapshot,
                 health: Callable[[int], bool], read_text: Callable[[str], str], timeout: float,
                 expected_gpu: int = DEFAULT_GPU_INDEX) -> None:
        self.runner, self.systemctl_bin, self.unit = runner, systemctl_bin, unit
        self.approved, self.health, self.read_text, self.timeout, self.expected_gpu = approved, health, read_text, timeout, expected_gpu

    def snapshot(self) -> KnownGoodSnapshot | PreflightFailure:
        command = [self.systemctl_bin, "--user", "show", self.unit,
                   "--property=ActiveState,FragmentPath,DropInPaths,MainPID,ControlGroup,Environment,ExecStart"]
        try:
            result = self.runner(command, self.timeout)
        except (OSError, subprocess.TimeoutExpired) as error:
            return PreflightFailure(f"systemctl show failed: {error}")
        if result.returncode:
            return PreflightFailure(f"systemctl show exited {result.returncode}")
        fields = parse_systemctl_show(result.stdout.decode(errors="replace"))
        if fields.get("ActiveState") != "active":
            return PreflightFailure("known-good is not active")
        fragment = fields.get("FragmentPath", "")
        drops = tuple(path for path in fields.get("DropInPaths", "").split() if path)
        if not fragment:
            return PreflightFailure("loaded unit has no FragmentPath")
        try:
            fragment_hash = canonical_hash(self.read_text(fragment))
            drop_hashes = {path: canonical_hash(self.read_text(path)) for path in drops}
        except (OSError, UnicodeError) as error:
            return PreflightFailure(f"cannot hash loaded unit content: {error}")
        environment = parse_environment_dict(fields.get("Environment", ""))
        unknown = sorted(set(environment) - ALLOWED_BEE_ENV)
        missing = sorted(REQUIRED_MANAGED_ENV - set(environment))
        if unknown or missing:
            return PreflightFailure(f"loaded Bee environment is not allowlisted (unknown={unknown}, missing={missing})")
        argv = parse_exec_argv(fields.get("ExecStart", ""))
        if not argv:
            return PreflightFailure("could not parse full loaded ExecStart argv")
        gpu, port = parse_gpu_index(environment), derive_known_good_port(environment, argv)
        if gpu != self.expected_gpu or port is None:
            return PreflightFailure(f"loaded GPU/port is invalid (gpu={gpu!r}, port={port!r})")
        try:
            main_pid = int(fields.get("MainPID", "0"))
        except ValueError:
            main_pid = 0
        cgroup = fields.get("ControlGroup", "")
        if main_pid <= 0 or not cgroup:
            return PreflightFailure("loaded unit has no live MainPID/cgroup")
        if not self.health(port):
            return PreflightFailure(f"known-good health failed on loaded port {port}")
        if (fragment_hash != self.approved.fragment_hash or drop_hashes != self.approved.drop_in_hashes
                or argv != self.approved.exec_start or environment != self.approved.environment):
            return PreflightFailure("loaded unit content/ExecStart/environment differs from operator-approved hash snapshot")
        return KnownGoodSnapshot(self.unit, fragment, fragment_hash, drop_hashes, environment, argv,
                                 main_pid, cgroup, port, gpu, self.approved.content_hash())


def candidate_unit_name(transaction_id: str) -> str:
    return f"bee-capacity-candidate-{transaction_id}.service"


def owner_unit_name(transaction_id: str) -> str:
    return f"bee-capacity-rollback-{transaction_id}.service"


def start_transient_service(runner: CommandRunner, systemd_run: str, unit: str, argv: list[str], timeout: float,
                            slice_name: str | None = None) -> bool:
    command = [systemd_run, "--user", "--no-block", "--unit=" + unit,
               # Do not use --collect/CollectMode=inactive-or-failed here:
               # teardown must successfully show NTasks=0 before restoration.
               "--property=Type=exec"]
    if slice_name:
        command.append("--slice=" + slice_name)
    command += ["--", *argv]
    try:
        return runner(command, timeout).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


@dataclass(frozen=True)
class CandidateIdentity:
    unit: str
    slice_name: str
    control_group: str
    main_pid: int | None

    def to_json(self) -> dict:
        return {"unit": self.unit, "slice_name": self.slice_name, "control_group": self.control_group, "main_pid": self.main_pid}

    @staticmethod
    def from_json(data: dict) -> "CandidateIdentity":
        main_pid = data.get("main_pid")
        return CandidateIdentity(data["unit"], data["slice_name"], data["control_group"], int(main_pid) if main_pid is not None else None)


def expected_candidate_identity(unit: str, uid: int | None = None) -> CandidateIdentity:
    """Derive the unique service cgroup under the controlled user slice.

    systemd.slice(5) defines ``app-beecapacity.slice`` as a child of
    ``app.slice``. systemd.special(7) places user services below app.slice;
    the user manager cgroup prefix is keyed by the caller's UID.
    """
    if not unit.endswith(".service") or "/" in unit:
        raise ValueError(f"unsafe transient candidate unit {unit!r}")
    actual_uid = os.getuid() if uid is None else uid
    parent = f"/user.slice/user-{actual_uid}.slice/user@{actual_uid}.service/app.slice/{CANDIDATE_SLICE}"
    return CandidateIdentity(unit, CANDIDATE_SLICE, parent + "/" + unit, None)


def has_expected_candidate_location(identity: CandidateIdentity | None, unit: str) -> bool:
    """Accept only the derived location; MainPID is bound separately."""
    try:
        expected = expected_candidate_identity(unit)
    except ValueError:
        return False
    return bool(identity and (identity.unit, identity.slice_name, identity.control_group) ==
                (expected.unit, expected.slice_name, expected.control_group))


@dataclass(frozen=True)
class CandidateUnitState:
    load_state: str
    slice_name: str
    active_state: str
    main_pid: int
    control_group: str
    n_tasks: int

    @property
    def definitively_not_loaded(self) -> bool:
        return self.load_state == "not-found"

    def observed_main_pid(self) -> int | None:
        if self.load_state == "loaded" and self.active_state == "active" and self.main_pid > 0 and self.n_tasks > 0 and self.control_group:
            return self.main_pid
        return None


def read_candidate_unit_state(runner: CommandRunner, systemctl: str, unit: str, timeout: float) -> CandidateUnitState | None:
    try:
        result = runner([systemctl, "--user", "show", unit, "--property=LoadState,Slice,ActiveState,MainPID,ControlGroup,NTasks"], timeout)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode:
        return None
    fields = parse_systemctl_show(result.stdout.decode(errors="replace"))
    try:
        return CandidateUnitState(fields.get("LoadState", ""), fields.get("Slice", ""), fields.get("ActiveState", ""), int(fields.get("MainPID", "0")), fields.get("ControlGroup", ""), int(fields.get("NTasks", "-1")))
    except ValueError:
        return None


def bind_running_candidate(runner: CommandRunner, systemctl: str, expected: CandidateIdentity, timeout: float) -> CandidateIdentity | None:
    state = read_candidate_unit_state(runner, systemctl, expected.unit, timeout)
    if state is None:
        return None
    pid = state.observed_main_pid()
    if pid is None or state.slice_name != expected.slice_name or state.control_group != expected.control_group:
        return None
    return CandidateIdentity(expected.unit, expected.slice_name, expected.control_group, pid)


def unit_is_running(runner: CommandRunner, systemctl: str, unit: str, timeout: float) -> bool:
    """Check a transient owner service without assigning candidate identity."""
    state = read_candidate_unit_state(runner, systemctl, unit, timeout)
    return bool(state and state.load_state == "loaded" and state.active_state == "active" and state.main_pid > 0 and state.n_tasks > 0 and state.control_group)


def default_cgroup_members(control_group: str) -> tuple[bool, tuple[int, ...], tuple[int, ...]]:
    """Return existence, processes, and threads for an exact systemd cgroup."""
    root = Path("/sys/fs/cgroup").resolve()
    relative = Path(control_group.lstrip("/"))
    target = (root / relative).resolve()
    if root not in (target, *target.parents):
        raise OSError("unsafe cgroup path")
    if not target.exists():
        return False, (), ()
    def members(name: str) -> tuple[int, ...]:
        content = (target / name).read_text(encoding="utf-8")
        return tuple(int(value) for value in content.split() if value)
    return True, members("cgroup.procs"), members("cgroup.threads")


def default_pid_cgroup(pid: int) -> str | None:
    try:
        for line in (Path("/proc") / str(pid) / "cgroup").read_text(encoding="utf-8").splitlines():
            if line.startswith("0::"):
                return line.split("::", 1)[1]
    except FileNotFoundError:
        return None
    raise OSError(f"cannot inspect cgroup for PID {pid}")


def candidate_cgroup_is_proven_empty(identity: CandidateIdentity,
                                     cgroup_members: Callable[[str], tuple[bool, tuple[int, ...], tuple[int, ...]]],
                                     pid_cgroup: Callable[[int], str | None]) -> bool:
    """A missing cgroup is safe only with a recorded/derived identity.

    A reused PID is not assumed dead: it is accepted only when its currently
    inspected cgroup differs from the recorded candidate cgroup.
    """
    try:
        exists, processes, threads = cgroup_members(identity.control_group)
        observed_pid_cgroup = pid_cgroup(identity.main_pid) if identity.main_pid is not None else None
    except (OSError, ValueError):
        return False
    if processes or threads:
        return False
    if observed_pid_cgroup == identity.control_group:
        return False
    return True


def stop_and_prove_candidate_absent(
    runner: CommandRunner,
    systemctl: str,
    unit: str,
    identity: CandidateIdentity | None,
    timeout: float,
    cgroup_members: Callable[[str], tuple[bool, tuple[int, ...], tuple[int, ...]]],
    pid_cgroup: Callable[[int], str | None],
    bind_identity: Callable[[CandidateIdentity], None] | None = None,
) -> tuple[bool, CandidateIdentity | None]:
    """Stop a live candidate or prove a recorded/derived dead one is gone.

    A generic stop/show error is never accepted.  The sole positive absence
    path is a successful ``show`` reporting ``LoadState=not-found`` together
    with exact cgroup/PID evidence from a recorded or currently derived ID.
    """
    before = read_candidate_unit_state(runner, systemctl, unit, timeout)
    if before is None:
        return False, identity
    if identity is None or identity.unit != unit:
        return False, None
    if before.definitively_not_loaded:
        return candidate_cgroup_is_proven_empty(identity, cgroup_members, pid_cgroup), identity
    # Loaded candidates must prove both the controlled Slice= and the complete
    # deterministic ControlGroup= before we bind or stop anything.
    if before.slice_name != identity.slice_name or before.control_group != identity.control_group:
        return False, identity
    observed_pid = before.observed_main_pid()
    if observed_pid is not None:
        if identity.main_pid is not None and identity.main_pid != observed_pid:
            return False, identity
        bound_identity = CandidateIdentity(identity.unit, identity.slice_name, identity.control_group, observed_pid)
        if bound_identity != identity and bind_identity is not None:
            # If the owner itself disappears after this point, the receipt
            # already identifies the exact process it was about to stop.
            bind_identity(bound_identity)
        identity = bound_identity
    try:
        stopped = runner([systemctl, "--user", "stop", unit], timeout)
    except (OSError, subprocess.TimeoutExpired):
        return False, identity
    after = read_candidate_unit_state(runner, systemctl, unit, timeout)
    if after is None:
        return False, identity
    if stopped.returncode and not after.definitively_not_loaded:
        return False, identity
    if after.definitively_not_loaded:
        return candidate_cgroup_is_proven_empty(identity, cgroup_members, pid_cgroup), identity
    if after.slice_name != identity.slice_name or after.control_group != identity.control_group:
        return False, identity
    if identity.main_pid is not None and after.main_pid > 0 and after.main_pid != identity.main_pid:
        return False, identity
    if after.n_tasks != 0:
        return False, identity
    return candidate_cgroup_is_proven_empty(identity, cgroup_members, pid_cgroup), identity


def stop_known_good_and_prove_empty(runner: CommandRunner, systemctl: str, unit: str, timeout: float) -> bool:
    # Known-good must be inactive; unlike a candidate failed is not an accepted stopped state.
    try:
        stopped = runner([systemctl, "--user", "stop", unit], timeout)
        shown = runner([systemctl, "--user", "show", unit, "--property=NTasks,ActiveState"], timeout)
    except (OSError, subprocess.TimeoutExpired):
        return False
    if stopped.returncode or shown.returncode:
        return False
    fields = parse_systemctl_show(shown.stdout.decode(errors="replace"))
    try:
        return fields.get("ActiveState") == "inactive" and int(fields["NTasks"]) == 0
    except (KeyError, ValueError):
        return False


@dataclass
class TransactionReceipt:
    transaction_id: str
    unit: str
    candidate_unit: str
    snapshot: KnownGoodSnapshot
    deadline: float
    heartbeat_seconds: float
    controller_heartbeat: float
    candidate_identity: CandidateIdentity | None = None
    candidate_spec: CandidateSpec | None = None
    controller_phase: str = "armed"
    owner_phase: str = "armed"
    restore_attempts: int = 0
    restore_ack: bool = False

    def to_json(self) -> dict:
        return {**self.__dict__, "snapshot": self.snapshot.to_json(),
                "candidate_identity": self.candidate_identity.to_json() if self.candidate_identity else None,
                "candidate_spec": self.candidate_spec.to_json() if self.candidate_spec else None}

    @staticmethod
    def from_json(data: dict) -> "TransactionReceipt":
        copy = dict(data)
        copy["snapshot"] = KnownGoodSnapshot.from_json(copy["snapshot"])
        if copy.get("candidate_identity") is not None:
            copy["candidate_identity"] = CandidateIdentity.from_json(copy["candidate_identity"])
        if copy.get("candidate_spec") is not None:
            copy["candidate_spec"] = CandidateSpec.from_json(copy["candidate_spec"])
        return TransactionReceipt(**copy)


class ReceiptStore:
    """A private disk-backed receipt.  Atomic replacements make each phase durable."""
    def __init__(self, root: Path) -> None:
        self.root = root

    @classmethod
    def from_receipt_path(cls, receipt_path: Path) -> "ReceiptStore":
        return cls(receipt_path.parent.parent)

    def receipt_path(self, transaction_id: str) -> Path:
        return self.root / transaction_id / "receipt.json"

    def write(self, receipt: TransactionReceipt) -> Path:
        directory = self.receipt_path(receipt.transaction_id).parent
        directory.mkdir(parents=True, exist_ok=True, mode=0o700)
        os.chmod(directory, 0o700)
        destination = directory / "receipt.json"
        self._write_path(destination, receipt)
        return destination

    @staticmethod
    def _write_path(destination: Path, receipt: TransactionReceipt) -> None:
        directory = destination.parent
        temporary = directory / ".receipt.tmp"
        temporary.write_text(json.dumps(receipt.to_json(), sort_keys=True), encoding="utf-8")
        os.chmod(temporary, 0o600)
        os.replace(temporary, destination)

    def read(self, receipt_path: Path) -> TransactionReceipt:
        return TransactionReceipt.from_json(json.loads(receipt_path.read_text(encoding="utf-8")))

    def update(self, receipt_path: Path, mutate: Callable[[TransactionReceipt], None]) -> TransactionReceipt:
        lock_path = receipt_path.parent / ".receipt.lock"
        with lock_path.open("a", encoding="utf-8") as lock:
            fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
            try:
                receipt = self.read(receipt_path)
                mutate(receipt)
                self._write_path(receipt_path, receipt)
                return receipt
            finally:
                fcntl.flock(lock.fileno(), fcntl.LOCK_UN)


def verify_exact_restore(snapshot: KnownGoodSnapshot, inspector: PreflightInspector) -> bool:
    live = inspector.snapshot()
    return isinstance(live, KnownGoodSnapshot) and live.identity() == snapshot.identity()


class RollbackOwner:
    """The sole cleanup/restore authority; instantiated from receipt path only."""
    def __init__(self, receipt_path: Path, runner: CommandRunner, inspector: PreflightInspector,
                 logger: Callable[[str], None], wall_clock: Callable[[], float], sleeper: Callable[[float], None],
                 poll_seconds: float = DEFAULT_POLL_SECONDS,
                 cgroup_members: Callable[[str], tuple[bool, tuple[int, ...], tuple[int, ...]]] = default_cgroup_members,
                 pid_cgroup: Callable[[int], str | None] = default_pid_cgroup) -> None:
        self.receipt_path, self.store = receipt_path, ReceiptStore.from_receipt_path(receipt_path)
        self.runner, self.inspector, self.logger, self.wall_clock, self.sleeper, self.poll_seconds = runner, inspector, logger, wall_clock, sleeper, poll_seconds
        self.cgroup_members, self.pid_cgroup = cgroup_members, pid_cgroup

    def _update(self, mutate: Callable[[TransactionReceipt], None]) -> TransactionReceipt:
        return self.store.update(self.receipt_path, mutate)

    def recover_with(self, systemctl: str, timeout: float) -> bool:
        receipt = self.store.read(self.receipt_path)
        if receipt.restore_ack:
            return True
        if not has_expected_candidate_location(receipt.candidate_identity, receipt.candidate_unit):
            self._update(lambda item: setattr(item, "owner_phase", "candidate-identity-invalid"))
            return False
        self._update(lambda item: setattr(item, "owner_phase", "stopping-candidate"))
        stopped, identity = stop_and_prove_candidate_absent(
            self.runner, systemctl, receipt.candidate_unit, receipt.candidate_identity, timeout,
            self.cgroup_members, self.pid_cgroup,
            lambda bound: self._update(lambda item: setattr(item, "candidate_identity", bound)),
        )
        if identity and identity != receipt.candidate_identity:
            self._update(lambda item: setattr(item, "candidate_identity", identity))
        if not stopped:
            self._update(lambda item: setattr(item, "owner_phase", "candidate-not-empty"))
            return False
        self._update(lambda item: setattr(item, "owner_phase", "restoring-known-good"))
        self._update(lambda item: setattr(item, "restore_attempts", item.restore_attempts + 1))
        try:
            started = self.runner([systemctl, "--user", "start", receipt.unit], timeout)
        except (OSError, subprocess.TimeoutExpired):
            started = None
        if started is None or started.returncode or not verify_exact_restore(receipt.snapshot, self.inspector):
            self._update(lambda item: setattr(item, "owner_phase", "restore-unverified"))
            return False
        self._update(lambda item: (setattr(item, "owner_phase", "complete"), setattr(item, "restore_ack", True)))
        return True

    def run(self, systemctl: str, timeout: float) -> bool:
        """Remain armed until verified restore; expiry takes authority, never blind-starts."""
        while True:
            receipt = self.store.read(self.receipt_path)
            now = self.wall_clock()
            stale = now - receipt.controller_heartbeat >= receipt.heartbeat_seconds
            requested = receipt.controller_phase == "cleanup-requested"
            expired = now >= receipt.deadline
            if requested or stale or expired:
                if expired:
                    self._update(lambda item: setattr(item, "owner_phase", "deadline-cleanup"))
                if self.recover_with(systemctl, timeout):
                    return True
                self.logger(f"rollback remains armed; candidate teardown or exact restore not yet verified (attempt {receipt.restore_attempts + 1})")
            self.sleeper(self.poll_seconds)


@dataclass(frozen=True)
class GateFailure:
    gate: str
    reason: str


def http_get_json(url: str, timeout: float) -> dict | list | None:
    try:
        with urllib.request.urlopen(url, timeout=timeout) as response:  # noqa: S310 local endpoint
            return json.loads(response.read().decode())
    except (urllib.error.URLError, urllib.error.HTTPError, OSError, TimeoutError, ValueError, json.JSONDecodeError):
        return None


def http_post_json(url: str, payload: dict, timeout: float) -> tuple[int, dict | None]:
    request = urllib.request.Request(url, data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"}, method="POST")  # noqa: S310
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 local endpoint
            body = json.loads(response.read().decode())
            return response.status, body if isinstance(body, dict) else None
    except urllib.error.HTTPError as error:
        return error.code, None
    except (urllib.error.URLError, OSError, TimeoutError, ValueError, json.JSONDecodeError):
        return 0, None


def structural_difference(expected: object, actual: object, dynamic: set[tuple[str, ...]], path: tuple[str, ...] = ()) -> str | None:
    if type(expected) is not type(actual):
        return f"type drift at {'.'.join(path) or '<root>'}"
    if path in dynamic:
        return None
    if isinstance(expected, dict):
        if set(expected) != set(actual):
            return f"key drift at {'.'.join(path) or '<root>'}: expected {sorted(expected)}, got {sorted(actual)}"
        for key in expected:
            difference = structural_difference(expected[key], actual[key], dynamic, path + (key,))
            if difference:
                return difference
    elif isinstance(expected, list):
        if len(expected) != len(actual):
            return f"list length drift at {'.'.join(path)}"
        for index, (left, right) in enumerate(zip(expected, actual)):
            difference = structural_difference(left, right, dynamic, path + (str(index),))
            if difference:
                return difference
    elif expected != actual:
        return f"value drift at {'.'.join(path)}"
    return None


def make_props_gate(base_url: str, fixture: dict, parallel: int, context: int, timeout: float) -> Callable[[], GateFailure | None]:
    context_path = ("default_generation_settings", "n_ctx") if isinstance(fixture.get("default_generation_settings"), dict) else ("n_ctx",)
    dynamic = {("total_slots",), context_path}
    def gate() -> GateFailure | None:
        live = http_get_json(base_url + "/props", timeout)
        if not isinstance(live, dict):
            return GateFailure("props", "unreachable or non-object /props")
        difference = structural_difference(fixture, live, dynamic)
        if difference:
            return GateFailure("props", difference)
        cursor: object = live
        for key in context_path:
            cursor = cursor.get(key) if isinstance(cursor, dict) else None
        if live.get("total_slots") != parallel or cursor != context:
            return GateFailure("props", f"capacity values are slots={live.get('total_slots')!r}, context={cursor!r}")
        return None
    return gate


def run_overlap_probe(base_url: str, timeout: float, get_slots: Callable[[str, float], dict | list | None] = http_get_json,
                      post: Callable[[str, dict, float], tuple[int, dict | None]] = http_post_json) -> GateFailure | None:
    """Fail closed unless /slots exposes each live request's slot and correlation.

    Smallest live oracle: while four requests wait, /slots must expose
    ``id_slot``, ``is_processing: true``, and a ``request_id`` equal to the
    request correlation.  The installed API has not been asserted to expose
    this shape; absence is a failed proof, not a simulated pass.
    """
    barrier = Barrier(REQUEST_COUNT + 1)
    request_ids = [f"bee-capacity-{uuid.uuid4()}-{slot}" for slot in range(REQUEST_COUNT)]
    def worker(slot: int) -> tuple[int, dict | None]:
        barrier.wait(timeout=timeout)
        return post(base_url + "/completion", {"prompt": request_ids[slot], "n_predict": 32,
                                                  "id_slot": slot, "request_id": request_ids[slot]}, timeout)
    with concurrent.futures.ThreadPoolExecutor(max_workers=REQUEST_COUNT) as pool:
        futures = [pool.submit(worker, slot) for slot in range(REQUEST_COUNT)]
        barrier.wait(timeout=timeout)
        slots = get_slots(base_url + "/slots", timeout)
        outcomes = [future.result(timeout=timeout) for future in futures]
    if not isinstance(slots, list):
        return GateFailure("overlap", "/slots is unavailable; no live-slot oracle")
    observed = {(item.get("id_slot"), item.get("request_id")) for item in slots
                if isinstance(item, dict) and item.get("is_processing") is True}
    expected = set(enumerate(request_ids))
    if observed != expected:
        return GateFailure("overlap", f"/slots cannot prove four correlated live slots (observed={observed!r})")
    for slot, (status, body) in enumerate(outcomes):
        if status != 200 or not isinstance(body, dict) or body.get("request_id") != request_ids[slot] or body.get("id_slot") != slot:
            return GateFailure("overlap", f"completion {slot} was not correlated and complete")
    return None


def make_health_checker(timeout: float) -> Callable[[int], bool]:
    return lambda port: http_get_json(f"http://127.0.0.1:{port}/health", timeout) == {"status": "ok"}


def safe_float(value: str, label: str, parser: argparse.ArgumentParser) -> float:
    try:
        number = float(value)
    except ValueError:
        parser.error(f"{label} must be a number, got {value!r}")
    if number <= 0:
        parser.error(f"{label} must be positive")
    return number


def parse_arguments(argv: Iterable[str] | None = None) -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--apply", action="store_true")
    parser.add_argument("--rollback-owner", type=Path)
    parser.add_argument("--receipt-path", type=Path)
    parser.add_argument("--props-fixture")
    parser.add_argument("--approved-snapshot")
    parser.add_argument("--state-dir", default=str(state_directory()))
    parser.add_argument("--unit", default=DEFAULT_UNIT)
    parser.add_argument("--start-script", default=DEFAULT_START_SCRIPT)
    parser.add_argument("--port", default=str(DEFAULT_CANDIDATE_PORT))
    parser.add_argument("--parallel", default=str(DEFAULT_PARALLEL))
    parser.add_argument("--ctx-size", default=str(DEFAULT_CTX))
    parser.add_argument("--gpu-index", default=str(DEFAULT_GPU_INDEX))
    parser.add_argument("--n-gpu-layers", default=str(DEFAULT_N_GPU_LAYERS))
    parser.add_argument("--batch-size", default=str(DEFAULT_BATCH_SIZE))
    parser.add_argument("--ubatch-size", default=str(DEFAULT_UBATCH_SIZE))
    parser.add_argument("--server-path", help="absolute ~/applications/.../llama-server path; requires --server-sha256")
    parser.add_argument("--server-sha256", help="lowercase SHA-256 for --server-path")
    parser.add_argument("--checkpoint-min-step", help="candidate checkpoint spacing in tokens (0..ctx-size)")
    parser.add_argument("--cache-ram-bytes", help="candidate prompt-cache limit in bytes, a whole MiB (0..32 GiB)")
    parser.add_argument("--phase-timeout-seconds", default=os.environ.get("BEE_CAPACITY_TEST_PHASE_TIMEOUT", str(DEFAULT_PHASE_TIMEOUT_SECONDS)))
    parser.add_argument("--heartbeat-seconds", default=os.environ.get("BEE_CAPACITY_TEST_HEARTBEAT", str(DEFAULT_HEARTBEAT_SECONDS)))
    parser.add_argument("--rollback-deadline-seconds", default=os.environ.get("BEE_CAPACITY_TEST_ROLLBACK_DEADLINE", str(DEFAULT_ROLLBACK_DEADLINE_SECONDS)))
    parser.add_argument("--systemctl-bin", default="systemctl")
    parser.add_argument("--systemd-run-bin", default="systemd-run")
    args = parser.parse_args(argv)
    for name in ("port", "parallel", "ctx_size", "gpu_index", "n_gpu_layers", "batch_size", "ubatch_size"):
        try:
            value = int(getattr(args, name))
        except ValueError:
            parser.error(f"--{name.replace('_', '-')} must be an integer")
        if name not in {"n_gpu_layers"} and value <= 0:
            parser.error(f"--{name.replace('_', '-')} must be a positive integer")
        setattr(args, name, value)
    try:
        CandidateSpec(args.start_script, args.port, args.parallel, args.ctx_size, args.gpu_index,
                      args.n_gpu_layers, args.batch_size, args.ubatch_size,
                      args.server_path, args.server_sha256,
                      int(args.checkpoint_min_step) if args.checkpoint_min_step is not None else None,
                      int(args.cache_ram_bytes) if args.cache_ram_bytes is not None else None)
    except ValueError as error:
        parser.error(str(error))
    except TypeError:
        parser.error("--checkpoint-min-step and --cache-ram-bytes must be integers")
    args.checkpoint_min_step = int(args.checkpoint_min_step) if args.checkpoint_min_step is not None else None
    args.cache_ram_bytes = int(args.cache_ram_bytes) if args.cache_ram_bytes is not None else None
    args.phase_timeout_seconds = safe_float(args.phase_timeout_seconds, "--phase-timeout-seconds", parser)
    args.heartbeat_seconds = safe_float(args.heartbeat_seconds, "--heartbeat-seconds", parser)
    args.rollback_deadline_seconds = safe_float(args.rollback_deadline_seconds, "--rollback-deadline-seconds", parser)
    minimum = args.phase_timeout_seconds * 5 + args.heartbeat_seconds * 2
    if args.rollback_deadline_seconds < minimum:
        parser.error(f"--rollback-deadline-seconds must cover five phase budgets plus heartbeat grace ({minimum:g}s minimum)")
    return args


class TransactionController:
    """Effectful controller with no restore/release authority."""
    def __init__(self, receipt_path: Path, store: ReceiptStore, inspector: PreflightInspector, runner: CommandRunner,
                 systemctl: str, systemd_run: str, candidate: CandidateSpec, props_fixture: dict,
                 timeout: float, heartbeat: float, logger: Callable[[str], None], wall_clock: Callable[[], float],
                 sleeper: Callable[[float], None]) -> None:
        self.receipt_path, self.store, self.inspector, self.runner = receipt_path, store, inspector, runner
        self.systemctl, self.systemd_run, self.candidate, self.props_fixture = systemctl, systemd_run, candidate, props_fixture
        self.timeout, self.heartbeat, self.logger, self.wall_clock, self.sleeper = timeout, heartbeat, logger, wall_clock, sleeper

    def report(self, phase: str) -> None:
        self.store.update(self.receipt_path, lambda item: (setattr(item, "controller_phase", phase), setattr(item, "controller_heartbeat", self.wall_clock())))

    def wait_for_ack(self) -> bool:
        end = self.wall_clock() + self.timeout
        while self.wall_clock() < end:
            if self.store.read(self.receipt_path).restore_ack:
                return True
            self.sleeper(min(self.heartbeat, end - self.wall_clock()))
        return self.store.read(self.receipt_path).restore_ack

    def run(self) -> bool:
        receipt = self.store.read(self.receipt_path)
        try:
            expected_identity = expected_candidate_identity(receipt.candidate_unit)
        except ValueError as error:
            self.logger(f"candidate receipt identity is invalid: {error}")
            return False
        # No launch is allowed unless the durable receipt already carries the
        # exact cgroup identity. A malformed/partial receipt must not turn a
        # controller crash into an unprovable candidate lifetime.
        if receipt.candidate_identity != expected_identity:
            self.logger("candidate receipt lacks the exact pre-recorded identity")
            return False
        if receipt.candidate_spec != self.candidate:
            self.logger("candidate receipt lacks the exact approved effective values")
            return False
        if not receipt.snapshot.exec_start or self.candidate.start_script != receipt.snapshot.exec_start[0]:
            self.logger("candidate wrapper differs from the approved known-good ExecStart")
            return False
        # A stale heartbeat means "no phase completion within one whole phase
        # budget plus grace", not merely "a blocking systemctl call is still
        # running".  This prevents the owner racing a healthy stop/start.
        io_timeout = min(self.timeout, max(1.0, self.heartbeat / 2))
        self.report("stopping-known-good")
        if not stop_known_good_and_prove_empty(self.runner, self.systemctl, receipt.unit, self.timeout):
            return False  # owner remains armed; stale heartbeat triggers its safe recovery
        self.report("starting-candidate")
        argv = self.candidate.argv(receipt.snapshot.environment)
        if not start_transient_service(self.runner, self.systemd_run, receipt.candidate_unit, argv, io_timeout, CANDIDATE_SLICE):
            return False
        identity = bind_running_candidate(self.runner, self.systemctl, expected_identity, io_timeout)
        if identity is None:
            return False
        # This durable write is the boundary after which owner may accept an
        # already-unloaded candidate as positively absent.
        self.store.update(self.receipt_path, lambda item: setattr(item, "candidate_identity", identity))
        self.report("proving-candidate")
        base_url = f"http://127.0.0.1:{self.candidate.port}"
        gates = [lambda: None if http_get_json(base_url + "/health", io_timeout) == {"status": "ok"} else GateFailure("health", "candidate health failed"),
                 make_props_gate(base_url, self.props_fixture, self.candidate.parallel, self.candidate.ctx_size, io_timeout),
                 lambda: run_overlap_probe(base_url, io_timeout)]
        for gate in gates:
            failure = gate()
            if failure:
                self.logger(f"candidate proof failed: {failure.gate}: {failure.reason}")
                self.report("cleanup-requested")
                return False
            self.report("proving-candidate")
        # Only the owner stops the candidate, restores known-good, and writes ack.
        self.report("cleanup-requested")
        return self.wait_for_ack()


def load_json(path: str, label: str) -> dict:
    try:
        data = json.loads(Path(path).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"{label} is unreadable or invalid JSON: {error}") from error
    if not isinstance(data, dict):
        raise ValueError(f"{label} must be a JSON object")
    return data


def render_plan(candidate: CandidateSpec) -> str:
    optional = []
    if candidate.server_path is not None:
        optional.append(f"server {candidate.server_path} sha256 {candidate.server_sha256}")
    if candidate.checkpoint_min_step is not None:
        optional.append(f"checkpoint_min_step {candidate.checkpoint_min_step}")
    if candidate.cache_ram_bytes is not None:
        optional.append(f"cache_ram_bytes {candidate.cache_ram_bytes}")
    requested = "; " + ", ".join(optional) if optional else "; server/checkpoint/cache continue from known-good wrapper values"
    return ("bee capacity test: read-only plan (no effects)\n"
            "preflight approved snapshot -> arm owner -> stop known-good -> async transient service -> proof -> owner cleanup/restore ack\n"
            f"candidate: GPU index {candidate.gpu_index}, port {candidate.port}, parallel {candidate.parallel}, context {candidate.ctx_size}, "
            f"n_gpu_layers {candidate.n_gpu_layers}, batch_size {candidate.batch_size}, ubatch_size {candidate.ubatch_size}; "
            f"wrapper defaults remain n_gpu_layers 999, batch_size 2048, ubatch_size 512, parallel 1{requested}\n"
            "apply requires --approved-snapshot and --props-fixture; overlap fails closed without correlated /slots evidence")


def run_owner_entrypoint(receipt_path: Path, arguments: argparse.Namespace) -> int:
    store = ReceiptStore.from_receipt_path(receipt_path)
    receipt = store.read(receipt_path)
    approved = ApprovedSnapshot(receipt.snapshot.fragment_hash, receipt.snapshot.drop_in_hashes, receipt.snapshot.exec_start,
                                receipt.snapshot.environment, receipt.candidate_spec)
    inspector = PreflightInspector(default_runner, arguments.systemctl_bin, receipt.unit, approved, make_health_checker(arguments.phase_timeout_seconds),
                                   lambda path: Path(path).read_text(encoding="utf-8"), arguments.phase_timeout_seconds, receipt.snapshot.gpu_index)
    owner = RollbackOwner(receipt_path, default_runner, inspector, lambda message: print(message, file=sys.stderr, flush=True), time.time, time.sleep)
    return 0 if owner.run(arguments.systemctl_bin, arguments.phase_timeout_seconds) else 2


def main(argv: Iterable[str] | None = None) -> int:
    arguments = parse_arguments(argv)
    candidate = CandidateSpec(arguments.start_script, arguments.port, arguments.parallel, arguments.ctx_size, arguments.gpu_index,
                              arguments.n_gpu_layers, arguments.batch_size, arguments.ubatch_size,
                              arguments.server_path, arguments.server_sha256,
                              arguments.checkpoint_min_step, arguments.cache_ram_bytes)
    try:
        candidate.verify_server_identity()
    except ValueError as error:
        print(str(error) + "; no effects were performed", file=sys.stderr)
        return 2
    if arguments.rollback_owner:
        return run_owner_entrypoint(arguments.rollback_owner, arguments)
    if not arguments.apply:
        print(render_plan(candidate))
        return 0
    if not arguments.props_fixture or not arguments.approved_snapshot:
        print("--apply requires --props-fixture and --approved-snapshot; no effects were performed", file=sys.stderr)
        return 2
    try:
        fixture = load_json(arguments.props_fixture, "props fixture")
        approved = ApprovedSnapshot.from_json(load_json(arguments.approved_snapshot, "approved snapshot"))
    except (KeyError, TypeError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 2
    if approved.candidate_spec is None:
        print("approved snapshot is missing candidate_spec; no effects were performed", file=sys.stderr)
        return 2
    if approved.candidate_spec != candidate:
        print("approved snapshot candidate_spec differs from requested effective values; no effects were performed", file=sys.stderr)
        return 2
    runner, clock = default_runner, time.time
    inspector = PreflightInspector(runner, arguments.systemctl_bin, arguments.unit, approved, make_health_checker(arguments.phase_timeout_seconds),
                                   lambda path: Path(path).read_text(encoding="utf-8"), arguments.phase_timeout_seconds, arguments.gpu_index)
    snapshot = inspector.snapshot()
    if isinstance(snapshot, PreflightFailure):
        print(f"preflight refused: {snapshot.reason}", file=sys.stderr)
        return 2
    transaction_id = uuid.uuid4().hex
    store = ReceiptStore(Path(arguments.state_dir))
    heartbeat_grace = arguments.phase_timeout_seconds + arguments.heartbeat_seconds
    candidate_unit = candidate_unit_name(transaction_id)
    receipt = TransactionReceipt(transaction_id, arguments.unit, candidate_unit, snapshot,
                                 clock() + arguments.rollback_deadline_seconds, heartbeat_grace, clock(),
                                 candidate_identity=expected_candidate_identity(candidate_unit), candidate_spec=candidate)
    receipt_path = store.write(receipt)
    owner_argv = [sys.executable, str(Path(__file__).resolve()), "--rollback-owner", str(receipt_path),
                  "--systemctl-bin", arguments.systemctl_bin, "--phase-timeout-seconds", str(arguments.phase_timeout_seconds)]
    if not start_transient_service(runner, arguments.systemd_run_bin, owner_unit_name(transaction_id), owner_argv, arguments.phase_timeout_seconds):
        print("could not arm rollback owner; known-good was not stopped", file=sys.stderr)
        return 2
    if not unit_is_running(runner, arguments.systemctl_bin, owner_unit_name(transaction_id), arguments.phase_timeout_seconds):
        print("rollback owner did not become active; known-good was not stopped", file=sys.stderr)
        return 2
    controller = TransactionController(receipt_path, store, inspector, runner, arguments.systemctl_bin, arguments.systemd_run_bin,
                                       candidate,
                                       fixture, arguments.phase_timeout_seconds, arguments.heartbeat_seconds,
                                       lambda message: print(message, file=sys.stderr), clock, time.sleep)
    return 0 if controller.run() else 1


if __name__ == "__main__":
    raise SystemExit(main())
