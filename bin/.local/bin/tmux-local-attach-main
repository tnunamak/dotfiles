#!/usr/bin/env bash
# Attach local terminals to fresh grouped tmux sessions in the user's "main"
# work group. Restored grouped-session focus is consumed from a short-lived
# queue written by the post-restore hook. Normal launches pick an unused or
# least-viewed window.
#
# Group-aware: tmux groups are named after whichever session was first in the
# group, so after a crash + rename the group can drift to a name like
# "main-10" with no session literally called "main". The script discovers the
# real target group at runtime instead of binding to a literal name.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tmux-grouped-sessions"
LOCK_FILE="${STATE_DIR}/attach-main.lock"
RESTORE_QUEUE_FILE="${STATE_DIR}/main.restore-queue"
RESTORE_STAMP_FILE="${STATE_DIR}/main.restore-stamp"
RESTORE_TTL=45
# Two-strikes orphan-clone reaper: each attach creates a `main-N` grouped clone
# but nothing destroys it when the terminal closes (destroy-unattached is off —
# see the post-mortem note near the attach call). Detached clones therefore leak
# and inflate every tmux-resurrect save (hundreds of clones x N windows). We reap
# a clone only if it has NO client now AND had none on the PREVIOUS attach. That
# two-strikes rule is safe against SDDM/Wayland detach storms: a display-server
# restart detaches every client at one instant, but they reattach together within
# seconds — long before the next user-initiated launch — so a live clone is never
# detached across two separate attach events. DETACHED_SEEN_FILE holds the set
# seen detached last time.
DETACHED_SEEN_FILE="${STATE_DIR}/main.detached-seen"

mkdir -p "$STATE_DIR"

wait_for_tmux_server() {
  for _ in $(seq 1 80); do
    if command tmux -N list-sessions >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.25
  done
  return 1
}

ensure_tmux_server() {
  if command tmux -N list-sessions >/dev/null 2>&1; then
    return 0
  fi

  if command -v systemctl >/dev/null 2>&1 && systemctl --user cat tmux.service >/dev/null 2>&1; then
    systemctl --user start tmux.service || return 1
    wait_for_tmux_server
    return $?
  fi

  # Non-systemd fallback for machines that use this script without tmux.service.
  command tmux start-server 2>/dev/null || return 1
  wait_for_tmux_server
}

# If tmux cannot start, fall back to a plain shell.
if ! ensure_tmux_server; then
  echo "tmux failed to start; falling back to plain shell" >&2
  exit 0
fi

tmux() { command tmux -N "$@"; }

# Wait for systemd boot-restore to complete before we create grouped sessions.
# Without this, we race against tmux-restore.service: we might create `main`
# fresh below before restore.sh populates it, clobbering the restore.
#
# We only wait if the restore unit is actually activating — no wait if it's
# not enabled, already finished, or failed.
if command -v systemctl >/dev/null 2>&1; then
  unit_state="$(systemctl --user is-active tmux-restore.service 2>/dev/null || true)"
  if [[ "$unit_state" == "activating" ]]; then
    for _ in $(seq 1 1200); do
      sleep 0.5
      unit_state="$(systemctl --user is-active tmux-restore.service 2>/dev/null || true)"
      [[ "$unit_state" != "activating" ]] && break
    done
  fi
fi

# Discover the user's work group.
#
# A group named "main" is preferred (canonical). A group whose name starts
# with "main-" (drift from a crash + first-session rename) is also accepted.
# When multiple candidates exist (e.g. an empty `main` plus a populated
# `main-10`), prefer the one with the most windows; tie-break by most
# attached clones; tie-break again by alphabetical name for determinism.
#
# Output: one line "group_name|seed_session|window_count|attached_count" or
# nothing if no usable group exists.
find_target_group() {
  # list-sessions format gives us per-session group info. Sessions outside any
  # group emit an empty session_group field — we ignore those.
  local raw
  raw=$(tmux list-sessions -F '#{session_group}|#{session_name}|#{session_windows}|#{session_attached}' 2>/dev/null || true)
  [[ -n "$raw" ]] || return 1

  declare -A group_seed=()
  declare -A group_windows=()
  declare -A group_attached=()

  while IFS='|' read -r grp sess wins attached; do
    [[ -n "$grp" ]] || continue
    case "$grp" in
      main|main-*) ;;
      *) continue ;;
    esac

    # Window count is per-group (all members share windows), so any session in
    # the group reports the same number. Take the first we see.
    if [[ -z "${group_windows[$grp]+x}" ]]; then
      group_windows["$grp"]="$wins"
      group_seed["$grp"]="$sess"
      group_attached["$grp"]=0
    fi
    group_attached["$grp"]=$(( group_attached["$grp"] + (attached > 0 ? 1 : 0) ))

    # Prefer the literal session named "main" as the seed if one exists in the
    # group — it gives `tmux new-session -t =main` style commands a stable
    # anchor when callers (or the restore hook) reference the group by name.
    if [[ "$sess" == "main" ]]; then
      group_seed["$grp"]="$sess"
    fi
  done <<< "$raw"

  (( ${#group_windows[@]} > 0 )) || return 1

  # Rank candidates: prefer a group literally named "main" first (only when it
  # has windows beyond a freshly-spawned default), then by window count, then
  # by attached count, then alphabetical.
  local best=""
  local best_wins=-1
  local best_att=-1
  for grp in "${!group_windows[@]}"; do
    local wins="${group_windows[$grp]}"
    local att="${group_attached[$grp]}"
    local replace=0
    if [[ -z "$best" ]]; then
      replace=1
    elif (( wins > best_wins )); then
      replace=1
    elif (( wins == best_wins )); then
      if (( att > best_att )); then
        replace=1
      elif (( att == best_att )) && [[ "$grp" < "$best" ]]; then
        replace=1
      fi
    fi
    if (( replace )); then
      best="$grp"; best_wins="$wins"; best_att="$att"
    fi
  done

  printf '%s|%s|%s|%s\n' "$best" "${group_seed[$best]}" "$best_wins" "$best_att"
}

window_exists_in() {
  local seed="$1" idx="$2"
  tmux list-windows -t "=$seed" -F '#{window_index}' 2>/dev/null | grep -Fxq -- "$idx"
}

# Reap leaked grouped-session clones. A clone is reaped only if it has no client
# now AND was recorded detached on the previous attach (two strikes). `attached`
# is taken from list-clients (authoritative per-session client presence), NOT
# #{session_attached}, which reports group-wide attachment for grouped sessions.
# Never reaps a session that currently has a client, nor the seed/group anchor.
reap_orphan_clones() {
  local group="$1" seed="$2"

  # Sessions with a live client right now (authoritative).
  local clients
  clients=$(tmux list-clients -F '#{client_session}' 2>/dev/null | sort -u)

  # Currently-detached clones in this group: name main-N, in the group, no client.
  local detached_now=""
  local sname sgrp
  while IFS='|' read -r sname sgrp; do
    [[ "$sgrp" == "$group" ]] || continue
    case "$sname" in main-[0-9]*) ;; *) continue ;; esac
    [[ "$sname" == "$seed" ]] && continue
    grep -Fxq -- "$sname" <<< "$clients" && continue   # has a client → keep
    detached_now+="${sname}"$'\n'
  done < <(tmux list-sessions -F '#{session_name}|#{session_group}' 2>/dev/null)

  # Reap any clone detached now that was ALSO detached last time (two strikes).
  if [[ -f "$DETACHED_SEEN_FILE" ]]; then
    local s
    while IFS= read -r s; do
      [[ -n "$s" ]] || continue
      if grep -Fxq -- "$s" "$DETACHED_SEEN_FILE" 2>/dev/null; then
        tmux kill-session -t "=$s" 2>/dev/null || true
      fi
    done <<< "$detached_now"
  fi

  # Record the still-detached set (minus any we just reaped) for next time.
  local still
  still=$(tmux list-sessions -F '#{session_name}|#{session_group}' 2>/dev/null \
    | awk -F'|' -v g="$group" '$2==g && $1 ~ /^main-[0-9]+$/ {print $1}')
  : > "$DETACHED_SEEN_FILE"
  local s
  while IFS= read -r s; do
    [[ -n "$s" ]] || continue
    grep -Fxq -- "$s" <<< "$clients" && continue
    [[ "$s" == "$seed" ]] && continue
    printf '%s\n' "$s" >> "$DETACHED_SEEN_FILE"
  done <<< "$still"
}

# Pop a window index from the restore queue (if it's fresh and valid).
pop_restore_window() {
  local seed="$1"
  # Check timestamp — expire after RESTORE_TTL seconds
  if [[ -f "$RESTORE_STAMP_FILE" ]]; then
    local stamp now age
    stamp=$(tr -d '[:space:]' < "$RESTORE_STAMP_FILE" 2>/dev/null || echo 0)
    now=$(date +%s)
    age=$((now - stamp))
    if (( age > RESTORE_TTL )); then
      rm -f "$RESTORE_QUEUE_FILE" "$RESTORE_STAMP_FILE"
      return 1
    fi
  else
    rm -f "$RESTORE_QUEUE_FILE"
    return 1
  fi

  # Pop the first valid window index
  while [[ -s "$RESTORE_QUEUE_FILE" ]]; do
    local window
    IFS= read -r window < "$RESTORE_QUEUE_FILE" || break

    # Remove the consumed line
    local tmp="${RESTORE_QUEUE_FILE}.tmp.$$"
    sed '1d' "$RESTORE_QUEUE_FILE" > "$tmp" 2>/dev/null || : > "$tmp"
    mv "$tmp" "$RESTORE_QUEUE_FILE"

    # Clean up empty files
    if [[ ! -s "$RESTORE_QUEUE_FILE" ]]; then
      rm -f "$RESTORE_QUEUE_FILE" "$RESTORE_STAMP_FILE"
    fi

    if [[ "$window" =~ ^[0-9]+$ ]] && window_exists_in "$seed" "$window"; then
      printf '%s\n' "$window"
      return 0
    fi
  done

  rm -f "$RESTORE_QUEUE_FILE" "$RESTORE_STAMP_FILE"
  return 1
}

# Pick a window not currently viewed by any attached session in the target
# group, or the least-viewed. Filter is built from $group, not hardcoded.
choose_normal_window() {
  local group="$1" seed="$2"
  local -a windows=()
  local -A counts=()

  mapfile -t windows < <(tmux list-windows -t "=$seed" -F '#{window_index}' 2>/dev/null)
  (( ${#windows[@]} > 0 )) || return 1

  for idx in "${windows[@]}"; do
    counts["$idx"]=0
  done

  # Count how many attached sessions in the target group are viewing each window
  while IFS= read -r idx; do
    [[ -n "${counts[$idx]+x}" ]] || continue
    counts["$idx"]=$(( counts["$idx"] + 1 ))
  done < <(
    tmux list-sessions -F '#{window_index}' \
      -f "#{&&:#{==:#{session_group},${group}},#{!=:#{session_attached},0}}" \
      2>/dev/null || true
  )

  # Prefer an unviewed window
  for idx in "${windows[@]}"; do
    if (( counts["$idx"] == 0 )); then
      printf '%s\n' "$idx"
      return 0
    fi
  done

  # All windows are viewed — create a new one
  tmux new-window -d -t "=$seed" -c "$HOME" -P -F '#{window_index}' 2>/dev/null
  return $?
}

# Under lock: discover/create the target group, choose a window, create a
# fresh grouped session clone for this client.
target="$(
  (
    flock 9

    # Wrap tmux so child processes don't inherit the lock fd
    tmux() { command tmux -N "$@" 9>&-; }

    # Find or create the target group.
    group_info="$(find_target_group || true)"
    group=""; seed=""
    if [[ -n "$group_info" ]]; then
      IFS='|' read -r group seed _ _ <<< "$group_info"
    fi

    if [[ -z "$group" ]]; then
      # No usable group exists — bootstrap a fresh "main" group.
      tmux new-session -d -s main 2>/dev/null || true
      group="main"
      seed="main"
    fi

    # Clean up empty stray "main" group when a populated drifted group is the
    # real winner. Only kill if it has exactly 1 window AND no attached
    # clients AND it's NOT the chosen group.
    if [[ "$group" != "main" ]]; then
      stray_info=$(tmux list-sessions -F '#{session_group}|#{session_name}|#{session_windows}|#{session_attached}' 2>/dev/null \
        | awk -F'|' -v g="main" '$1==g {print}')
      if [[ -n "$stray_info" ]]; then
        # Drop the stray only if every member is unattached and group has 1 window
        stray_total_attached=0
        stray_windows=""
        stray_members=()
        while IFS='|' read -r _ s_name s_wins s_att; do
          stray_windows="$s_wins"
          stray_members+=("$s_name")
          stray_total_attached=$(( stray_total_attached + (s_att > 0 ? 1 : 0) ))
        done <<< "$stray_info"
        if [[ "$stray_windows" == "1" ]] && (( stray_total_attached == 0 )); then
          for m in "${stray_members[@]}"; do
            tmux kill-session -t "=$m" 2>/dev/null || true
          done
        fi
      fi
    fi

    # Reap leaked detached clones from prior terminals (two-strikes safe).
    # Runs under the same lock as clone creation, so no race with a concurrent
    # launch. Skipped while a restore is in flight (the queue is non-empty),
    # since restore transiently creates clones the post-restore hook will use.
    if [[ -n "$group" && ! -s "$RESTORE_QUEUE_FILE" ]]; then
      reap_orphan_clones "$group" "$seed" || true
    fi

    # Pick a window: restore queue first, then smart selection
    target_window="$(pop_restore_window "$seed" || true)"
    if [[ -z "$target_window" ]]; then
      target_window="$(choose_normal_window "$group" "$seed" || true)"
    fi

    # Find the lowest available session name (main-0, main-1, ...) — note we
    # always name new clones with the "main-N" prefix regardless of the group's
    # internal name, so user-visible session names stay consistent.
    new_name=""
    for i in $(seq 0 999); do
      candidate="main-$i"
      # Skip if the seed itself happens to be main-N, or any existing session
      if [[ "$candidate" == "$seed" ]]; then continue; fi
      if ! tmux has-session -t "=$candidate" 2>/dev/null; then
        new_name="$candidate"
        break
      fi
    done
    tmux new-session -d -s "$new_name" -t "=$seed"

    # Set the target window before anyone attaches
    if [[ -n "$target_window" ]]; then
      tmux select-window -t "=${new_name}:${target_window}" >/dev/null 2>&1 || true
    fi

    printf '%s\n' "$new_name"
  ) 9>"$LOCK_FILE"
)" || true

if [[ -n "$target" ]]; then
  # Do NOT set destroy-unattached: SDDM/Wayland restarts detach clients, and
  # destroy-unattached would then kill the session. Sessions must survive
  # display-server hiccups. See 2026-04-22 post-mortem in git log.
  exec tmux attach-session -t "=$target"
fi

# Last-resort fallback
exec tmux new-session -A -s main
