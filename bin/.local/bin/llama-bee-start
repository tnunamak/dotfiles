#!/usr/bin/env bash
# Start the selected local llama.cpp-compatible engine with verified defaults.
#
# --print-command and --dry-run are intentionally side-effect-free: they render
# a shell-quoted argv without requiring the Bee checkout, GPU budget, model, or
# chat-template files to exist. They make the service's effective invocation
# inspectable and testable without starting a model server.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: llama-bee-start [--print-command|--dry-run] [llama-server arguments...]

Starts the selected local engine with the local operator defaults. The
production default is the pinned official llama.cpp build; LLAMA_BEE_ENGINE=bee
selects the retained Bee build for an operator-controlled rollback. Environment
variables named LLAMA_BEE_* remain the compatibility configuration API.
--print-command and --dry-run print the exact shell-quoted command and exit.
EOF
}

print_command=false
case "${1:-}" in
  --print-command|--dry-run)
    print_command=true
    shift
    ;;
  --help|-h)
    usage
    exit 0
    ;;
esac

parallel="${LLAMA_BEE_PARALLEL:-1}"
if ! [[ "$parallel" =~ ^[0-9]+$ ]] || [[ "$parallel" -lt 1 ]]; then
  echo "ERROR: LLAMA_BEE_PARALLEL must be a positive integer, got '$parallel'" >&2
  exit 1
fi

applications_dir="${LLAMA_BEE_APPLICATIONS_DIR:-$HOME/applications}"
bee_dir="${LLAMA_BEE_DIR:-$applications_dir/beellama}"
gpu_budget_file="${LLAMA_BEE_GPU_BUDGET_FILE:-$applications_dir/config/gpu_budget.sh}"

# The service and LLAMA_BEE_* prefix are compatibility identifiers. Engine
# selection is explicit and operator-owned; model/profile requests never alter
# it. Both binaries are identity-pinned so a rebuild cannot silently replace a
# validated engine.
engine="${LLAMA_BEE_ENGINE:-official}"
case "$engine" in
  official)
    default_server="$applications_dir/llamacpp-official-505b1ed1-fa-all-quants-rpath/bin/llama-server"
    default_server_sha256="e35790440096f4040353a1dad1efeef4663caf3ed3644017a631dcbd23bad914"
    ;;
  bee)
    default_server="$bee_dir/build/bin/llama-server"
    default_server_sha256="cce4b47d624ebe9580c59fb46dc727a708540048bbfa92284fb2d195359ea357"
    ;;
  *)
    echo "ERROR: LLAMA_BEE_ENGINE must be 'official' or 'bee', got '$engine'" >&2
    exit 1
    ;;
esac
llama_server="${LLAMA_BEE_SERVER:-$default_server}"
llama_server_sha256="${LLAMA_BEE_SERVER_SHA256:-$default_server_sha256}"

model="${LLAMA_BEE_MODEL:-/media/windows/AI Models/LLMs/GGUF/Qwen3.6-27B-UD-Q4_K_XL-mtp.gguf}"
port="${LLAMA_BEE_PORT:-5051}"
ctx_size="${LLAMA_BEE_CTX:-102400}"
ctx_checkpoints="${LLAMA_BEE_CTX_CHECKPOINTS:-16}"
checkpoint_min_step="${LLAMA_BEE_CHECKPOINT_MIN_STEP:-256}"
cache_ram="${LLAMA_BEE_CACHE_RAM:-4096}"
cache_type_k="${LLAMA_BEE_CTK:-q5_0}"
cache_type_v="${LLAMA_BEE_CTV:-q4_1}"
draft_cache_type_k="${LLAMA_BEE_DRAFT_CTK:-q8_0}"
draft_cache_type_v="${LLAMA_BEE_DRAFT_CTV:-q8_0}"
n_gpu_layers=999
batch_size=2048
ubatch_size=512

# These values are a candidate-service capability, not ordinary wrapper
# configuration.  A candidate may supply all of them through bee-capacity-
# test's env -i boundary; partial, invalid, or ambient state is refused.
candidate_override_names=(
  LLAMA_BEE_CANDIDATE_N_GPU_LAYERS
  LLAMA_BEE_CANDIDATE_BATCH_SIZE
  LLAMA_BEE_CANDIDATE_UBATCH_SIZE
)
candidate_optional_override_names=(
  LLAMA_BEE_CANDIDATE_SERVER_PATH
  LLAMA_BEE_CANDIDATE_SERVER_SHA256
  LLAMA_BEE_CANDIDATE_CHECKPOINT_MIN_STEP
  LLAMA_BEE_CANDIDATE_CACHE_RAM_MIB
)
candidate_override_seen=false
if [[ ${LLAMA_BEE_CANDIDATE_OVERRIDES+x} ]]; then
  candidate_override_seen=true
fi
for name in "${candidate_override_names[@]}"; do
  if [[ ${!name+x} ]]; then
    candidate_override_seen=true
  fi
done
for name in "${candidate_optional_override_names[@]}"; do
  if [[ ${!name+x} ]]; then
    candidate_override_seen=true
  fi
done

if "$candidate_override_seen"; then
  if [[ "${LLAMA_BEE_CANDIDATE_OVERRIDES:-}" != 1 ]]; then
    echo "ERROR: candidate overrides require LLAMA_BEE_CANDIDATE_OVERRIDES=1" >&2
    exit 1
  fi
  for name in "${candidate_override_names[@]}"; do
    if [[ ! ${!name+x} ]]; then
      echo "ERROR: candidate overrides require all three bounded values" >&2
      exit 1
    fi
  done
  n_gpu_layers="$LLAMA_BEE_CANDIDATE_N_GPU_LAYERS"
  batch_size="$LLAMA_BEE_CANDIDATE_BATCH_SIZE"
  ubatch_size="$LLAMA_BEE_CANDIDATE_UBATCH_SIZE"
  for name in n_gpu_layers batch_size ubatch_size; do
    value="${!name}"
    if ! [[ "$value" =~ ^[0-9]+$ ]] || [[ ${#value} -gt 4 ]]; then
      echo "ERROR: candidate $name must be a bounded integer, got '$value'" >&2
      exit 1
    fi
  done
  if (( 10#$n_gpu_layers > 999 || 10#$batch_size < 1 || 10#$batch_size > 2048 || 10#$ubatch_size < 1 || 10#$ubatch_size > 10#$batch_size )); then
    echo "ERROR: candidate values require n_gpu_layers in 0..999 and 1 <= ubatch_size <= batch_size <= 2048" >&2
    exit 1
  fi
  server_path_seen=false
  for name in LLAMA_BEE_CANDIDATE_SERVER_PATH LLAMA_BEE_CANDIDATE_SERVER_SHA256; do
    if [[ ${!name+x} ]]; then
      server_path_seen=true
    fi
  done
  if "$server_path_seen"; then
    if [[ ! ${LLAMA_BEE_CANDIDATE_SERVER_PATH+x} || ! ${LLAMA_BEE_CANDIDATE_SERVER_SHA256+x} ]]; then
      echo "ERROR: candidate server selection requires path and SHA-256" >&2
      exit 1
    fi
    candidate_server_path="$LLAMA_BEE_CANDIDATE_SERVER_PATH"
    candidate_server_sha256="$LLAMA_BEE_CANDIDATE_SERVER_SHA256"
    if ! canonical_applications_path="$(/usr/bin/realpath -e -- "$HOME/applications")" || ! canonical_server_path="$(/usr/bin/realpath -e -- "$candidate_server_path")"; then
      echo "ERROR: candidate server path cannot be canonicalized" >&2
      exit 1
    fi
    # The approved typed path is itself the identity.  Reject every lexical
    # rewrite, including ../ and ancestor links, before hashing or execing.
    if [[ "$candidate_server_path" != "$canonical_server_path" || "$canonical_server_path" != "$canonical_applications_path"/* || "${canonical_server_path##*/}" != llama-server || -L "$candidate_server_path" || ! -f "$canonical_server_path" || ! -x "$canonical_server_path" || ! "$candidate_server_sha256" =~ ^[0-9a-f]{64}$ ]]; then
      echo "ERROR: candidate server must be an executable ~/applications/.../llama-server with lowercase SHA-256" >&2
      exit 1
    fi
    actual_server_sha256="$(/usr/bin/sha256sum -- "$canonical_server_path")"
    actual_server_sha256="${actual_server_sha256%% *}"
    if [[ "$actual_server_sha256" != "$candidate_server_sha256" ]]; then
      echo "ERROR: candidate server SHA-256 does not match" >&2
      exit 1
    fi
    llama_server="$canonical_server_path"
    llama_server_sha256="$candidate_server_sha256"
  fi
  if [[ ${LLAMA_BEE_CANDIDATE_CHECKPOINT_MIN_STEP+x} ]]; then
    checkpoint_min_step="$LLAMA_BEE_CANDIDATE_CHECKPOINT_MIN_STEP"
    if ! [[ "$checkpoint_min_step" =~ ^[0-9]+$ && "$ctx_size" =~ ^[0-9]+$ ]] || [[ ${#checkpoint_min_step} -gt 6 || ${#ctx_size} -gt 6 ]] || (( 10#$checkpoint_min_step > 10#$ctx_size )); then
      echo "ERROR: candidate checkpoint_min_step must be in 0..ctx_size" >&2
      exit 1
    fi
  fi
  if [[ ${LLAMA_BEE_CANDIDATE_CACHE_RAM_MIB+x} ]]; then
    cache_ram="$LLAMA_BEE_CANDIDATE_CACHE_RAM_MIB"
    if ! [[ "$cache_ram" =~ ^[0-9]+$ ]] || (( 10#$cache_ram > 32768 )); then
      echo "ERROR: candidate cache_ram must be in 0..32768 MiB" >&2
      exit 1
    fi
  fi
fi

if [[ ! "$llama_server_sha256" =~ ^[0-9a-f]{64}$ ]]; then
  echo "ERROR: LLAMA_BEE_SERVER_SHA256 must be a lowercase SHA-256 digest" >&2
  exit 1
fi

# Keep the known-good Qwen 3.6 template local instead of relying on an HF cache.
default_chat_template="/media/windows/AI Models/LLMs/Chat Templates/Qwen-Fixed-Chat-Templates/23a40b0bd4d197c31d39e3c442fd2cd6100b3971/chat_template.jinja"
chat_template="$default_chat_template"
if [[ ${LLAMA_BEE_CHAT_TEMPLATE+x} ]]; then
  chat_template="$LLAMA_BEE_CHAT_TEMPLATE"
fi

chat_template_kwargs='{"preserve_thinking":true}'
if [[ ${LLAMA_BEE_CHAT_TEMPLATE_KWARGS+x} ]]; then
  chat_template_kwargs="$LLAMA_BEE_CHAT_TEMPLATE_KWARGS"
fi

server_args=(
  --model "$model"
  --port "$port"
  --host 127.0.0.1
  --slots
  --n-gpu-layers "$n_gpu_layers"
  -np "$parallel"
  --ctx-size "$ctx_size"
  --ctx-checkpoints "$ctx_checkpoints"
  --checkpoint-min-step "$checkpoint_min_step"
  --cache-ram "$cache_ram"
  --cache-type-k "$cache_type_k"
  --cache-type-v "$cache_type_v"
  --cache-type-k-draft "$draft_cache_type_k"
  --cache-type-v-draft "$draft_cache_type_v"
  -b "$batch_size"
  -ub "$ubatch_size"
  --flash-attn on
  --no-host
  --jinja
  --reasoning on
  --reasoning-budget -1
  --reasoning-format deepseek
)

if [[ -n "$chat_template" && "$chat_template" != embedded ]]; then
  server_args+=(--chat-template-file "$chat_template")
fi
if [[ -n "$chat_template_kwargs" ]]; then
  server_args+=(--chat-template-kwargs "$chat_template_kwargs")
fi

server_args+=(
  --kv-unified
  --metrics
  --no-mmap
  --mlock
  --temp 0.6
  --top-k 20
  --top-p 1.0
  --min-p 0.0
  --repeat-penalty 1.0
  --spec-draft-p-min 0.75
)

if [[ "${LLAMA_BEE_MTP:-1}" == 1 ]]; then
  # Upstream llama.cpp renamed the MTP speculative type to "draft-mtp"; the Bee
  # fork used "mtp". Default to the upstream spelling; override for a Bee rollback.
  server_args+=(--spec-type "${LLAMA_BEE_SPEC_TYPE:-draft-mtp}" --spec-draft-n-max "${LLAMA_BEE_MTP_MAX:-3}")
fi
if [[ -n "${LLAMA_BEE_MMPROJ:-}" ]]; then
  server_args+=(--mmproj "$LLAMA_BEE_MMPROJ")
  if [[ "${LLAMA_BEE_NO_MMPROJ_OFFLOAD:-0}" == 1 ]]; then
    server_args+=(--no-mmproj-offload)
  fi
  if [[ -n "${LLAMA_BEE_IMAGE_MIN_TOKENS:-}" ]]; then
    server_args+=(--image-min-tokens "$LLAMA_BEE_IMAGE_MIN_TOKENS")
  fi
fi
if [[ -n "${LLAMA_BEE_TENSOR_SPLIT:-}" ]]; then
  server_args+=(--tensor-split "$LLAMA_BEE_TENSOR_SPLIT")
fi
server_args+=("$@")

if "$print_command"; then
  printf 'exec'
  printf ' %q' "$llama_server" "${server_args[@]}"
  printf '\n'
  exit 0
fi

if [[ ! -r "$gpu_budget_file" ]]; then
  echo "ERROR: local LLM GPU budget file not found: $gpu_budget_file" >&2
  exit 1
fi
# shellcheck source=/dev/null
source "$gpu_budget_file"
if [[ "${GPU1_LLM:-0}" -lt 1 ]]; then
  echo "ERROR: local LLM requires GPU1_LLM>=1, got ${GPU1_LLM:-unset}" >&2
  exit 1
fi
if [[ ! -x "$llama_server" ]]; then
  echo "ERROR: selected $engine server not executable: $llama_server" >&2
  exit 1
fi
actual_server_sha256="$(/usr/bin/sha256sum -- "$llama_server")"
actual_server_sha256="${actual_server_sha256%% *}"
if [[ "$actual_server_sha256" != "$llama_server_sha256" ]]; then
  echo "ERROR: selected $engine server SHA-256 does not match" >&2
  exit 1
fi
if [[ -n "$chat_template" && "$chat_template" != embedded && ! -f "$chat_template" ]]; then
  echo "ERROR: LLAMA_BEE_CHAT_TEMPLATE not found: $chat_template" >&2
  exit 1
fi

# The server replaces this wrapper, so systemd tracks the actual llama-server
# process. Bash process substitutions retain the existing line-buffered filters:
# they suppress only noisy info-level srv/slot messages; warnings and errors pass.
filter_pattern=' I (srv|slot) '
export CUDA_VISIBLE_DEVICES="${LLAMA_BEE_VISIBLE_DEVICES:-1}"
exec "$llama_server" "${server_args[@]}" \
  > >(grep --line-buffered -vE "$filter_pattern") \
  2> >(grep --line-buffered -vE "$filter_pattern" >&2)
