#!/usr/bin/env bash
# Recreate only an absent kitty fleet; native sessions preserve kitty layout
# while the manifest remains authoritative for KWin placement and tmux identity.
set -euo pipefail
LOG_TAG="desktop-layout-restore"
GRAPHICAL_WAIT_SECONDS="${DESKTOP_LAYOUT_WAIT_SECONDS:-120}"
log() { printf '%s: %s\n' "$LOG_TAG" "$*" >&2; }
env_presence() {
  printf 'WAYLAND_DISPLAY=%s DISPLAY=%s DBUS_SESSION_BUS_ADDRESS=%s XDG_RUNTIME_DIR=%s' \
    "${WAYLAND_DISPLAY:+set}" "${DISPLAY:+set}" "${DBUS_SESSION_BUS_ADDRESS:+set}" "${XDG_RUNTIME_DIR:+set}"
}
on_error() {
  local rc=$?
  log "ERROR rc=$rc command=$BASH_COMMAND env: $(env_presence)"
  exit "$rc"
}
trap on_error ERR

# The user manager may receive the Plasma display environment after this unit
# is ordered. Import only the variables this process needs; do not `eval` its
# arbitrary environment dump.
import_graphical_environment() {
  local entry name value
  while IFS= read -r entry; do
    name="${entry%%=*}"; value="${entry#*=}"
    case "$name" in
      WAYLAND_DISPLAY|DISPLAY|DBUS_SESSION_BUS_ADDRESS|XDG_RUNTIME_DIR)
        [[ "$entry" == *=* ]] && export "$name=$value"
        ;;
    esac
  done < <(systemctl --user show-environment 2>/dev/null || true)
}

wait_for_graphical_session() {
  local elapsed=0
  while (( elapsed < GRAPHICAL_WAIT_SECONDS )); do
    import_graphical_environment
    if [[ -n "${WAYLAND_DISPLAY:-}" || -n "${DISPLAY:-}" ]] &&
       kdotool getactivewindow >/dev/null 2>&1; then
      log "graphical session ready after ${elapsed}s; $(env_presence)"
      return 0
    fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  log "ERROR graphical session not ready after ${GRAPHICAL_WAIT_SECONDS}s; $(env_presence)"
  return 1
}

state="${XDG_STATE_HOME:-$HOME/.local/state}/desktop-layout"; manifest="${DESKTOP_LAYOUT_MANIFEST:-$state/manifest.json}"; dry=0; force=0
created_set="${DESKTOP_LAYOUT_CREATED_SET:-}"; test_socket_dir="${DESKTOP_LAYOUT_TEST_SOCKET_DIR:-}"; spawn_number=0
kitty_config="${DESKTOP_LAYOUT_KITTY_CONFIG:-}"
while (($#)); do case "$1" in --dry-run) dry=1;;--force) force=1;;--manifest) manifest="$2";shift;;*) echo 'usage: desktop-layout-restore [--dry-run] [--force] [--manifest FILE]' >&2;exit 2;;esac;shift;done
[[ -s "$manifest" ]] || exit 0; command -v jq >/dev/null && command -v kdotool >/dev/null || exit 1
if (( ! dry )); then
  archive_dir="$state/restore-archive"; mkdir -p "$archive_dir"
  cp -f "$manifest" "$archive_dir/manifest-$(date -u +%Y%m%dT%H%M%SZ).json" 2>/dev/null || true
  find "$archive_dir" -name 'manifest-*.json' -printf '%T@ %p\n' 2>/dev/null | sort -rn | tail -n +31 | cut -d' ' -f2- | xargs -r rm -f
fi
wait_for_graphical_session
mapfile -t existing < <(kdotool search --class kitty 2>/dev/null || true); if (( !force && ${#existing[@]}>2 )); then echo "desktop-layout-restore: ${#existing[@]} kitty windows already exist; skipping";exit 0;fi
screen(){ [[ -n "${DESKTOP_LAYOUT_SCREEN:-}" ]] && { printf '%s\n' "$DESKTOP_LAYOUT_SCREEN"; return; }; kscreen-doctor -o 2>/dev/null|awk '/^Output:/{e=0}/enabled/{e=1}e&&/Geometry:/{for(i=1;i<=NF;i++)if($i~/^[0-9]+x[0-9]+$/){split($i,a,"x");if(a[1]>w)w=a[1];if(a[2]>h)h=a[2]}}END{print w,h}'; }
read -r cw ch < <(screen); sw="$(jq -r '.screen.width // 0' "$manifest")";sh="$(jq -r '.screen.height // 0' "$manifest")"; ((sw>0))||sw=$cw;((sh>0))||sh=$ch
if ((dry));then jq -r --argjson cw "$cw" --argjson ch "$ch" --argjson sw "$sw" --argjson sh "$sh" '.windows[]|"launch "+(if .is_tmux then "tmux window "+(.tmux_window_index|tostring) else "plain kitty" end)+" desktop "+(.virtual_desktop|tostring)+" at "+((.position.x*$cw/$sw|round)|tostring)+","+((.position.y*$ch/$sh|round)|tostring)' "$manifest";exit 0;fi
for _ in $(seq 1 240);do [[ "$(systemctl --user is-active tmux-restore.service 2>/dev/null||true)" != activating ]]&&break;sleep .5;done
outcome_log="$state/restore-archive/outcomes-$(date -u +%Y%m%dT%H%M%SZ).log"
if (( ! dry )); then mkdir -p "$state/restore-archive"; : > "$outcome_log"; fi
declare -A spawned_pids=()
while IFS= read -r row;do
  cwd="$(jq -r '.cwd // env.HOME' <<< "$row")";[[ -d "$cwd" ]]||cwd="$HOME";tmux_row="$(jq -r .is_tmux <<< "$row")";idx="$(jq -r '.tmux_window_index // empty' <<< "$row")";desk="$(jq -r .virtual_desktop <<< "$row")";native_session="$(jq -r '.native_session // empty' <<< "$row")"
  mapfile -t before < <(kdotool search --class kitty 2>/dev/null||true)
  # Keep the existing one-process-per-OS-window model even if a system config
  # enables kitty's single-instance mode; each manifest row needs its own socket.
  spawn_number=$((spawn_number+1)); args=(--single-instance=no --directory "$cwd")
  [[ -n "$kitty_config" ]] && args+=(--config "$kitty_config" --override allow_remote_control=socket-only)
  socket=""
  if [[ -n "$test_socket_dir" ]]; then
    mkdir -p "$test_socket_dir"; socket="$test_socket_dir/kitty-$spawn_number-$RANDOM"
    args+=(--title "desktop-layout-test-$spawn_number-$RANDOM" --listen-on "unix:$socket")
  fi
  if [[ -n "$native_session" && -s "$native_session" ]]; then
    kitty "${args[@]}" --session "$native_session" >/dev/null 2>&1 &
  elif [[ "$tmux_row" == true ]]; then
    kitty "${args[@]}" env TMUX_ATTACH_TARGET_WINDOW="$idx" tmux-local-attach-main >/dev/null 2>&1 &
  else
    kitty "${args[@]}" >/dev/null 2>&1 &
  fi
  pid=$!;new=""
  declare -A before_set=(); for w in "${before[@]}"; do before_set["$w"]=1; done
  # Bash associative-array lookup, not `printf ... | grep -Fxq`: grep exits on
  # first match and closes its stdin pipe while printf may still be writing,
  # which SIGPIPEs printf under `set -euo pipefail` and aborts the script
  # (same bug class fixed 2026-04-25 in systemd-restore.sh's sort|awk pipe).
  for _ in $(seq 1 100);do mapfile -t after < <(kdotool search --class kitty 2>/dev/null||true);for candidate in "${after[@]}";do [[ -n "${before_set[$candidate]:-}" ]]&&continue;[[ "$(kdotool getwindowpid "$candidate" 2>/dev/null||true)" == "$pid" ]]&&{ new="$candidate";break 2;};done;sleep .1;done
  [[ -n "$new" ]]||{ echo "desktop-layout-restore: unable to identify kitty pid $pid" >&2; (( dry )) || printf 'spawn=%d pid=%s cwd=%s tmux=%s tmux_idx=%s outcome=identify_failed\n' "$spawn_number" "$pid" "$cwd" "$tmux_row" "${idx:-}" >> "$outcome_log"; continue; }
  (( dry )) || { printf 'spawn=%d pid=%s window=%s cwd=%s tmux=%s tmux_idx=%s outcome=identified\n' "$spawn_number" "$pid" "$new" "$cwd" "$tmux_row" "${idx:-}" >> "$outcome_log"; spawned_pids["$pid"]="$spawn_number|$new|$cwd|$tmux_row|${idx:-}"; }
  # Test callers receive only IDs proven absent from the pre-spawn snapshot.
  # Record every inner kitty ID immediately. This script never closes windows;
  # cleanup is deliberately external and must use this socket plus exact IDs.
  if [[ -n "$created_set" ]]; then
    inner_ids=""
    for _ in $(seq 1 50); do
      inner_ids="$(kitten @ --to "unix:$socket" ls 2>/dev/null | jq -er 'if length == 1 then [.[0].tabs[]?.windows[]?.id] else empty end | if length > 0 then join(",") else empty end')" && break
      inner_ids=""; sleep .1
    done
    [[ -n "$inner_ids" ]] || {
      log "ERROR created kitty $new but could not prove its inner-window set; leaving it open"
      exit 1
    }
    printf '%s|%s|%s\n' "$new" "$socket" "$inner_ids" >> "$created_set"
  fi
  read -r x y w h < <(jq -r --argjson cw "$cw" --argjson ch "$ch" --argjson sw "$sw" --argjson sh "$sh" '[.position.x*$cw/$sw,.position.y*$ch/$sh,.size.width*$cw/$sw,.size.height*$ch/$sh]|map(round)|join(" ")' <<< "$row")
  kdotool set_desktop_for_window "$new" "$desk";kdotool windowsize "$new" "$w" "$h";kdotool windowmove "$new" "$x" "$y"
done < <(jq -c '.windows[]' "$manifest")

# Liveness sweep, a few seconds after every spawn finished: catches windows
# that were successfully identified above but then closed themselves
# shortly after (e.g. tmux-local-attach-main exiting because its target
# window index no longer exists) — the exact gap that made the 2026-07-28
# incident undiagnosable, since "identified" alone doesn't mean "survived".
if (( ! dry )) && (( ${#spawned_pids[@]} > 0 )); then
  sleep 5
  for pid in "${!spawned_pids[@]}"; do
    IFS='|' read -r sweep_spawn_number sweep_new sweep_cwd sweep_tmux_row sweep_idx <<< "${spawned_pids[$pid]}"
    if kill -0 "$pid" 2>/dev/null; then
      printf 'spawn=%s pid=%s window=%s cwd=%s tmux=%s tmux_idx=%s outcome=alive_after_5s\n' \
        "$sweep_spawn_number" "$pid" "$sweep_new" "$sweep_cwd" "$sweep_tmux_row" "$sweep_idx" >> "$outcome_log"
    else
      printf 'spawn=%s pid=%s window=%s cwd=%s tmux=%s tmux_idx=%s outcome=DIED_within_5s\n' \
        "$sweep_spawn_number" "$pid" "$sweep_new" "$sweep_cwd" "$sweep_tmux_row" "$sweep_idx" >> "$outcome_log"
    fi
  done
  died=$(grep -c 'outcome=DIED_within_5s' "$outcome_log" || true)
  # `(( died > 0 ))` alone, as the script's LAST command, makes the whole
  # script exit 1 whenever nothing died (the common, correct case) — a
  # false arithmetic test's exit status becomes the script's own exit
  # status with nothing after it. `|| true` makes the common case exit 0
  # regardless of whether the warning branch fires.
  if (( died > 0 )); then
    log "WARNING: $died of ${#spawned_pids[@]} spawned windows died within 5s — see $outcome_log"
  fi
fi
exit 0
