#!/usr/bin/env bash
# research-capture-detect — after-tool hook: detect web-research tool calls and
# write a pending-flag so the pre-compaction nudge knows to remind the agent to
# capture findings to ai/research/ before the context is compressed.
#
# CROSS-AGENT: wired as Claude PostToolUse / Gemini AfterTool / Codex PostToolUse.
# The three deliver after-tool JSON on stdin with slightly different field names,
# so we extract tool-name + session-id DEFENSIVELY (try each agent's keys). No
# per-agent arg or shim file needed — one script, resilient to schema drift.
# See ai/research/agentic-context-design/cross-agent-hooks-no-standard-*.md.
#
# NEVER writes to the corpus or anywhere else — only touches the state dir.
# Fail-silent: this hook must NEVER break the session.
#
# Env override for testing:
#   RESEARCH_CAPTURE_STATE_DIR — default: ~/.local/state/research-capture

# Fail-silent wrapper: any unhandled exit goes to 0.
trap 'exit 0' ERR

STATE_DIR="${RESEARCH_CAPTURE_STATE_DIR:-$HOME/.local/state/research-capture}"

# 1. Kill switch.
[ -f "$STATE_DIR/OFF" ] && exit 0

# Require jq.
command -v jq >/dev/null 2>&1 || exit 0

# Read stdin; bail if empty.
input="$(cat)"
[ -n "$input" ] || exit 0

# 2. Parse tool_name DEFENSIVELY across agents and bail if not a research tool.
#    Claude: .tool_name | Gemini: .tool_name / .toolName / .function_name / .name |
#    Codex:  .tool_name. Lowercased for matching so name-casing differences don't matter.
tool_name="$(printf '%s' "$input" | jq -r '.tool_name // .toolName // .function_name // .name // .tool.name // empty' 2>/dev/null)"
[ -n "$tool_name" ] || exit 0
tn_lc="$(printf '%s' "$tool_name" | tr '[:upper:]' '[:lower:]')"

is_research=0

# EXCLUDE-FIRST (structural, catches whole namespaces so future tools can't leak):
#   - browser/UI automation: playwright browser_* is NOT research (it clicks/screenshots).
#     The old bare *browse* glob matched every browser_* call → 22% false positives.
#   - metadata/status calls: *_instance_info / *_info / *_stats / *_doctor / *_ping are
#     not research even on a research server (e.g. searxng_instance_info).
case "$tn_lc" in
    *browser_*|*playwright*|*_instance_info|*_info|*_stats|*_doctor|*_ping)
        exit 0
        ;;
esac

# POSITIVE allowlist — specific action+context pairs, not loose single words. Each
# requires the ACTION and its CONTEXT together, so a lone "search"/"browse"/"url"
# can't trip it:
#   Claude:  WebFetch, WebSearch        Gemini: web_fetch, google_web_search
#   Codex:   web_search                 MCP/searxng: searxng_web_search, web_url_read
#   context-mode: ctx_fetch_and_index
case "$tn_lc" in
    *websearch*|*web_search*|*google_web_search*|\
    *webfetch*|*web_fetch*|\
    *searxng_web_search*|*web_url_read*|\
    *ctx_fetch*|*fetch_and_index*)
        is_research=1
        ;;
esac

[ "$is_research" -eq 1 ] || exit 0

# 3. Write/refresh the pending flag. Session id extracted defensively across agents.
session_id="$(printf '%s' "$input" | jq -r '.session_id // .sessionId // .session.id // empty' 2>/dev/null)"
if [ -n "$session_id" ]; then
    flag_file="$STATE_DIR/research-pending-${session_id}"
else
    flag_file="$STATE_DIR/research-pending-unknown"
fi

mkdir -p "$STATE_DIR" 2>/dev/null || exit 0
chmod 0700 "$STATE_DIR" 2>/dev/null || true

# Is this the FIRST research call of the session? (flag didn't exist yet.) The
# mid-session nudge fires ONCE per session on first research — not per call —
# so the agent isn't spammed on every WebFetch.
first_research=0
[ -f "$flag_file" ] || first_research=1

ts="$(date -Iseconds 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%S+00:00)"

# Append a line; cap at 20 lines to keep the file tiny.
printf '%s %s\n' "$ts" "$tool_name" >> "$flag_file" 2>/dev/null || exit 0

# Trim to last 20 lines in-place (portable: write to temp, move back).
if [ -f "$flag_file" ]; then
    line_count="$(wc -l < "$flag_file" 2>/dev/null || echo 0)"
    if [ "$line_count" -gt 20 ]; then
        tmp_file="${flag_file}.tmp.$$"
        tail -20 "$flag_file" > "$tmp_file" 2>/dev/null && mv "$tmp_file" "$flag_file" 2>/dev/null || rm -f "$tmp_file" 2>/dev/null
    fi
fi

# MID-SESSION NUDGE (the fix for ~6% follow-through): the old exit-time reminder
# fires when the agent is already done and won't act. Instead, the moment research
# happens — while the agent is still working and can write the entry with its own
# permissions — inject a reminder it sees. Claude PostToolUse reads
# hookSpecificOutput.additionalContext from stdout as model-visible context.
# Once per session (first_research), skip-honest so it never blocks.
if [ "$first_research" -eq 1 ]; then
    # Only Claude's PostToolUse consumes additionalContext; detect it by the wire
    # field. Gemini/Codex ignore unknown stdout — their exit-time nudge still covers
    # them — so emitting this is safe cross-agent (no-op where unsupported).
    hook_event="$(printf '%s' "$input" | jq -r '.hook_event_name // empty' 2>/dev/null)"
    if [ "$hook_event" = "PostToolUse" ]; then
        msg="You just did web research. If this turns up durable, reusable prior-art / library-eval / design findings (not one-off ops or debug), capture it to ai/research/ NOW while it is fresh — a real entry per ai/research/README.md + one INDEX.md line, with source_session: ${session_id:-this session}. Do it before moving on; do not defer to end-of-session. Skip only if there is nothing durable."
        jq -cn --arg m "$msg" '{hookSpecificOutput:{hookEventName:"PostToolUse",additionalContext:$m}}' 2>/dev/null || true
    fi
fi

exit 0
