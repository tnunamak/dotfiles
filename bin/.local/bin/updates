#!/usr/bin/env bash
# Show available upgrades, optionally pick and run them.
#
# Usage:
#   updates              # show details
#   updates --apply      # pick upgrades to run via fzf, then refresh cache
#   updates --refresh    # re-scan and show details
set -euo pipefail

CACHE_DIR="$HOME/.cache/shell-status"
DETAIL_FILE="$CACHE_DIR/details"
COMMANDS_FILE="$CACHE_DIR/commands"

case "${1:-}" in
  --refresh)
    cleanup --refresh || true
    shell-status-refresh
    exec "$0"
    ;;
  --apply)
    # Cache sudo credentials upfront so upgrades don't prompt mid-run
    sudo -v

    if [[ ! -f "$COMMANDS_FILE" ]] || [[ ! -s "$COMMANDS_FILE" ]]; then
      echo "Nothing to upgrade. Run 'updates --refresh' to re-scan."
      exit 0
    fi

    # fzf multi-select: show labels, extract commands
    selected=$(cut -f1 "$COMMANDS_FILE" \
      | fzf --multi --header="Select upgrades (TAB to toggle, ENTER to run)" \
      2>/dev/null) || exit 0

    [[ -z "$selected" ]] && exit 0

    # Collect commands from selections, then run with terminal stdin
    cmds=()
    labels=()
    while IFS= read -r label; do
      cmd=$(awk -F'\t' -v lbl="$label" '$1 == lbl {print $2}' "$COMMANDS_FILE")
      [[ -z "$cmd" ]] && continue
      labels+=("$label")
      cmds+=("$cmd")
    done <<< "$selected"

    for i in "${!cmds[@]}"; do
      echo ""
      echo "==> ${labels[$i]}"
      echo "  \$ ${cmds[$i]}"
      echo ""
      eval "${cmds[$i]}" || echo "  (exited with status $?)"
    done

    echo ""
    echo "Refreshing cache..."
    shell-status-refresh
    exec "$0"
    ;;
  *)
    if [[ -f "$DETAIL_FILE" ]]; then
      mtime=$(stat -c %Y "$DETAIL_FILE" 2>/dev/null || echo 0)
      now=$(date +%s)
      age=$(( now - mtime ))
      if   (( age < 60 ));    then age_str="${age}s ago"
      elif (( age < 3600 ));  then age_str="$((age/60))m ago"
      elif (( age < 86400 )); then age_str="$((age/3600))h ago"
      else age_str="$((age/86400))d ago"
      fi
      printf '\033[0;36m(scanned %s — run `updates --refresh` to re-scan)\033[0m\n\n' "$age_str"
      cat "$DETAIL_FILE"
    else
      echo "No details available. Run 'updates --refresh' to scan."
    fi
    ;;
esac
