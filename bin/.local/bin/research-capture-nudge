#!/usr/bin/env bash
# research-capture-nudge — pre-compaction (and session-end) hook: if any
# web-research tool was called this session, remind the agent to capture findings
# to ai/research/ before the context is compressed.
#
# CROSS-AGENT: wired as Claude PreCompact / Gemini PreCompress / Codex PreCompact
# (+ a SessionEnd/Stop backstop). All three inject context by printing plain text
# to stdout on exit 0. session_id is extracted defensively across agents.
# See ai/research/agentic-context-design/cross-agent-hooks-no-standard-*.md.
#
# PreCompact injects context by printing plain text to stdout on exit 0.
# Fail-silent: this hook must NEVER break the session.
#
# Env override for testing:
#   RESEARCH_CAPTURE_STATE_DIR — default: ~/.local/state/research-capture

STATE_DIR="${RESEARCH_CAPTURE_STATE_DIR:-$HOME/.local/state/research-capture}"

# Read stdin (may be empty for some hook types — that's fine).
input="$(cat 2>/dev/null || true)"

# Codex Stop hooks require a JSON object on stdout. Other lifecycle hooks keep
# their existing plain-text context-injection contract.
hook_event=""
if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    hook_event="$(printf '%s' "$input" | jq -r '.hook_event_name // .hookEventName // .event_name // empty' 2>/dev/null || true)"
fi
is_codex_stop=false
[ "$hook_event" = "Stop" ] && is_codex_stop=true

emit_empty_stop_response() {
    if $is_codex_stop; then
        printf '{}\n'
    fi
}

# Fail-silent wrapper: any unhandled exit goes to 0 with a valid Stop response.
trap 'emit_empty_stop_response; exit 0' ERR

# 1. Kill switch.
if [ -f "$STATE_DIR/OFF" ]; then
    emit_empty_stop_response
    exit 0
fi

# Extract session_id if available and jq is present.
session_id=""
if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    session_id="$(printf '%s' "$input" | jq -r '.session_id // .sessionId // .session.id // empty' 2>/dev/null || true)"
fi

# 2. Look for a pending flag: session-specific first, then any pending flag.
flag_file=""
if [ -n "$session_id" ] && [ -f "$STATE_DIR/research-pending-${session_id}" ]; then
    flag_file="$STATE_DIR/research-pending-${session_id}"
else
    # Glob for any pending flag (picks the first one found).
    for f in "$STATE_DIR"/research-pending-*; do
        if [ -f "$f" ]; then
            flag_file="$f"
            break
        fi
    done
fi

# No pending flag → no research this session → exit silently (or `{}` for Stop).
if [ -z "$flag_file" ]; then
    emit_empty_stop_response
    exit 0
fi

# 3. Build a short summary of tool kinds used (from flag content).
tool_kinds=""
if [ -f "$flag_file" ]; then
    # Extract the tool_name column (second field) from each line, deduplicate.
    tool_kinds="$(awk '{print $2}' "$flag_file" 2>/dev/null | sort -u | tr '\n' ',' | sed 's/,$//' || true)"
fi
[ -n "$tool_kinds" ] || tool_kinds="web-research tools"

# PreCompact injects plain-text context on stdout. Stop cannot inject context;
# keep the reminder visible on stderr and return the required JSON object.
reminder="Research-capture reminder: this session used web-research tools ($tool_kinds) and the conversation is about to be compacted. If real prior-art, library, or design research was done and the findings are worth keeping, capture them to ai/research/ now (new entry + one line in INDEX.md, per ai/research/README.md) before they are summarized away. Skip if there are no durable findings."
if $is_codex_stop; then
    printf '%s\n' "$reminder" >&2
    printf '{}\n'
else
    printf '%s\n' "$reminder"
fi

# 3b. Record that the nudge actually fired — one line per fire, so effectiveness
# is measurable after the fact (the hook is otherwise invisible: fires, prints,
# forgets). Fields: ISO-timestamp<TAB>session-id<TAB>comma-separated tool kinds.
# `wc -l` this file to see how often the nudge fired; cross-reference corpus
# commits to see if captures followed. Fail-silent; capped to the last 500 lines.
fire_log="$STATE_DIR/fire-log.tsv"
{
    ts="$(date -Iseconds 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%S+00:00)"
    printf '%s\t%s\t%s\n' "$ts" "${session_id:-unknown}" "$tool_kinds" >> "$fire_log"
    if [ "$(wc -l < "$fire_log" 2>/dev/null || echo 0)" -gt 500 ]; then
        tail -500 "$fire_log" > "${fire_log}.tmp" 2>/dev/null && mv "${fire_log}.tmp" "$fire_log" 2>/dev/null || rm -f "${fire_log}.tmp" 2>/dev/null
    fi
} 2>/dev/null || true

# 4. Delete the consumed flag file so it does not nudge again for the same research.
rm -f "$flag_file" 2>/dev/null || true

exit 0
