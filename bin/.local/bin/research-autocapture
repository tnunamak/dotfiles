#!/usr/bin/env bash
# research-autocapture — session-end hook that WRITES the research to disk itself,
# instead of asking the agent to. Closes the last gap: capture no longer depends
# on the agent choosing to write.
#
# On SessionEnd/Stop, if this session did real web research (pending flag exists),
# extract the queries + fetched URLs from the session's own transcript and drop a
# DRAFT entry into ai/research/_inbox/<session>.md. A human/agent later promotes
# the good ones to real entries (or deletes the junk) — but the RESEARCH ITSELF is
# now on disk, permanently, with zero agent cooperation.
#
# This is the safety net UNDER the nudge: the nudge still asks the agent to write a
# proper entry; if it doesn't, autocapture guarantees the raw research survives.
#
# Fail-silent. Never blocks the session. Emits `{}` for Codex Stop.
#
# Env override for testing:
#   RESEARCH_CAPTURE_STATE_DIR   — default: ~/.local/state/research-capture
#   RESEARCH_AUTOCAPTURE_DIR     — default: ~/code/dotfiles/ai/research/_inbox

STATE_DIR="${RESEARCH_CAPTURE_STATE_DIR:-$HOME/.local/state/research-capture}"
INBOX="${RESEARCH_AUTOCAPTURE_DIR:-$HOME/code/dotfiles/ai/research/_inbox}"
CLAUDE_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"
CODEX_DIR="${CODEX_SESSIONS_DIR:-$HOME/.codex/sessions}"

input="$(cat 2>/dev/null || true)"

hook_event=""
if command -v jq >/dev/null 2>&1 && [ -n "$input" ]; then
    hook_event="$(printf '%s' "$input" | jq -r '.hook_event_name // .hookEventName // .event_name // empty' 2>/dev/null || true)"
fi
is_codex_stop=false; [ "$hook_event" = "Stop" ] && is_codex_stop=true
emit() { $is_codex_stop && printf '{}\n'; }
trap 'emit; exit 0' ERR

# Kill switches: global OFF, or autocapture-specific OFF.
{ [ -f "$STATE_DIR/OFF" ] || [ -f "$STATE_DIR/AUTOCAPTURE_OFF" ]; } && { emit; exit 0; }
command -v jq >/dev/null 2>&1 || { emit; exit 0; }

session_id=""
[ -n "$input" ] && session_id="$(printf '%s' "$input" | jq -r '.session_id // .sessionId // .session.id // empty' 2>/dev/null || true)"

# Require a pending flag (this session did research). Session-specific, else any.
flag=""
if [ -n "$session_id" ] && [ -f "$STATE_DIR/research-pending-${session_id}" ]; then
    flag="$STATE_DIR/research-pending-${session_id}"
else
    for f in "$STATE_DIR"/research-pending-*; do [ -f "$f" ] && { flag="$f"; break; }; done
fi
[ -n "$flag" ] || { emit; exit 0; }

# Recover the session id from the flag filename if the payload lacked it.
[ -n "$session_id" ] || session_id="$(basename "$flag" | sed 's/^research-pending-//')"

# Locate the transcript (Claude stem = session id; Codex rollout encodes uuid).
transcript="$(find "$CLAUDE_DIR" -name "${session_id}.jsonl" 2>/dev/null | head -1)"
[ -n "$transcript" ] || transcript="$(find "$CODEX_DIR" -name "*${session_id}*.jsonl" 2>/dev/null | head -1)"

mkdir -p "$INBOX" 2>/dev/null || { emit; exit 0; }
out="$INBOX/${session_id}.md"
# Don't clobber an existing draft (idempotent across repeated Stop events).
[ -f "$out" ] && { emit; exit 0; }

# Pull queries + URLs from the transcript if we have one; else fall back to the
# flag's tool-kind list. Use the shared extractor when available.
extract="$HOME/.local/bin/research-recovery-extract"
body=""
if [ -n "$transcript" ] && [ -x "$extract" ]; then
    body="$(bash "$extract" "$transcript" 2>/dev/null)"
fi
[ -n "$body" ] || body="(no transcript found for extraction; tool kinds: $(awk '{print $2}' "$flag" 2>/dev/null | sort -u | tr '\n' ',' | sed 's/,$//'))"

ts="$(date -Iseconds 2>/dev/null || date -u +%Y-%m-%dT%H:%M:%S+00:00)"
date_only="$(printf '%s' "$ts" | cut -dT -f1)"

{
    printf -- '---\n'
    printf 'title: "AUTO-CAPTURED DRAFT — promote to a real entry or delete"\n'
    printf 'date: %s\n' "$date_only"
    printf 'topic: _inbox\n'
    printf 'tags: [autocaptured, needs-triage]\n'
    printf 'status: draft\n'
    printf 'source_session: %s\n' "$session_id"
    printf -- '---\n\n'
    printf '<!-- AUTO-CAPTURED by research-autocapture at session end. The agent did\n'
    printf 'research but may not have written a proper entry. This is the raw material\n'
    printf 'so nothing is lost. TRIAGE: if durable, rewrite as a real ai/research entry\n'
    printf '(per README worthiness test) and delete this file. If junk, just delete. -->\n\n'
    printf '%s\n' "$body"
} > "$out" 2>/dev/null || { emit; exit 0; }

# Log the autocapture (separate from nudge fire-log).
{ printf '%s\t%s\t%s\n' "$ts" "$session_id" "$out" >> "$STATE_DIR/autocapture-log.tsv"; } 2>/dev/null || true

emit
exit 0
