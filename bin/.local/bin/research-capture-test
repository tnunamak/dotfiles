#!/usr/bin/env bash
# research-capture-test — Self-contained test for research-capture-detect and
# research-capture-nudge. Uses a temp RESEARCH_CAPTURE_STATE_DIR — never touches
# real state.
#
# Exit nonzero if any test case fails.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DETECT="$SCRIPT_DIR/research-capture-detect"
NUDGE="$SCRIPT_DIR/research-capture-nudge"

# Sanity: both scripts must exist and be executable.
for f in "$DETECT" "$NUDGE"; do
    if [ ! -x "$f" ]; then
        echo "FATAL: $f not found or not executable" >&2
        exit 1
    fi
done

# Temp state dir (cleaned up on exit).
TEST_STATE="$(mktemp -d)"
export RESEARCH_CAPTURE_STATE_DIR="$TEST_STATE"
trap 'rm -rf "$TEST_STATE"' EXIT

# ── helpers ──────────────────────────────────────────────────────────────────

PASS=0
FAIL=0

pass() { echo "PASS: $*"; (( PASS++ )) || true; }
fail() { echo "FAIL: $*"; (( FAIL++ )) || true; }

posttooluse_json() {
    local tool_name="$1"
    local session_id="${2:-test-session-abc}"
    printf '{"tool_name":"%s","session_id":"%s","tool_input":{},"tool_response":{},"cwd":"/tmp"}' \
        "$tool_name" "$session_id"
}

precompact_json() {
    local session_id="${1:-test-session-abc}"
    printf '{"session_id":"%s"}' "$session_id"
}

# ── Test 1: non-research tool → no flag created ───────────────────────────────

posttooluse_json "Read" "session-t1" | "$DETECT" || true

if ls "$TEST_STATE"/research-pending-* 2>/dev/null | grep -q .; then
    fail "Test 1: Read tool should NOT create a flag, but one was found"
else
    pass "Test 1: Read tool (non-research) → no flag created"
fi

# ── Test 2: WebSearch → flag created, contains timestamp and tool name ────────

posttooluse_json "WebSearch" "session-t2" | "$DETECT" || true

flag_t2="$TEST_STATE/research-pending-session-t2"
if [ ! -f "$flag_t2" ]; then
    fail "Test 2: WebSearch should create a pending flag"
elif ! grep -q "WebSearch" "$flag_t2"; then
    fail "Test 2: flag does not contain tool name 'WebSearch'"
elif ! grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}' "$flag_t2"; then
    fail "Test 2: flag does not contain an ISO timestamp"
else
    pass "Test 2: WebSearch → flag created with timestamp and tool name"
fi

# ── Test 3: WebFetch then ctx_fetch_and_index (same session) → 2 entries ──────

posttooluse_json "WebFetch" "session-t3" | "$DETECT" || true
posttooluse_json "mcp__plugin_context-mode_context-mode__ctx_fetch_and_index" "session-t3" | "$DETECT" || true

flag_t3="$TEST_STATE/research-pending-session-t3"
if [ ! -f "$flag_t3" ]; then
    fail "Test 3: flag should exist after two research tool calls"
else
    entry_count="$(wc -l < "$flag_t3")"
    if [ "$entry_count" -lt 2 ]; then
        fail "Test 3: expected >=2 entries in flag, got $entry_count"
    elif ! grep -q "WebFetch" "$flag_t3"; then
        fail "Test 3: flag missing WebFetch entry"
    elif ! grep -q "ctx_fetch_and_index" "$flag_t3"; then
        fail "Test 3: flag missing ctx_fetch_and_index entry"
    else
        pass "Test 3: WebFetch + ctx_fetch_and_index → flag has 2 entries"
    fi
fi

# ── Test 4: nudge with pending flag → prints ai/research/ and INDEX.md; flag deleted ──

posttooluse_json "WebSearch" "session-t4" | "$DETECT" || true

flag_t4="$TEST_STATE/research-pending-session-t4"
if [ ! -f "$flag_t4" ]; then
    fail "Test 4: setup failed — flag not created for session-t4"
else
    nudge_output="$(precompact_json "session-t4" | "$NUDGE" || true)"

    if ! printf '%s' "$nudge_output" | grep -q "ai/research/"; then
        fail "Test 4: nudge output does not contain 'ai/research/'"
    elif ! printf '%s' "$nudge_output" | grep -q "INDEX.md"; then
        fail "Test 4: nudge output does not contain 'INDEX.md'"
    elif [ -f "$flag_t4" ]; then
        fail "Test 4: flag was NOT deleted after nudge"
    else
        pass "Test 4: nudge prints 'ai/research/' and 'INDEX.md'; flag deleted afterward"
    fi
fi

# ── Test 5: nudge with NO pending flag → prints nothing, exit 0 ──────────────

# Remove ALL pending flags so the glob fallback also finds nothing.
rm -f "$TEST_STATE"/research-pending-* 2>/dev/null || true

nudge_output_empty="$(precompact_json "session-t5" | "$NUDGE" || true)"

if [ -n "$nudge_output_empty" ]; then
    fail "Test 5: nudge with no pending flag should print nothing, got: $nudge_output_empty"
else
    pass "Test 5: nudge with no pending flag → prints nothing, exit 0"
fi

# ── Test 6: kill switch OFF → detector and nudge both silent ──────────────────

touch "$TEST_STATE/OFF"

posttooluse_json "WebSearch" "session-t6" | "$DETECT" || true
flag_t6="$TEST_STATE/research-pending-session-t6"
if [ -f "$flag_t6" ]; then
    fail "Test 6a: kill switch present but detector still created a flag"
else
    pass "Test 6a: kill switch OFF → detector creates no flag"
fi

# Also create a flag manually and confirm nudge is silent when OFF is present.
printf '2026-06-26T00:00:00+00:00 WebSearch\n' > "$TEST_STATE/research-pending-session-t6-manual"
nudge_kill_output="$(precompact_json "session-t6-manual" | "$NUDGE" || true)"
if [ -n "$nudge_kill_output" ]; then
    fail "Test 6b: kill switch present but nudge still printed output"
else
    pass "Test 6b: kill switch OFF → nudge prints nothing"
fi

# Cleanup kill switch so it doesn't affect other suites if this script is re-run.
rm -f "$TEST_STATE/OFF"

# ── Test 7: fire-log — nudge appends one line when it fires, none otherwise ────

fire_log="$TEST_STATE/fire-log.tsv"
rm -f "$fire_log"

# a) A real fire (flag present) writes exactly one line with the tool kind.
posttooluse_json "WebSearch" "session-t7" | "$DETECT" || true
precompact_json "session-t7" | "$NUDGE" >/dev/null || true
if [ ! -f "$fire_log" ]; then
    fail "Test 7: fire-log not created after the nudge fired"
elif [ "$(wc -l < "$fire_log")" -ne 1 ]; then
    fail "Test 7: expected 1 fire-log line, got $(wc -l < "$fire_log")"
elif ! grep -q "WebSearch" "$fire_log"; then
    fail "Test 7: fire-log line missing the tool kind"
elif ! grep -q "session-t7" "$fire_log"; then
    fail "Test 7: fire-log line missing the session id"
else
    # b) A no-fire call (NO pending flags at all) must NOT append a line.
    # Clear every flag first — the nudge's glob fallback fires on ANY pending
    # flag, so a leftover from an earlier test would (correctly) fire and log.
    rm -f "$TEST_STATE"/research-pending-* 2>/dev/null || true
    precompact_json "session-nobody" | "$NUDGE" >/dev/null || true
    if [ "$(wc -l < "$fire_log")" -ne 1 ]; then
        fail "Test 7: a no-fire nudge still appended to the fire-log"
    else
        pass "Test 7: fire-log gets one line per fire, none when it doesn't fire"
    fi
fi

# ── Summary ───────────────────────────────────────────────────────────────────

echo ""
echo "Results: $PASS passed, $FAIL failed"

if [ "$FAIL" -gt 0 ]; then
    exit 1
fi

exit 0
