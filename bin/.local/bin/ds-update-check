#!/usr/bin/env bash
# ds-update-check — SessionStart hook: notify the agent when a newer devspecs
# (`ds`) release exists. NOTIFY ONLY — it never installs (ds lives in
# /usr/local/bin which needs sudo; upgrading means re-running install.sh).
#
# TEMPORARY: part of the ~1–2 week devspecs trial started 2026-06-13. When the
# trial ends, delete this script and its SessionStart entry in
# claude/.claude/settings.json. See inbox/devspecs-feedback.md.
#
# Behavior:
#   - Checks GitHub's latest release AT MOST once/day (cached), non-blocking.
#   - Fails completely silently on no network / no curl / ds absent — a session
#     start must never be slowed or broken by this.
#   - When a newer version exists, prints SessionStart additionalContext JSON so
#     the agent sees it and can offer to run the upgrade (needs the user's sudo).
set -euo pipefail

REPO="devspecs-com/devspecs-cli"
CACHE_DIR="$HOME/.cache/ds-update-check"
LATEST_CACHE="$CACHE_DIR/latest"   # holds the latest tag (e.g. v1.0.2)
TTL=86400                          # 1 day

# ds not installed → nothing to do.
command -v ds >/dev/null 2>&1 || exit 0

# Current version, e.g. "ds 1.0.1 (...)" → "1.0.1". Bail quietly if unparseable.
current="$(ds version 2>/dev/null | sed -nE 's/^ds ([0-9]+\.[0-9]+\.[0-9]+).*/\1/p')"
[ -n "$current" ] || exit 0

mkdir -p "$CACHE_DIR"

# Refresh the cached latest tag at most once/day. Network failures are ignored
# (stale or missing cache just means "no nag this session").
cache_fresh() {
  [ -f "$LATEST_CACHE" ] || return 1
  local mtime now
  mtime="$(stat -c %Y "$LATEST_CACHE" 2>/dev/null || echo 0)"
  now="$(date +%s)"
  (( now - mtime < TTL ))
}

if ! cache_fresh; then
  if command -v curl >/dev/null 2>&1; then
    latest_tag="$(curl -fsSL --max-time 4 \
      "https://api.github.com/repos/${REPO}/releases/latest" 2>/dev/null \
      | grep '"tag_name":' | sed -E 's/.*"([^"]+)".*/\1/' || true)"
    # Only overwrite the cache on a successful, well-formed fetch.
    if printf '%s' "$latest_tag" | grep -qE '^v?[0-9]+\.[0-9]+\.[0-9]+$'; then
      printf '%s\n' "$latest_tag" > "$LATEST_CACHE"
    fi
  fi
fi

[ -f "$LATEST_CACHE" ] || exit 0
latest="$(sed -E 's/^v//' "$LATEST_CACHE")"
[ -n "$latest" ] || exit 0

# Already up to date (or ahead) → silent.
[ "$current" = "$latest" ] && exit 0
# Sort check: if current is >= latest, do nothing (guards against a transient
# bad cache or a local build newer than the published release).
newest="$(printf '%s\n%s\n' "$current" "$latest" | sort -V | tail -1)"
[ "$newest" = "$latest" ] || exit 0

# Newer release exists → tell the agent via SessionStart additionalContext.
ctx="devspecs (ds) update available: installed ${current}, latest ${latest}. \
This is part of Tim's devspecs trial (see ai/AGENTS.md). Offer to upgrade by \
running: curl -fsSL https://raw.githubusercontent.com/${REPO}/main/install.sh | sh \
— it writes to /usr/local/bin and will need sudo, so confirm with Tim first. \
After upgrading, if ds errors with a schema/migration message, run \
'rm -rf ~/.devspecs && ds init --yes'. Mention this once; don't nag if declined."

# Emit JSON additionalContext. Use python for safe escaping (always present here).
python3 - "$ctx" <<'PY' 2>/dev/null || true
import json, sys
print(json.dumps({
    "hookSpecificOutput": {
        "hookEventName": "SessionStart",
        "additionalContext": sys.argv[1],
    }
}))
PY
