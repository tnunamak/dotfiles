#!/usr/bin/env bash
# research-capture-audit — answer "is my research actually in the corpus?" without
# trusting any agent's summary. Run it yourself; it reads the session transcripts
# and the corpus directly.
#
# WHY THIS EXISTS: an agent claiming "the research is captured" is exactly the
# kind of assertion that has been wrong repeatedly here (a backfill covering 5%
# of the population was reported as done). This is the independent check.
#
# Definitions (kept identical to how the 6% baseline was measured):
#   research session = a top-level transcript (NOT agent-*) containing a real
#                      tool_use of WebSearch|WebFetch|web_fetch|searxng_web_search|web_url_read
#   captured         = that same session has a tool_use Write|Edit|MultiEdit whose
#                      path matches ai/research/.+\.md, OR a corpus entry carries
#                      source_session: <that id>
#
# Usage:
#   research-capture-audit                 # summary
#   research-capture-audit --list          # also list uncaptured session ids
#   research-capture-audit --since 30d     # only transcripts modified recently

set -u
CORPUS="${RESEARCH_CORPUS_DIR:-$HOME/code/dotfiles/ai/research}"
CLAUDE_DIR="${CLAUDE_PROJECTS_DIR:-$HOME/.claude/projects}"
RES_RE='WebSearch|WebFetch|web_fetch|searxng_web_search|web_url_read'
LIST=0; SINCE=""
while [ $# -gt 0 ]; do
  case "$1" in
    --list) LIST=1; shift ;;
    --since) SINCE="$2"; shift 2 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "unknown arg: $1" >&2; exit 2 ;;
  esac
done
command -v jq >/dev/null 2>&1 || { echo "jq required" >&2; exit 1; }

find_args=( "$CLAUDE_DIR" -name '*.jsonl' )
[ -n "$SINCE" ] && find_args+=( -newermt "$SINCE ago" )

# Pre-index which session ids are claimed by a corpus entry (attribution).
attributed="$(grep -rhoE '^source_session: [A-Za-z0-9-]+' "$CORPUS" 2>/dev/null | awk '{print $2}' | sort -u)"

researched=0; captured=0
tmp="$(mktemp)"; trap 'rm -f "$tmp"' EXIT

while IFS= read -r f; do
  b="$(basename "$f" .jsonl)"
  case "$b" in agent-*) continue ;; esac
  jq -e --arg re "$RES_RE" '
      select(.message.content?|type=="array") | .message.content[]
      | select(.type=="tool_use" and (.name|test($re)))' "$f" >/dev/null 2>&1 || continue
  researched=$((researched+1))

  hit=0
  # (a) wrote to the corpus during the session
  if jq -r 'select(.message.content?|type=="array") | .message.content[]
            | select(.type=="tool_use" and (.name|test("Write|Edit|MultiEdit")))
            | (.input.file_path // .input.path // empty)' "$f" 2>/dev/null \
       | grep -qE 'ai/research/.+\.md'; then hit=1; fi
  # (b) a corpus entry attributes itself to this session
  if [ "$hit" -eq 0 ] && printf '%s\n' "$attributed" | grep -qxF "$b"; then hit=1; fi

  if [ "$hit" -eq 1 ]; then captured=$((captured+1)); else echo "$b" >> "$tmp"; fi
done < <(find "${find_args[@]}" 2>/dev/null)

uncaptured=$((researched - captured))
pct=0
[ "$researched" -gt 0 ] && pct=$(( captured * 100 / researched ))

echo "Research capture audit  ($(date -Iseconds))"
echo "  corpus:            $CORPUS"
[ -n "$SINCE" ] && echo "  window:            last $SINCE"
echo "  research sessions: $researched"
echo "  captured:          $captured"
echo "  UNCAPTURED:        $uncaptured"
echo "  capture rate:      ${pct}%"
echo
if [ "$uncaptured" -eq 0 ]; then
  echo "  ✅ every research session is represented in the corpus."
else
  echo "  ⚠️  $uncaptured research sessions have no corpus entry."
  [ "$LIST" -eq 1 ] && { echo "  uncaptured session ids:"; sed 's/^/    /' "$tmp"; } \
                    || echo "     (re-run with --list to see them)"
fi
