#!/usr/bin/env bash
# Detects a wedged org.freedesktop.secrets (ksecretd) and kills it so
# dbus-daemon respawns a fresh, working instance on the next activation.
#
# Root cause this exists for (2026-07-28): ksecretd can come up successfully
# at boot, run fine for a while, then go silently unresponsive — process
# alive, 0% CPU, but every D-Bus call (including from `infisical export`)
# hangs forever with no reply. This is a known, recurring KDE bug CLASS, not
# specific to our boot-race fix: KDE Bug 504656 (kwallet 6.14, empty-named
# wallet freezes ksecretd's D-Bus dispatch) and KDE Bug 504014 (disabled
# KWallet leaves callers hung ~60s) are both the same underlying mechanism —
# ksecretd is single-threaded on one Qt event loop, so ONE mishandled
# request (bad object path, disabled-state check, blocked nested loop —
# see also the 2011-era KDE Bug 259942) wedges the loop and every caller,
# not just the triggering one, hangs silently forever. Neither of those two
# specific triggers matches ours exactly, so the specific cause here may be
# a third, undocumented trigger in the same class.
#
# Why `kill` (SIGTERM) is the fix, not a longer wait: researched directly
# from ksecretd's source (invent.kde.org/frameworks/kwallet,
# src/runtime/ksecretd/main.cpp) — it installs no SIGTERM/SIGINT handler, so
# SIGTERM and SIGKILL are equivalent to it; there's no graceful-shutdown
# routine to interrupt. The specific symptom this script targets (process
# state S/sleeping, 0% CPU, D-Bus calls timing out) means the event loop is
# blocked waiting on something that will never signal — not mid-write to a
# wallet file (that would show D/uninterruptible-sleep or CPU burn), so
# killing it is not expected to corrupt wallet state.
#
# Why Ping specifically, not a real Secret Service call: the D-Bus spec
# defines org.freedesktop.DBus.Peer.Ping as a trivial no-op reply. Pinging a
# NAMED destination (not the bus daemon itself) routes the message through
# to that process and is answered by its own main loop (confirmed for both
# GDBus/GLib and QtDBus, which ksecretd uses) — so a Ping timeout is
# evidence the target's event loop isn't pumping at all, the exact failure
# this script detects. There's no meaningful "healthy but too busy to
# answer a trivial Ping" case that wouldn't ALSO make ksecretd useless to a
# real caller like Infisical, so Ping is a faithful, cheap proxy.
#
# Why this is a standalone script, not baked into shell/.shell_config: it
# has two independent callers (interactive shell startup via
# .shell_config, and MCP server preflight), and a shared, debounced result
# means a burst of near-simultaneous callers (e.g. several tmux panes
# starting at once) pay the Ping-timeout cost once, not once each. There is
# no existing systemd/dbus-daemon mechanism to lean on instead of this:
# WatchdogSec= requires the target app to call sd_notify() on a timer,
# which ksecretd does not implement; dbus-daemon has zero liveness-checking
# of a service once it has claimed its bus name. Researched directly, not
# assumed — see ai/research/self-hosting/ for the source-cited writeup.
set -euo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/secrets-service-health-check"
DEBOUNCE_FILE="$STATE_DIR/last-check"
DEBOUNCE_SECONDS="${SECRETS_HEALTH_DEBOUNCE_SECONDS:-30}"
PING_TIMEOUT="${SECRETS_HEALTH_PING_TIMEOUT:-8}"

mkdir -p "$STATE_DIR"

_now_seconds() {
  local uptime_seconds
  if [[ -r /proc/uptime ]] && IFS='. ' read -r uptime_seconds _ </proc/uptime; then
    printf '%s\n' "$uptime_seconds"
  else
    printf '%s\n' "$SECONDS"
  fi
}

# Debounce: if another caller already checked recently, reuse that result
# instead of re-pinging. A flock-guarded read-check-write keeps concurrent
# callers from all deciding "no recent check" at once and each paying the
# full Ping timeout.
exec 9>"$STATE_DIR/lock"
if flock -w 2 9; then
  now="$(_now_seconds)"
  if [[ -f "$DEBOUNCE_FILE" ]]; then
    last="$(cat "$DEBOUNCE_FILE" 2>/dev/null || echo 0)"
    if [[ "$last" =~ ^[0-9]+$ ]] && (( now - last < DEBOUNCE_SECONDS )); then
      flock -u 9
      exit 0
    fi
  fi
  printf '%s\n' "$now" >"$DEBOUNCE_FILE"
fi
flock -u 9

command -v gdbus >/dev/null 2>&1 || exit 0
command -v pgrep >/dev/null 2>&1 || exit 0

# No secrets service running at all — nothing to check. This is a normal
# state (e.g. never yet activated this boot); D-Bus activation will start
# it fresh on first real use, which is not the failure mode this guards.
pgrep -x ksecretd >/dev/null 2>&1 || exit 0

if timeout "$PING_TIMEOUT" gdbus call --session \
  --dest org.freedesktop.secrets \
  --object-path /org/freedesktop/secrets \
  --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1; then
  exit 0
fi

# Ping timed out against a process we confirmed is running: wedged, not
# absent. Kill it so dbus-daemon activates a fresh instance on next use.
pkill -x ksecretd 2>/dev/null || true
