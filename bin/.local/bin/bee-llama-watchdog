#!/usr/bin/env python3
"""Restart llama-bee only after its healthy active task stops making progress.

The liveness decision is deliberately kept separate from HTTP, subprocess, and
filesystem effects so the state machine can be tested without a running model.
It only observes task identifiers and numeric progress counters; it never reads
or logs prompts or generated tokens.
"""

from __future__ import annotations

import argparse
import errno
import json
import os
import shutil
import socket
import subprocess
import sys
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from pathlib import Path
from typing import Any, Callable, Iterable, Literal, Protocol


DEFAULT_BASE_URL = "http://127.0.0.1:5051"
DEFAULT_UNIT = "llama-bee.service"
DEFAULT_INTERVAL_SECONDS = 30.0
DEFAULT_THRESHOLD = 6
DEFAULT_HTTP_TIMEOUT_SECONDS = 10.0
DEFAULT_RESTART_WINDOW_SECONDS = 30 * 60
DEFAULT_RESTART_LIMIT = 2
COMMAND_TIMEOUT_SECONDS = 5.0
MAX_CAPTURE_BYTES = 256 * 1024
MAX_EVIDENCE_DIRECTORIES = 30


@dataclass(frozen=True)
class SlotSample:
    """The only slot fields used to make a liveness decision."""

    task_id: str
    prompt_tokens_processed: int
    decoded_tokens: int


@dataclass(frozen=True)
class WatchdogConfig:
    health_url: str
    slots_url: str
    unit: str
    interval_seconds: float
    threshold: int
    http_timeout_seconds: float
    restart_limit: int
    restart_window_seconds: float
    state_dir: Path
    systemctl_bin: str
    journalctl_bin: str
    nvidia_smi_bin: str
    ps_bin: str


class CommandRunner(Protocol):
    def __call__(self, command: list[str], timeout: float) -> subprocess.CompletedProcess[bytes]: ...


class JsonFetcher(Protocol):
    def __call__(self, url: str, timeout: float) -> Any: ...


class EventLogger:
    """Append bounded, content-free operational events to a disk-backed log."""

    def __init__(self, state_dir: Path, wall_clock: Callable[[], float] = time.time) -> None:
        self.state_dir = state_dir
        self.wall_clock = wall_clock

    def write(self, message: str) -> None:
        line = f"{time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(self.wall_clock()))} {message}\n"
        print(f"[bee-llama-watchdog] {message}", file=sys.stderr, flush=True)
        try:
            self.state_dir.mkdir(parents=True, exist_ok=True)
            log_path = self.state_dir / "watchdog.log"
            if log_path.exists() and log_path.stat().st_size > 1024 * 1024:
                rotated = self.state_dir / "watchdog.log.1"
                os.replace(log_path, rotated)
            with log_path.open("a", encoding="utf-8") as handle:
                handle.write(line)
        except OSError as error:
            print(f"[bee-llama-watchdog] could not write state log: {error}", file=sys.stderr, flush=True)


class LivenessState:
    """Explicit progress/timeout state for every currently processing task."""

    def __init__(self, threshold: int) -> None:
        self.threshold = threshold
        self.previous_by_task: dict[str, SlotSample] = {}
        self.stagnant_samples_by_task: dict[str, int] = {}
        self.slot_timeouts = 0

    def reset(self) -> None:
        self.previous_by_task.clear()
        self.stagnant_samples_by_task.clear()
        self.slot_timeouts = 0

    def observe_idle(self) -> None:
        self.reset()

    def observe_unknown(self) -> None:
        """Fail safe: unknown data cannot be evidence of a hang."""
        self.reset()

    def observe_timeout(self) -> bool:
        self.previous_by_task.clear()
        self.stagnant_samples_by_task.clear()
        self.slot_timeouts += 1
        return self.slot_timeouts >= self.threshold

    def observe_samples(self, samples: list[SlotSample]) -> bool:
        self.slot_timeouts = 0
        active_task_ids = {sample.task_id for sample in samples}
        for task_id in tuple(self.previous_by_task):
            if task_id not in active_task_ids:
                self.previous_by_task.pop(task_id)
                self.stagnant_samples_by_task.pop(task_id, None)

        for sample in samples:
            previous = self.previous_by_task.get(sample.task_id)
            self.previous_by_task[sample.task_id] = sample
            if previous is None:
                self.stagnant_samples_by_task[sample.task_id] = 0
                continue

            prompt_delta = sample.prompt_tokens_processed - previous.prompt_tokens_processed
            decoded_delta = sample.decoded_tokens - previous.decoded_tokens
            if prompt_delta > 0 or decoded_delta > 0:
                self.stagnant_samples_by_task[sample.task_id] = 0
                continue
            if prompt_delta < 0 or decoded_delta < 0:
                # A counter reset is not trustworthy evidence of a stuck task.
                self.stagnant_samples_by_task[sample.task_id] = 0
                continue

            stagnant_samples = self.stagnant_samples_by_task.get(sample.task_id, 0) + 1
            self.stagnant_samples_by_task[sample.task_id] = stagnant_samples
            if stagnant_samples >= self.threshold:
                return True
        return False


class RestartHistory:
    """Durable rate-limit state. Corrupt or unavailable state denies a restart."""

    def __init__(self, path: Path, limit: int, window_seconds: float) -> None:
        self.path = path
        self.limit = limit
        self.window_seconds = window_seconds

    def allow_and_record(self, now: float) -> bool:
        try:
            timestamps = self._load()
            cutoff = now - self.window_seconds
            recent = [timestamp for timestamp in timestamps if timestamp >= cutoff]
            if len(recent) >= self.limit:
                return False
            self._save([*recent, now])
            return True
        except (OSError, ValueError, json.JSONDecodeError, TypeError):
            return False

    def _load(self) -> list[float]:
        if not self.path.exists():
            return []
        raw = json.loads(self.path.read_text(encoding="utf-8"))
        if not isinstance(raw, list) or any(isinstance(value, bool) or not isinstance(value, (int, float)) for value in raw):
            raise ValueError("restart history is not a numeric list")
        return [float(value) for value in raw]

    def _save(self, timestamps: list[float]) -> None:
        self.path.parent.mkdir(parents=True, exist_ok=True)
        descriptor, temporary_name = tempfile.mkstemp(prefix="restart-history.", dir=self.path.parent)
        temporary_path = Path(temporary_name)
        try:
            with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
                json.dump(timestamps, handle)
                handle.write("\n")
                handle.flush()
                os.fsync(handle.fileno())
            os.replace(temporary_path, self.path)
        finally:
            temporary_path.unlink(missing_ok=True)


def fetch_json(url: str, timeout: float) -> Any:
    request = urllib.request.Request(url, headers={"Accept": "application/json"})
    with urllib.request.urlopen(request, timeout=timeout) as response:  # noqa: S310 -- fixed localhost URL by default
        return json.load(response)


def is_health_ok(payload: Any) -> bool:
    return isinstance(payload, dict) and payload.get("status") == "ok"


def parse_active_slots(payload: Any) -> list[SlotSample]:
    """Parse every processing slot, treating malformed payloads as unknown."""
    if isinstance(payload, dict):
        slots = payload.get("slots", payload if "id_task" in payload else None)
    else:
        slots = payload
    if isinstance(slots, dict):
        slots = [slots]
    if not isinstance(slots, list):
        raise ValueError("slots payload is not a list")

    samples: list[SlotSample] = []
    task_ids: set[str] = set()
    for slot in slots:
        if not isinstance(slot, dict) or not isinstance(slot.get("is_processing"), bool):
            raise ValueError("slots payload has an invalid slot")
        if not slot["is_processing"]:
            continue
        task_id = slot.get("id_task")
        prompt_tokens = slot.get("n_prompt_tokens_processed")
        next_token = slot.get("next_token")
        decoded_tokens = next_token.get("n_decoded") if isinstance(next_token, dict) else None
        if not isinstance(task_id, (str, int)) or isinstance(task_id, bool) or task_id == "":
            raise ValueError("processing slot has no task id")
        if any(isinstance(value, bool) or not isinstance(value, int) or value < 0 for value in (prompt_tokens, decoded_tokens)):
            raise ValueError("processing slot has invalid progress counters")
        normalized_task_id = str(task_id)
        if normalized_task_id in task_ids:
            raise ValueError("multiple processing slots share a task id")
        task_ids.add(normalized_task_id)
        samples.append(SlotSample(normalized_task_id, prompt_tokens, decoded_tokens))
    return samples


def default_runner(command: list[str], timeout: float) -> subprocess.CompletedProcess[bytes]:
    return subprocess.run(command, check=False, capture_output=True, timeout=timeout)


def command_succeeded(runner: CommandRunner, command: list[str]) -> bool:
    try:
        return runner(command, COMMAND_TIMEOUT_SECONDS).returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        return False


def write_bounded_command_output(path: Path, command: list[str], runner: CommandRunner) -> None:
    """Capture a command blindly and cap its artifact; never parse command output."""
    try:
        result = runner(command, COMMAND_TIMEOUT_SECONDS)
        output = result.stdout + result.stderr
        status = f"command: {command!r}\nexit_code: {result.returncode}\n\n".encode()
    except subprocess.TimeoutExpired:
        output = b"command timed out\n"
        status = f"command: {command!r}\n\n".encode()
    except OSError as error:
        output = f"command failed: {error}\n".encode()
        status = f"command: {command!r}\n\n".encode()
    truncated = output[:MAX_CAPTURE_BYTES]
    suffix = b"\n[truncated]\n" if len(output) > MAX_CAPTURE_BYTES else b""
    path.write_bytes(status + truncated + suffix)


class EvidenceCapture:
    def __init__(self, config: WatchdogConfig, runner: CommandRunner, logger: EventLogger, wall_clock: Callable[[], float]) -> None:
        self.config = config
        self.runner = runner
        self.logger = logger
        self.wall_clock = wall_clock

    def capture(self, reason: Literal["stagnant", "slot-timeouts"]) -> None:
        try:
            evidence_root = self.config.state_dir / "evidence"
            evidence_root.mkdir(parents=True, exist_ok=True)
            stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(self.wall_clock()))
            directory = evidence_root / f"{stamp}-{reason}"
            directory.mkdir()
            (directory / "trigger.txt").write_text(
                f"timestamp_utc: {stamp}\nreason: {reason}\nunit: {self.config.unit}\n",
                encoding="utf-8",
            )
            write_bounded_command_output(
                directory / "journal.txt",
                [self.config.journalctl_bin, "--user", "-u", self.config.unit, "-n", "200", "--no-pager"],
                self.runner,
            )
            write_bounded_command_output(directory / "nvidia-smi.txt", [self.config.nvidia_smi_bin], self.runner)
            write_bounded_command_output(
                directory / "process-state.txt",
                [self.config.ps_bin, "-eo", "pid,ppid,stat,etime,pcpu,pmem,comm,wchan", "--sort=-pcpu"],
                self.runner,
            )
            (directory / "DONE").write_text("\n", encoding="utf-8")
            self._prune(evidence_root)
            self.logger.write(f"captured {reason} evidence at {directory}")
        except OSError as error:
            self.logger.write(f"evidence capture failed: {error}")

    def _prune(self, evidence_root: Path) -> None:
        directories = sorted((path for path in evidence_root.iterdir() if path.is_dir()), key=lambda path: path.name, reverse=True)
        for directory in directories[MAX_EVIDENCE_DIRECTORIES:]:
            shutil.rmtree(directory)


class BeeLlamaWatchdog:
    def __init__(
        self,
        config: WatchdogConfig,
        service_active: Callable[[], bool],
        json_fetcher: JsonFetcher,
        capture: Callable[[Literal["stagnant", "slot-timeouts"]], None],
        restart: Callable[[], bool],
        restart_history: RestartHistory,
        logger: EventLogger,
        wall_clock: Callable[[], float] = time.time,
    ) -> None:
        self.config = config
        self.service_active = service_active
        self.json_fetcher = json_fetcher
        self.capture = capture
        self.restart = restart
        self.restart_history = restart_history
        self.logger = logger
        self.wall_clock = wall_clock
        self.liveness = LivenessState(config.threshold)

    def poll_once(self) -> None:
        if not self.service_active():
            self.liveness.reset()
            return
        try:
            health = self.json_fetcher(self.config.health_url, self.config.http_timeout_seconds)
        except (OSError, TimeoutError, urllib.error.URLError, json.JSONDecodeError):
            self.liveness.observe_unknown()
            self.logger.write("health check unavailable; liveness reset")
            return
        if not is_health_ok(health):
            self.liveness.observe_unknown()
            self.logger.write("health is not ok; liveness reset")
            return

        try:
            slots = self.json_fetcher(self.config.slots_url, self.config.http_timeout_seconds)
        except Exception as error:  # classified immediately; no untrusted payload is logged
            if is_timeout(error):
                if self.liveness.observe_timeout():
                    self._handle_trigger("slot-timeouts")
            else:
                self.liveness.observe_unknown()
                self.logger.write("slots request unavailable; liveness reset")
            return

        try:
            samples = parse_active_slots(slots)
        except ValueError:
            self.liveness.observe_unknown()
            self.logger.write("slots response malformed or ambiguous; liveness reset")
            return
        if not samples:
            self.liveness.observe_idle()
            return
        if self.liveness.observe_samples(samples):
            self._handle_trigger("stagnant")

    def _handle_trigger(self, reason: Literal["stagnant", "slot-timeouts"]) -> None:
        self.liveness.reset()
        if not self.restart_history.allow_and_record(self.wall_clock()):
            self.logger.write(f"{reason} threshold reached; automated restart rate-limited")
            return
        self.capture(reason)
        if self.restart():
            self.logger.write(f"restarted {self.config.unit} after {reason} threshold")
        else:
            self.logger.write(f"restart command failed after {reason} threshold")


def is_timeout(error: BaseException) -> bool:
    if isinstance(error, (TimeoutError, socket.timeout, subprocess.TimeoutExpired)):
        return True
    reason = error.reason if isinstance(error, urllib.error.URLError) else error
    return isinstance(reason, OSError) and reason.errno == errno.ETIMEDOUT


def make_config(arguments: argparse.Namespace) -> WatchdogConfig:
    base_url = arguments.base_url.rstrip("/")
    state_dir = Path(arguments.state_dir).expanduser()
    health_url = arguments.health_url or f"{base_url}/health"
    slots_url = arguments.slots_url or f"{base_url}/slots"
    validate_local_http_url(health_url, "health URL")
    validate_local_http_url(slots_url, "slots URL")
    return WatchdogConfig(
        health_url=health_url,
        slots_url=slots_url,
        unit=arguments.unit,
        interval_seconds=arguments.interval_seconds,
        threshold=arguments.threshold,
        http_timeout_seconds=arguments.http_timeout_seconds,
        restart_limit=arguments.restart_limit,
        restart_window_seconds=arguments.restart_window_seconds,
        state_dir=state_dir,
        systemctl_bin=arguments.systemctl_bin,
        journalctl_bin=arguments.journalctl_bin,
        nvidia_smi_bin=arguments.nvidia_smi_bin,
        ps_bin=arguments.ps_bin,
    )


def validate_local_http_url(url: str, label: str) -> None:
    parsed = urllib.parse.urlsplit(url)
    if parsed.scheme != "http" or parsed.hostname != "127.0.0.1" or parsed.username or parsed.password:
        raise ValueError(f"{label} must be an unauthenticated http://127.0.0.1 URL")


def parse_arguments(argv: Iterable[str] | None = None) -> argparse.Namespace:
    state_home = os.environ.get("XDG_STATE_HOME", os.path.expanduser("~/.local/state"))
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--base-url", default=os.environ.get("BEE_LLAMA_WATCHDOG_BASE_URL", DEFAULT_BASE_URL))
    parser.add_argument("--health-url", default=os.environ.get("BEE_LLAMA_WATCHDOG_HEALTH_URL"))
    parser.add_argument("--slots-url", default=os.environ.get("BEE_LLAMA_WATCHDOG_SLOTS_URL"))
    parser.add_argument("--unit", default=os.environ.get("BEE_LLAMA_WATCHDOG_UNIT", DEFAULT_UNIT))
    parser.add_argument("--interval-seconds", type=float, default=float(os.environ.get("BEE_LLAMA_WATCHDOG_INTERVAL_SECONDS", DEFAULT_INTERVAL_SECONDS)))
    parser.add_argument("--threshold", type=int, default=int(os.environ.get("BEE_LLAMA_WATCHDOG_THRESHOLD", DEFAULT_THRESHOLD)))
    parser.add_argument("--http-timeout-seconds", type=float, default=float(os.environ.get("BEE_LLAMA_WATCHDOG_HTTP_TIMEOUT_SECONDS", DEFAULT_HTTP_TIMEOUT_SECONDS)))
    parser.add_argument("--restart-limit", type=int, default=int(os.environ.get("BEE_LLAMA_WATCHDOG_RESTART_LIMIT", DEFAULT_RESTART_LIMIT)))
    parser.add_argument("--restart-window-seconds", type=float, default=float(os.environ.get("BEE_LLAMA_WATCHDOG_RESTART_WINDOW_SECONDS", DEFAULT_RESTART_WINDOW_SECONDS)))
    parser.add_argument("--state-dir", default=os.environ.get("BEE_LLAMA_WATCHDOG_STATE_DIR", os.path.join(state_home, "bee-llama-watchdog")))
    parser.add_argument("--systemctl-bin", default=os.environ.get("BEE_LLAMA_WATCHDOG_SYSTEMCTL_BIN", "systemctl"))
    parser.add_argument("--journalctl-bin", default=os.environ.get("BEE_LLAMA_WATCHDOG_JOURNALCTL_BIN", "journalctl"))
    parser.add_argument("--nvidia-smi-bin", default=os.environ.get("BEE_LLAMA_WATCHDOG_NVIDIA_SMI_BIN", "nvidia-smi"))
    parser.add_argument("--ps-bin", default=os.environ.get("BEE_LLAMA_WATCHDOG_PS_BIN", "ps"))
    arguments = parser.parse_args(argv)
    if arguments.interval_seconds <= 0 or arguments.threshold < 1 or arguments.http_timeout_seconds <= 0:
        parser.error("interval, threshold, and HTTP timeout must be positive")
    if arguments.restart_limit < 1 or arguments.restart_window_seconds <= 0:
        parser.error("restart limit and window must be positive")
    try:
        make_config(arguments)
    except ValueError as error:
        parser.error(str(error))
    return arguments


def main(argv: Iterable[str] | None = None) -> int:
    config = make_config(parse_arguments(argv))
    logger = EventLogger(config.state_dir)
    runner = default_runner

    def service_active() -> bool:
        return command_succeeded(runner, [config.systemctl_bin, "--user", "is-active", "--quiet", config.unit])

    def restart() -> bool:
        return command_succeeded(runner, [config.systemctl_bin, "--user", "restart", config.unit])

    capture = EvidenceCapture(config, runner, logger, time.time)
    watchdog = BeeLlamaWatchdog(
        config=config,
        service_active=service_active,
        json_fetcher=fetch_json,
        capture=capture.capture,
        restart=restart,
        restart_history=RestartHistory(config.state_dir / "restart-history.json", config.restart_limit, config.restart_window_seconds),
        logger=logger,
    )
    logger.write(f"starting; interval={config.interval_seconds:g}s threshold={config.threshold}")
    while True:
        watchdog.poll_once()
        time.sleep(config.interval_seconds)


if __name__ == "__main__":
    raise SystemExit(main())
