#!/usr/bin/env bash
# Verify the user session's Secret Service owner without listing or reading
# stored secrets.  The Ping intentionally activates the selected D-Bus service.
set -euo pipefail

fail() {
  echo "secret-service-provider: $*" >&2
  exit 1
}

command -v busctl >/dev/null || fail "busctl is required"

busctl --user call \
  org.freedesktop.secrets \
  /org/freedesktop/secrets \
  org.freedesktop.DBus.Peer \
  Ping >/dev/null || fail "org.freedesktop.secrets did not answer Ping"

status="$(busctl --user status org.freedesktop.secrets)" || fail "could not inspect Secret Service owner"
grep -Fqx 'Exe=/usr/bin/ksecretd' <<<"$status" \
  || fail "expected ksecretd to own org.freedesktop.secrets; inspect: busctl --user status org.freedesktop.secrets"

echo "PASS: ksecretd owns org.freedesktop.secrets"
