#!/bin/bash
# Disk cleanup checker - shows cleanup opportunities and (optionally) executes them.
#
# Safety model: preview-by-default, tiered Docker actions, per-category confirmation
# in --clean mode. Inspired by Docker's prune tiers, HuggingFace's scan-cache, and
# npkill's recency-aware UX. See inbox/2026-05-11-cleanup-prior-art.md.
#
# Cache: /tmp/.cleanup-cache-<uid>, 1h TTL, version-tagged on first line.

set -euo pipefail

CACHE_VERSION=6
# Injectable for tests, mirroring PROC_ROOT/CODE_ROOT/UV_CACHE_DIR below.
# Production always uses the real per-uid path.
CACHE_FILE="${CLEANUP_CACHE_FILE:-/tmp/.cleanup-cache-$(id -u)}"
CACHE_MAX_AGE=3600  # 1h — safety net only; state-changing actions (--clean,
                    # shell startup) refresh the cache proactively.
REFRESH_CACHE_AFTER_CLEANUP="${REFRESH_CACHE_AFTER_CLEANUP:-true}"
# Re-entrancy guard for `--clean`'s destructive action path (separate from
# ensure_cache's own flock single-flight on the read/probe path). flock
# releases automatically on process death (crash or SIGKILL — the kernel
# closes the fd), so unlike a PID file this can never wedge from an unclean
# exit. $XDG_RUNTIME_DIR is tmpfs, per-user, mode 700. Injectable for tests.
# See ai/research/shell-scripting/flock-not-pid-files-...
CLEANUP_LOCK_FILE="${CLEANUP_LOCK_FILE:-${XDG_RUNTIME_DIR:-/tmp}/.cleanup-clean-$(id -u).lock}"
SUDO_KEEPALIVE_PID=""
# Injectable for tests. Production always reads the kernel process table.
PROC_ROOT="${PROC_ROOT:-/proc}"
UV_CACHE_DIR="${UV_CACHE_DIR:-$HOME/.cache/uv}"

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

