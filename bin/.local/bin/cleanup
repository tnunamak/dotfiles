#!/bin/bash
# Disk cleanup checker - shows cleanup opportunities and (optionally) executes them.
#
# Safety model: preview-by-default, tiered Docker actions, per-category confirmation
# in --clean mode. Inspired by Docker's prune tiers, HuggingFace's scan-cache, and
# npkill's recency-aware UX. See inbox/2026-05-11-cleanup-prior-art.md.
#
# Cache: /tmp/.cleanup-cache-<uid>, 1h TTL, version-tagged on first line.

set -euo pipefail

CACHE_VERSION=6
CACHE_FILE="/tmp/.cleanup-cache-$(id -u)"
CACHE_MAX_AGE=3600  # 1h — safety net only; state-changing actions (--clean,
                    # shell startup) refresh the cache proactively.
REFRESH_CACHE_AFTER_CLEANUP="${REFRESH_CACHE_AFTER_CLEANUP:-true}"
SUDO_KEEPALIVE_PID=""

# Colors
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m'

# Thresholds (bytes)
THRESH_PIP=104857600        # 100M
THRESH_UV=1073741824        # 1G
THRESH_THUMBS=1073741824    # 1G
THRESH_HF=5368709120        # 5G
THRESH_DOCKER=1073741824    # 1G per tier
THRESH_NPM=524288000        # 500M
THRESH_CARGO=1073741824     # 1G
THRESH_YARN=524288000       # 500M
THRESH_CONDA=10737418240    # 10G (info only)
THRESH_DEVC=10737418240     # 10G (info only)
THRESH_STEAM=10737418240    # 10G (info only)
THRESH_GIT_BLOAT=1073741824 # 1G (info only)
THRESH_NEXT_CACHE=524288000 # 500M
THRESH_RUST_TARGET=2147483648 # 2G (tier-2 — expensive to rebuild)
THRESH_VENV=524288000       # 500M
THRESH_PNPM_STORE=1073741824 # 1G
THRESH_CLAUDE_CLI=104857600 # 100M
THRESH_GO_BUILD=209715200   # 200M
THRESH_DRKONQI=104857600    # 100M (KDE crash dumps)
THRESH_WRANGLER=104857600   # 100M
THRESH_PUPPETEER=536870912  # 512M (large; only flag if multiple Chrome versions cached)
THRESH_PLAYWRIGHT=1073741824 # 1G (stale browser builds + mcp-chrome hash sprawl)
THRESH_BROWSER_CACHE=524288000 # 500M (Brave/Chrome/Firefox/Google disk caches)
THRESH_GRADLE=1073741824    # 1G (Gradle caches/ — stops daemons, keeps wrapper/jdks)
THRESH_PIPENV=524288000     # 500M (pipenv download cache)
THRESH_NODE_GYP=209715200   # 200M (native-addon build headers)
THRESH_TORCH_EXT=209715200  # 200M (compiled PyTorch CUDA extensions)
THRESH_TSC_CACHE=104857600  # 100M (TypeScript compiler cache)
THRESH_BUN_CACHE=536870912  # 512M (bun install cache)
THRESH_SNAP_REVS=1073741824 # 1G (tier-2 — disabled snap revisions; needs sudo)
THRESH_ELIXIR_BUILD=524288000  # 500M (tier-2 — _build/; `mix compile` rebuilds, no network)
THRESH_ELIXIR_DEPS=524288000   # 500M (tier-2 — deps/; `mix deps.get` needs network)
THRESH_UNITY_LIBRARY=2147483648 # 2G (tier-2 — Library/; Unity reimports on reopen, slow)
THRESH_PYCACHE=52428800     # 50M (tier-1 — __pycache__/.pytest_cache/.mypy_cache/.ruff_cache; instant regen, numerous)

# Code roots to scan for build artifacts (.next, target, venv). Kept narrow to
# avoid trawling unrelated mounts. CODE_ROOT can be overridden via env for tests.
CODE_ROOT="${CODE_ROOT:-$HOME/code}"

# Categories that participate in --clean / --preview / --skip-X / --only-X.
# Keep in sync with documentation below and prompts in do_cleanup().
CATEGORIES=(
    node_modules
    next_cache
    pnpm_store
    pip_cache
    uv_cache
    npm_cache
    cargo_cache
    yarn_cache
    thumbnails
    hf_cache
    docker_containers
    docker_builder
    docker_dangling
    docker_images
    docker_volumes
    rust_target
    python_venvs
    elixir_build
    elixir_deps
    unity_library
    pycache
    claude_cli
    go_build
    drkonqi
    wrangler
    puppeteer
    playwright
    browser_caches
    gradle_cache
    pipenv_cache
    node_gyp
    torch_ext
    tsc_cache
    bun_cache
    snap_revs
)

human_size() {
    local bytes=${1:-0}
    if (( bytes >= 1073741824 )); then
        printf "%.1fG" "$(echo "scale=1; $bytes/1073741824" | bc)"
    elif (( bytes >= 1048576 )); then
        printf "%.0fM" "$(echo "scale=0; $bytes/1048576" | bc)"
    else
        printf "%.0fK" "$(echo "scale=0; $bytes/1024" | bc)"
    fi
}

# Playwright browser cache prune selection. Emits (newline-separated) the dirs
# under ~/.cache/ms-playwright that are SAFE to delete:
#   - versioned browsers (chromium-NNNN, chromium_headless_shell-NNNN): all but
#     the newest version per family (sort -V).
#   - mcp-chrome* hash-keyed builds (chromium-MCP downloads per @playwright/mcp
#     version): all but the most-recently-used (newest mtime), so the build the
#     live playwright-mcp service is using is preserved.
# Single source of truth shared by playwright_prunable_bytes() and the prune
# action, so the previewed size and the actual deletion can never diverge.
playwright_prune_dirs() {
    local root="$HOME/.cache/ms-playwright"
    [[ -d "$root" ]] || return 0
    local fam newest d v
    # Versioned browser families: keep newest version each.
    for fam in chromium chromium_headless_shell; do
        newest=$(ls -d "$root/${fam}-"* 2>/dev/null | sort -V | tail -1)
        [[ -n "$newest" ]] || continue
        for d in "$root/${fam}-"*; do
            [[ -d "$d" && "$d" != "$newest" ]] && echo "$d"
        done
    done
    # mcp-* hash-keyed browser builds (mcp-chrome-HASH, mcp-chromium-HASH,
    # mcp-chrome-for-testing-HASH): keep the single most-recently-used build
    # (the one the live playwright-mcp service is on), prune the rest. NEVER
    # touch *-profile dirs — those hold browser session/cookie state, not a
    # re-downloadable browser. The bare "mcp-chrome" dir (no hash) is also a
    # build and prunable.
    local builds=()
    for d in "$root/mcp-chrome" "$root/mcp-chrome-"* "$root/mcp-chromium-"*; do
        [[ -d "$d" ]] || continue
        [[ "$d" == *-profile ]] && continue
        builds+=("$d")
    done
    if (( ${#builds[@]} > 0 )); then
        newest=$(ls -dt "${builds[@]}" 2>/dev/null | head -1)
        for d in "${builds[@]}"; do
            [[ "$d" != "$newest" ]] && echo "$d"
        done
    fi
}

# Sum bytes of the prunable Playwright dirs (0 if none / dir absent).
playwright_prunable_bytes() {
    local total=0 d sz
    while IFS= read -r d; do
        [[ -n "$d" ]] || continue
        sz=$(du -sbx "$d" 2>/dev/null | cut -f1)
        total=$(( total + ${sz:-0} ))
    done < <(playwright_prune_dirs)
    echo "$total"
}

# Render age of a file as "Xs/Xm/Xh/Xd ago", or "" if file missing.
file_age_human() {
    local path=$1
    [[ -f "$path" ]] || { echo ""; return; }
    local mtime now age
    mtime=$(stat -c %Y "$path" 2>/dev/null || echo 0)
    now=$(date +%s)
    age=$(( now - mtime ))
    if   (( age < 60 ));    then echo "${age}s ago"
    elif (( age < 3600 ));  then echo "$((age/60))m ago"
    elif (( age < 86400 )); then echo "$((age/3600))h ago"
    else echo "$((age/86400))d ago"
    fi
}

# Parse "1.234GB" / "456MB" / "789kB" / "0B" -> bytes (integer).
docker_size_to_bytes() {
    local s="${1:-0B}"
    # Strip whitespace
    s="${s// /}"
    # Extract numeric part and unit
    local num unit
    num=$(echo "$s" | grep -oE '^[0-9.]+' || echo "0")
    unit=$(echo "$s" | grep -oE '[A-Za-z]+$' || echo "B")
    local mult=1
    case "$unit" in
        B)  mult=1 ;;
        kB|KB|K) mult=1000 ;;
        MB|M)    mult=1000000 ;;
        GB|G)    mult=1000000000 ;;
        TB|T)    mult=1000000000000 ;;
        KiB)     mult=1024 ;;
        MiB)     mult=1048576 ;;
        GiB)     mult=1073741824 ;;
        TiB)     mult=1099511627776 ;;
    esac
    awk -v n="$num" -v m="$mult" 'BEGIN { printf "%.0f\n", n * m }'
}

# Examine a single node_modules path: classify stale/active using the newest
# source-file mtime inside its parent project. Prints the path (NUL-terminated)
# to stdout iff it qualifies as stale.
#
# Args: <node_modules_path> <active_thresh_epoch> <stale_thresh_epoch>
classify_node_modules() {
    local nm="$1" active_thresh="$2" stale_thresh="$3"
    local project
    project=$(dirname "$nm")
    local newest
    newest=$({ find "$project" \
        -path "$nm" -prune -o \
        -path "$project/.git" -prune -o \
        -type f \( -name '*.js' -o -name '*.ts' -o -name '*.jsx' -o -name '*.tsx' \
                  -o -name '*.json' -o -name '*.md' -o -name '*.py' -o -name '*.rs' \
                  -o -name '*.go' -o -name '*.rb' -o -name '*.sh' \) \
        -printf '%T@\n' 2>/dev/null; } | sort -nr 2>/dev/null | head -1 | cut -d. -f1)
    if [[ -z "$newest" || "$newest" == "0" ]]; then
        newest=$(stat -c %Y "$nm" 2>/dev/null || echo 0)
    fi
    if (( newest > active_thresh )); then
        return 0  # active project; skip
    fi
    if (( newest < stale_thresh )); then
        printf '%s\0' "$nm"
    fi
}

# Find old project node_modules using inner-file mtime (not just dir mtime).
# Active = newest source file under the parent project is <30d old.
# Stale  = newest source file is >180d old.
# Outputs NUL-terminated paths.
#
# Parallelism: each candidate parent project is classified concurrently, bounded
# by $((nproc * 2)) to avoid fork-storms on machines with hundreds of projects.
find_stale_node_modules() {
    local now_s
    now_s=$(date +%s)
    local stale_thresh=$((now_s - 180*86400))
    local active_thresh=$((now_s - 30*86400))

    # Cap in-flight to prevent fork-storms; 4*nproc is generous since each task
    # is mostly I/O wait on a recursive find walking source files.
    local max_jobs
    max_jobs=$(( $(nproc 2>/dev/null || echo 4) * 4 ))
    (( max_jobs < 8 )) && max_jobs=8

    local tmp
    tmp=$(mktemp -d)
    local i=0 inflight=0
    while IFS= read -r -d '' nm; do
        classify_node_modules "$nm" "$active_thresh" "$stale_thresh" \
            > "$tmp/nm-$i" 2>/dev/null &
        i=$((i+1))
        inflight=$((inflight+1))
        # Throttle: when in-flight jobs hit cap, wait for any to finish.
        if (( inflight >= max_jobs )); then
            wait -n 2>/dev/null || true
            inflight=$((inflight-1))
        fi
    done < <(find "$CODE_ROOT" -maxdepth 5 -name node_modules -type d -prune -print0 2>/dev/null)
    wait 2>/dev/null || true

    # Concatenate NUL-separated outputs in stable order.
    for ((j=0; j<i; j++)); do
        [[ -s "$tmp/nm-$j" ]] && cat "$tmp/nm-$j"
    done
    rm -rf "$tmp"
}

# Compute the on-disk size of a list of NUL-separated paths.
sum_size_null() {
    local total=0 path size
    while IFS= read -r -d '' path; do
        size=$(du -sb "$path" 2>/dev/null | cut -f1 || echo 0)
        total=$((total + size))
    done
    echo "$total"
}

# Probe Docker sizes per tier without running any deletions.
# Outputs five lines:
#   containers_bytes
#   builder_bytes
#   images_bytes
#   volumes_bytes
#   dangling_images_bytes  (subset of images; tier-1 safe)
docker_tier_sizes() {
    local containers=0 builder=0 images=0 volumes=0 dangling=0
    if ! command -v docker &>/dev/null; then
        echo "0"; echo "0"; echo "0"; echo "0"; echo "0"; return
    fi
    if ! docker info &>/dev/null; then
        echo "0"; echo "0"; echo "0"; echo "0"; echo "0"; return
    fi

    # `docker system df` is fast and authoritative for reclaimable space.
    # Columns vary by Docker version; use --format with explicit fields.
    # Type | Total | Active | Size | Reclaimable
    local df_out
    df_out=$(docker system df --format '{{.Type}}|{{.Reclaimable}}' 2>/dev/null || true)

    while IFS='|' read -r type reclaim; do
        # Reclaim looks like "1.234GB (45%)" — strip the percentage.
        local r
        r=$(echo "$reclaim" | sed -E 's/[[:space:]]*\([^)]*\)//')
        local b
        b=$(docker_size_to_bytes "$r")
        case "$type" in
            "Images"|"images")            images=$b ;;
            "Containers"|"containers")    containers=$b ;;
            "Local Volumes"|"local volumes"|"Local volumes") volumes=$b ;;
            "Build Cache"|"build cache")  builder=$b ;;
        esac
    done <<< "$df_out"

    # Dangling images are tier-1 safe to prune, but their reported size is
    # unreliable (per-image totals double-count shared layers). Count only the
    # number of dangling images; size is shown as "n/a".
    local dangling_count
    dangling_count=$(docker images --filter dangling=true --quiet 2>/dev/null | wc -l)
    dangling=$dangling_count  # repurpose: store COUNT, not bytes

    echo "$containers"
    echo "$builder"
    echo "$images"
    echo "$volumes"
    echo "$dangling"
}

# Sum the size of one path. Args: <path>. Prints bytes, or "0" on missing.
probe_du_path() {
    local p="$1"
    [[ -e "$p" ]] || { echo 0; return; }
    du -sb "$p" 2>/dev/null | cut -f1 || echo 0
}

# Probe the total size of stale node_modules and emit "count|bytes".
# du -sb on each stale path runs in parallel (most paths are 50-500 MB each,
# I/O-bound, and there are 100+ of them on a typical dev machine).
probe_node_modules_total() {
    local paths=()
    while IFS= read -r -d '' p; do
        [[ -z "$p" ]] && continue
        paths+=("$p")
    done < <(find_stale_node_modules)

    if (( ${#paths[@]} == 0 )); then
        echo "0|0"
        return
    fi

    # Fan out du -sb across cores; xargs -P collects sizes in bulk.
    local total
    total=$(printf '%s\0' "${paths[@]}" \
        | xargs -0 -n 32 -P "$(nproc 2>/dev/null || echo 4)" du -sb 2>/dev/null \
        | awk '{s+=$1} END {print s+0}')
    : "${total:=0}"
    echo "${#paths[@]}|${total}"
}

# Probe disabled (superseded) snap revisions and emit "count|bytes".
# snapd keeps a configurable number of old revisions per snap (refresh.retain,
# min 2) for one-step `snap revert`. The ones flagged "disabled" are the prior
# revisions; each maps to a squashfs blob under /var/lib/snapd/snaps/. Removing
# them is tier-2 (not a regenerable cache: it drops rollback capability, and
# removal needs sudo). No-op on machines without snapd.
probe_snap_revs() {
    command -v snap >/dev/null 2>&1 || { echo "0|0"; return; }
    local count=0 total=0 name rev blob sz
    while read -r name rev; do
        [[ -z "$name" ]] && continue
        blob="/var/lib/snapd/snaps/${name}_${rev}.snap"
        if [[ -f "$blob" ]]; then
            sz=$(stat -c %s "$blob" 2>/dev/null || echo 0)
            total=$((total + sz))
            count=$((count + 1))
        fi
    done < <(snap list --all 2>/dev/null | awk '$NF ~ /disabled/ {print $1, $3}')
    echo "${count}|${total}"
}

# Sum sizes of dirs matching a name under CODE_ROOT. Args: <name> [<name>...].
# Prunes at each match (don't descend into them). Used for per-package caches
# (__pycache__ et al.) which nest at every package level, so it walks deeper
# than the depth-5 project-level probes — NESTED_ARTIFACT_MAXDEPTH (default 8,
# env-overridable for tests). Emits "count|bytes".
NESTED_ARTIFACT_MAXDEPTH="${NESTED_ARTIFACT_MAXDEPTH:-8}"
probe_named_dirs_total() {
    local names=("$@")
    local find_args=()
    local n
    for n in "${names[@]}"; do
        find_args+=( -name "$n" -o )
    done
    # Trim trailing -o
    unset 'find_args[${#find_args[@]}-1]'

    local paths=()
    while IFS= read -r -d '' p; do
        [[ -z "$p" ]] && continue
        paths+=("$p")
    done < <(find "$CODE_ROOT" -maxdepth "$NESTED_ARTIFACT_MAXDEPTH" -type d \( "${find_args[@]}" \) -prune -print0 2>/dev/null)

    if (( ${#paths[@]} == 0 )); then
        echo "0|0"
        return
    fi
    local total
    total=$(printf '%s\0' "${paths[@]}" \
        | xargs -0 -n 32 -P "$(nproc 2>/dev/null || echo 4)" du -sb 2>/dev/null \
        | awk '{s+=$1} END {print s+0}')
    : "${total:=0}"
    echo "${#paths[@]}|${total}"
}

# Probe .next/cache/ totals under CODE_ROOT. The build output (.next/) is needed
# at runtime for `next start`; only .next/cache/ is safely regenerable.
probe_next_cache_total() {
    local paths=()
    while IFS= read -r -d '' p; do
        [[ -z "$p" ]] && continue
        # Only count if .next/cache exists
        [[ -d "$p/cache" ]] || continue
        paths+=("$p/cache")
    done < <(find "$CODE_ROOT" -maxdepth 5 -type d -name .next -prune -print0 2>/dev/null)

    if (( ${#paths[@]} == 0 )); then
        echo "0|0"
        return
    fi
    local total
    total=$(printf '%s\0' "${paths[@]}" \
        | xargs -0 -n 32 -P "$(nproc 2>/dev/null || echo 4)" du -sb 2>/dev/null \
        | awk '{s+=$1} END {print s+0}')
    : "${total:=0}"
    echo "${#paths[@]}|${total}"
}

# Probe rust target/ dirs under CODE_ROOT. Validated by sibling Cargo.toml to
# avoid eating unrelated "target" dirs (Maven, etc.). Emits "count|bytes".
probe_rust_target_total() {
    local paths=()
    while IFS= read -r -d '' p; do
        [[ -z "$p" ]] && continue
        local parent
        parent=$(dirname "$p")
        # Require a Cargo.toml next to target/, else skip.
        [[ -f "$parent/Cargo.toml" ]] || continue
        paths+=("$p")
    done < <(find "$CODE_ROOT" -maxdepth 5 -type d -name target -prune -print0 2>/dev/null)

    if (( ${#paths[@]} == 0 )); then
        echo "0|0"
        return
    fi
    local total
    total=$(printf '%s\0' "${paths[@]}" \
        | xargs -0 -n 32 -P "$(nproc 2>/dev/null || echo 4)" du -sb 2>/dev/null \
        | awk '{s+=$1} END {print s+0}')
    : "${total:=0}"
    echo "${#paths[@]}|${total}"
}

# Classify a single venv: stale iff parent project has no source-file edit in
# the last 90 days. Emits NUL-terminated paths to stdout iff stale.
#
# Args: <venv_path> <stale_thresh_epoch>
classify_venv() {
    local venv="$1" stale_thresh="$2"
    local project
    project=$(dirname "$venv")
    local newest
    newest=$({ find "$project" \
        -path "$venv" -prune -o \
        -path "$project/.git" -prune -o \
        -path "$project/node_modules" -prune -o \
        -type f \( -name '*.py' -o -name '*.toml' -o -name '*.txt' \
                  -o -name '*.ipynb' -o -name '*.md' \) \
        -printf '%T@\n' 2>/dev/null; } | sort -nr 2>/dev/null | head -1 | cut -d. -f1)
    if [[ -z "$newest" || "$newest" == "0" ]]; then
        newest=$(stat -c %Y "$venv" 2>/dev/null || echo 0)
    fi
    if (( newest < stale_thresh )); then
        printf '%s\0' "$venv"
    fi
}

# Find stale .venv/venv under CODE_ROOT (parent inactive >90d). Outputs NUL-
# terminated paths. Mirrors find_stale_node_modules but with a tighter threshold
# since Python venvs are cheaper to recreate.
find_stale_venvs() {
    local now_s
    now_s=$(date +%s)
    local stale_thresh=$((now_s - 90*86400))

    local max_jobs
    max_jobs=$(( $(nproc 2>/dev/null || echo 4) * 4 ))
    (( max_jobs < 8 )) && max_jobs=8

    local tmp
    tmp=$(mktemp -d)
    local i=0 inflight=0
    while IFS= read -r -d '' v; do
        classify_venv "$v" "$stale_thresh" \
            > "$tmp/v-$i" 2>/dev/null &
        i=$((i+1))
        inflight=$((inflight+1))
        if (( inflight >= max_jobs )); then
            wait -n 2>/dev/null || true
            inflight=$((inflight-1))
        fi
    # Discover by the pyvenv.cfg marker (present in every venv regardless of
    # dir name) — name-based matching missed e.g. rdatadao-shitposting/env (5.4G).
    done < <(find "$CODE_ROOT" -maxdepth 6 -name pyvenv.cfg -printf '%h\0' 2>/dev/null)
    wait 2>/dev/null || true

    for ((j=0; j<i; j++)); do
        [[ -s "$tmp/v-$j" ]] && cat "$tmp/v-$j"
    done
    rm -rf "$tmp"
}

# Probe stale venvs total. Emits "count|bytes".
probe_python_venvs_total() {
    local paths=()
    while IFS= read -r -d '' p; do
        [[ -z "$p" ]] && continue
        paths+=("$p")
    done < <(find_stale_venvs)

    if (( ${#paths[@]} == 0 )); then
        echo "0|0"
        return
    fi
    local total
    total=$(printf '%s\0' "${paths[@]}" \
        | xargs -0 -n 32 -P "$(nproc 2>/dev/null || echo 4)" du -sb 2>/dev/null \
        | awk '{s+=$1} END {print s+0}')
    : "${total:=0}"
    echo "${#paths[@]}|${total}"
}

# Classify a single project-level build artifact (e.g. _build/, deps/, Library/)
# as stale, mirroring classify_venv: stale iff the parent project has no relevant
# source edit since the threshold. This is the active-project spare guard required
# for every artifact type — a project edited recently keeps its artifacts.
#
# Args: <artifact_path> <stale_thresh_epoch>. Every project file counts as
# activity: destructive cleanup must prefer a false negative over deleting an
# artifact after an edit whose file type was missing from an allowlist. The
# known generated artifact roots, .git, and node_modules are pruned from the
# walk so one freshly generated sibling cannot make another look active.
classify_project_artifact() {
    local artifact="$1" stale_thresh="$2"
    local project
    project=$(dirname "$artifact")
    local newest
    newest=$({ find "$project" \
        -path "$artifact" -prune -o \
        -path "$project/_build" -prune -o \
        -path "$project/deps" -prune -o \
        -path "$project/Library" -prune -o \
        -path "$project/.git" -prune -o \
        -path "$project/node_modules" -prune -o \
        -type f \
        -printf '%T@\n' 2>/dev/null; } | sort -nr 2>/dev/null | head -1 | cut -d. -f1)
    if [[ -z "$newest" || "$newest" == "0" ]]; then
        newest=$(stat -c %Y "$artifact" 2>/dev/null || echo 0)
    fi
    if (( newest < stale_thresh )); then
        printf '%s\0' "$artifact"
    fi
}

# Find stale project-level artifacts under CODE_ROOT, validated by a sibling
# manifest so we never eat an unrelated dir of the same name. Mirrors
# find_stale_venvs (90d staleness, bounded parallel classification).
#
# Args:
#   $1 = artifact dir name (e.g. _build, deps, Library)
#   $2 = manifest predicate: a function name taking <project_dir>, returns 0 if
#        the sibling manifest validates this as the expected project type
# Outputs NUL-terminated stale artifact paths.
find_stale_project_artifacts() {
    local art_name="$1" manifest_fn="$2"
    local now_s
    now_s=$(date +%s)
    local stale_thresh=$((now_s - 90*86400))

    local max_jobs
    max_jobs=$(( $(nproc 2>/dev/null || echo 4) * 4 ))
    (( max_jobs < 8 )) && max_jobs=8

    local tmp
    tmp=$(mktemp -d)
    local i=0 inflight=0 parent
    while IFS= read -r -d '' a; do
        parent=$(dirname "$a")
        # Sibling-manifest validation: skip dirs that aren't the project type.
        "$manifest_fn" "$parent" || continue
        classify_project_artifact "$a" "$stale_thresh" \
            > "$tmp/a-$i" 2>/dev/null &
        i=$((i+1))
        inflight=$((inflight+1))
        if (( inflight >= max_jobs )); then
            wait -n 2>/dev/null || true
            inflight=$((inflight-1))
        fi
    done < <(find "$CODE_ROOT" -maxdepth 5 -type d -name "$art_name" -prune -print0 2>/dev/null)
    wait 2>/dev/null || true

    for ((j=0; j<i; j++)); do
        [[ -s "$tmp/a-$j" ]] && cat "$tmp/a-$j"
    done
    rm -rf "$tmp"
}

# Sum the on-disk size of NUL-separated artifact paths. Emits "count|bytes".
# Shared tail for the project-artifact probes below.
_sum_artifact_paths() {
    local paths=()
    local p
    while IFS= read -r -d '' p; do
        [[ -z "$p" ]] && continue
        paths+=("$p")
    done
    if (( ${#paths[@]} == 0 )); then
        echo "0|0"
        return
    fi
    local total
    total=$(printf '%s\0' "${paths[@]}" \
        | xargs -0 -n 32 -P "$(nproc 2>/dev/null || echo 4)" du -sb 2>/dev/null \
        | awk '{s+=$1} END {print s+0}')
    : "${total:=0}"
    echo "${#paths[@]}|${total}"
}

# Manifest predicates for sibling validation.
_is_elixir_project() { [[ -f "$1/mix.exs" ]]; }
_is_unity_project()  { [[ -d "$1/Assets" && -d "$1/ProjectSettings" ]]; }

# Probe stale Elixir _build/ dirs (sibling mix.exs; parent inactive >90d).
# tier-2: `mix compile` rebuilds locally (no network) but a large umbrella
# (e.g. Blockscout) is not instant. Emits "count|bytes".
probe_elixir_build_total() {
    find_stale_project_artifacts _build _is_elixir_project | _sum_artifact_paths
}

# Probe stale Elixir deps/ dirs (sibling mix.exs; parent inactive >90d).
# tier-2: `mix deps.get` needs network. Emits "count|bytes".
probe_elixir_deps_total() {
    find_stale_project_artifacts deps _is_elixir_project | _sum_artifact_paths
}

# Probe stale Unity Library/ dirs (sibling Assets/ + ProjectSettings/; parent
# inactive >90d). tier-2: Unity reimports the whole asset DB on reopen — slow
# for a 10G+ project. Emits "count|bytes".
probe_unity_library_total() {
    find_stale_project_artifacts Library _is_unity_project | _sum_artifact_paths
}

# Probe Python bytecode/test/lint caches under CODE_ROOT. tier-1: each is
# trivially regenerable on next run, tiny individually but numerous (1000s of
# __pycache__ on a Python-heavy machine). Dir names are unambiguous and never
# hold user data, so no sibling-manifest validation is needed. Not recency-
# gated for the same reason .next/cache isn't — regen is instant and per-run.
# Emits "count|bytes".
probe_pycache_total() {
    probe_named_dirs_total __pycache__ .pytest_cache .mypy_cache .ruff_cache
}

# Probe the pnpm content-addressed store. Located via `pnpm config get store-dir`,
# falling back to CODE_ROOT/.pnpm-store (the layout dotfiles uses). Probe is a
# size check only — actual prune happens via `pnpm store prune`.
probe_pnpm_store() {
    local store_dir=""
    if command -v pnpm &>/dev/null; then
        store_dir=$(pnpm config get store-dir 2>/dev/null | { grep -v '^undefined$' || true; } | head -1)
    fi
    if [[ -z "$store_dir" || ! -d "$store_dir" ]]; then
        # Try the project-local store layout (pnpm with `store-dir=.pnpm-store`).
        if [[ -d "$CODE_ROOT/.pnpm-store" ]]; then
            store_dir="$CODE_ROOT/.pnpm-store"
        else
            echo "0"
            return
        fi
    fi
    probe_du_path "$store_dir"
}

# Probe git bloat under ~/code. Emits zero or more "repo_name:size" lines.
probe_git_bloat() {
    local raw
    raw=$(find ~/code -maxdepth 2 -name ".git" -type d -exec du -sb {} \; 2>/dev/null \
        | awk -v t="$THRESH_GIT_BLOAT" '$1 > t {print $2 ":" $1}' || true)
    [[ -z "$raw" ]] && return 0
    while IFS=: read -r path size; do
        [[ -z "$path" ]] && continue
        local repo_name
        repo_name=$(basename "$(dirname "$path")")
        echo "${repo_name}:${size}"
    done <<< "$raw"
}

# Probe the Windows mount (skip if unmounted). Emits "<pct>:<avail>" iff >85% full.
probe_windows() {
    mountpoint -q /media/windows 2>/dev/null || return 0
    local win_pct win_avail
    win_pct=$(df /media/windows | tail -1 | awk '{print $5}' | tr -d '%')
    win_avail=$(df -B1 /media/windows | tail -1 | awk '{print $4}')
    if (( win_pct > 85 )); then
        echo "${win_pct}:${win_avail}"
    fi
}

# Build the cache file. Format:
#   line 1: cache version
#   line 2: disk_pct
#   line 3: total_cleanable_bytes  (tier-1 safe sum)
#   lines: <type>:<count>:<bytes>
#   line:  ---
#   lines: <type>:<val>:<size>  (info-only)
#
# Implementation: every independent probe runs in a backgrounded subshell that
# writes its result to "$TMPDIR_PARALLEL/<key>". The main shell waits for all
# children, then reads the files back in a deterministic order so the cache
# output is byte-stable across runs.
check_cleanup() {
    local TMPDIR_PARALLEL
    TMPDIR_PARALLEL=$(mktemp -d)
    # Ensure tmpdir is cleaned up even on signal or errexit.
    trap 'rm -rf "$TMPDIR_PARALLEL"; [[ -n "$SUDO_KEEPALIVE_PID" ]] && kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT

    local disk_pct
    disk_pct=$(df / | tail -1 | awk '{print $5}' | tr -d '%')

    local pids=()

    # --- du -sb probes for individual cache paths ---
    # Each probe writes a single integer to "$TMPDIR_PARALLEL/du-<key>".
    local du_probes=(
        "pip_cache:$HOME/.cache/pip"
        "uv_cache:$HOME/.cache/uv"
        "npm_cache:$HOME/.npm"
        "cargo_cache:$HOME/.cargo/registry"
        "yarn_cache:$HOME/.yarn/cache"
        "thumbnails:$HOME/.cache/thumbnails"
        "hf_cache:$HOME/.cache/huggingface"
        "conda:$HOME/miniconda3"
        "devcontainer_homes:$HOME/.devcontainer-homes"
        "steam:$HOME/.steam"
        "claude_cli:$HOME/.cache/claude-cli-nodejs"
        "go_build:$HOME/.cache/go-build"
        "drkonqi:$HOME/.cache/drkonqi"
        "wrangler:$HOME/.cache/.wrangler"
        "puppeteer:$HOME/.cache/puppeteer"
        "playwright:$HOME/.cache/ms-playwright"
        "browser_brave:$HOME/.cache/BraveSoftware"
        "browser_chrome:$HOME/.cache/google-chrome"
        "browser_firefox:$HOME/.cache/mozilla"
        "browser_google:$HOME/.cache/Google"
        "gradle_cache:$HOME/.gradle/caches"
        "pipenv_cache:$HOME/.cache/pipenv"
        "node_gyp:$HOME/.cache/node-gyp"
        "torch_ext:$HOME/.cache/torch_extensions"
        "tsc_cache:$HOME/.cache/typescript"
        "bun_cache:$HOME/.bun/install/cache"
    )
    local entry key path
    for entry in "${du_probes[@]}"; do
        key="${entry%%:*}"
        path="${entry#*:}"
        ( probe_du_path "$path" > "$TMPDIR_PARALLEL/du-$key" 2>/dev/null ) &
        pids+=($!)
    done

    # --- node_modules (recency-aware; itself uses internal parallelism) ---
    ( probe_node_modules_total > "$TMPDIR_PARALLEL/node_modules" 2>/dev/null ) &
    pids+=($!)

    # --- .next/cache/ across CODE_ROOT (tier-1: regenerable) ---
    ( probe_next_cache_total > "$TMPDIR_PARALLEL/next_cache" 2>/dev/null ) &
    pids+=($!)

    # --- Rust target/ across CODE_ROOT (tier-2: expensive to rebuild) ---
    ( probe_rust_target_total > "$TMPDIR_PARALLEL/rust_target" 2>/dev/null ) &
    pids+=($!)

    # --- Stale Python venvs across CODE_ROOT (tier-2: recency-aware) ---
    ( probe_python_venvs_total > "$TMPDIR_PARALLEL/python_venvs" 2>/dev/null ) &
    pids+=($!)

    # --- Stale Elixir _build/ + deps/ (tier-2: recency-aware, sibling mix.exs) ---
    ( probe_elixir_build_total > "$TMPDIR_PARALLEL/elixir_build" 2>/dev/null ) &
    pids+=($!)
    ( probe_elixir_deps_total > "$TMPDIR_PARALLEL/elixir_deps" 2>/dev/null ) &
    pids+=($!)

    # --- Stale Unity Library/ (tier-2: recency-aware, sibling Assets/+ProjectSettings/) ---
    ( probe_unity_library_total > "$TMPDIR_PARALLEL/unity_library" 2>/dev/null ) &
    pids+=($!)

    # --- Python __pycache__/.pytest_cache/.mypy_cache/.ruff_cache (tier-1) ---
    ( probe_pycache_total > "$TMPDIR_PARALLEL/pycache" 2>/dev/null ) &
    pids+=($!)

    # --- pnpm content-addressed store ---
    ( probe_pnpm_store > "$TMPDIR_PARALLEL/pnpm_store" 2>/dev/null ) &
    pids+=($!)

    # --- disabled snap revisions (tier-2) ---
    ( probe_snap_revs > "$TMPDIR_PARALLEL/snap_revs" 2>/dev/null ) &
    pids+=($!)

    # --- Docker probes ---
    ( docker_tier_sizes > "$TMPDIR_PARALLEL/docker" 2>/dev/null ) &
    pids+=($!)

    # --- git bloat scan under ~/code ---
    ( probe_git_bloat > "$TMPDIR_PARALLEL/git_bloat" 2>/dev/null ) &
    pids+=($!)

    # --- Windows partition ---
    ( probe_windows > "$TMPDIR_PARALLEL/windows" 2>/dev/null ) &
    pids+=($!)

    # Wait for every backgrounded probe to finish.
    local pid
    for pid in "${pids[@]}"; do
        wait "$pid" 2>/dev/null || true
    done

    # ------------------------------------------------------------------------
    # Aggregate. Iteration order below defines the cache line order — keep it
    # stable so cached output stays byte-identical across runs.
    # ------------------------------------------------------------------------

    local total_cleanable=0
    local items=()
    local info_items=()

    # node_modules
    local nm_raw nm_count nm_size
    nm_raw=$(cat "$TMPDIR_PARALLEL/node_modules" 2>/dev/null || echo "0|0")
    nm_count="${nm_raw%%|*}"
    nm_size="${nm_raw#*|}"
    : "${nm_count:=0}" "${nm_size:=0}"
    if (( nm_count > 0 )); then
        items+=("node_modules:$nm_count:$nm_size")
        total_cleanable=$((total_cleanable + nm_size))
    fi

    # next_cache — .next/cache/ dirs (tier-1, always safe; regenerable)
    local nc_raw nc_count nc_size
    nc_raw=$(cat "$TMPDIR_PARALLEL/next_cache" 2>/dev/null || echo "0|0")
    nc_count="${nc_raw%%|*}"
    nc_size="${nc_raw#*|}"
    : "${nc_count:=0}" "${nc_size:=0}"
    if (( nc_size > THRESH_NEXT_CACHE )); then
        items+=("next_cache:$nc_count:$nc_size")
        total_cleanable=$((total_cleanable + nc_size))
    fi

    # rust_target — tier-2: don't add to tier-1 total
    local rt_raw rt_count rt_size
    rt_raw=$(cat "$TMPDIR_PARALLEL/rust_target" 2>/dev/null || echo "0|0")
    rt_count="${rt_raw%%|*}"
    rt_size="${rt_raw#*|}"
    : "${rt_count:=0}" "${rt_size:=0}"
    if (( rt_size > THRESH_RUST_TARGET )); then
        items+=("rust_target:$rt_count:$rt_size")
    fi

    # python_venvs — tier-2: stale venvs (parent inactive >90d); don't add to tier-1
    local pv_raw pv_count pv_size
    pv_raw=$(cat "$TMPDIR_PARALLEL/python_venvs" 2>/dev/null || echo "0|0")
    pv_count="${pv_raw%%|*}"
    pv_size="${pv_raw#*|}"
    : "${pv_count:=0}" "${pv_size:=0}"
    if (( pv_size > THRESH_VENV )); then
        items+=("python_venvs:$pv_count:$pv_size")
    fi

    # elixir_build — tier-2: stale _build/ (sibling mix.exs, parent inactive >90d)
    local eb_raw eb_count eb_size
    eb_raw=$(cat "$TMPDIR_PARALLEL/elixir_build" 2>/dev/null || echo "0|0")
    eb_count="${eb_raw%%|*}"
    eb_size="${eb_raw#*|}"
    : "${eb_count:=0}" "${eb_size:=0}"
    if (( eb_size > THRESH_ELIXIR_BUILD )); then
        items+=("elixir_build:$eb_count:$eb_size")
    fi

    # elixir_deps — tier-2: stale deps/ (sibling mix.exs, parent inactive >90d; network refetch)
    local ed_raw ed_count ed_size
    ed_raw=$(cat "$TMPDIR_PARALLEL/elixir_deps" 2>/dev/null || echo "0|0")
    ed_count="${ed_raw%%|*}"
    ed_size="${ed_raw#*|}"
    : "${ed_count:=0}" "${ed_size:=0}"
    if (( ed_size > THRESH_ELIXIR_DEPS )); then
        items+=("elixir_deps:$ed_count:$ed_size")
    fi

    # unity_library — tier-2: stale Library/ (sibling Assets/+ProjectSettings/, parent inactive >90d)
    local ul_raw ul_count ul_size
    ul_raw=$(cat "$TMPDIR_PARALLEL/unity_library" 2>/dev/null || echo "0|0")
    ul_count="${ul_raw%%|*}"
    ul_size="${ul_raw#*|}"
    : "${ul_count:=0}" "${ul_size:=0}"
    if (( ul_size > THRESH_UNITY_LIBRARY )); then
        items+=("unity_library:$ul_count:$ul_size")
    fi

    # pycache — tier-1: Python bytecode/test/lint caches; instant regen, safe.
    local pc_raw pc_count pc_size
    pc_raw=$(cat "$TMPDIR_PARALLEL/pycache" 2>/dev/null || echo "0|0")
    pc_count="${pc_raw%%|*}"
    pc_size="${pc_raw#*|}"
    : "${pc_count:=0}" "${pc_size:=0}"
    if (( pc_size > THRESH_PYCACHE )); then
        items+=("pycache:$pc_count:$pc_size")
        total_cleanable=$((total_cleanable + pc_size))
    fi

    # snap_revs — tier-2: disabled revisions (drops rollback; sudo); don't add to tier-1
    local sr_raw sr_count sr_size
    sr_raw=$(cat "$TMPDIR_PARALLEL/snap_revs" 2>/dev/null || echo "0|0")
    sr_count="${sr_raw%%|*}"
    sr_size="${sr_raw#*|}"
    : "${sr_count:=0}" "${sr_size:=0}"
    if (( sr_size > THRESH_SNAP_REVS )); then
        items+=("snap_revs:$sr_count:$sr_size")
    fi

    # pnpm_store — tier-1: `pnpm store prune` is a safe, store-aware operation.
    # The probe gives current size; actual freed bytes after prune may be less.
    local pnpm_size
    pnpm_size=$(cat "$TMPDIR_PARALLEL/pnpm_store" 2>/dev/null || echo 0)
    : "${pnpm_size:=0}"
    if (( pnpm_size > THRESH_PNPM_STORE )); then
        # Pass current size as the estimate; actual freed = unreferenced subset.
        items+=("pnpm_store:1:$pnpm_size")
        # Don't add to total_cleanable — prune typically frees a fraction.
    fi

    # Helper: read a du-* value with a 0 default.
    _du() { cat "$TMPDIR_PARALLEL/du-$1" 2>/dev/null || echo 0; }

    local pip_cache uv_cache npm_cache cargo_cache yarn_cache thumb_cache hf_cache
    pip_cache=$(_du pip_cache)
    uv_cache=$(_du uv_cache)
    npm_cache=$(_du npm_cache)
    cargo_cache=$(_du cargo_cache)
    yarn_cache=$(_du yarn_cache)
    thumb_cache=$(_du thumbnails)
    hf_cache=$(_du hf_cache)
    : "${pip_cache:=0}" "${uv_cache:=0}" "${npm_cache:=0}" "${cargo_cache:=0}"
    : "${yarn_cache:=0}" "${thumb_cache:=0}" "${hf_cache:=0}"

    if (( pip_cache > THRESH_PIP )); then
        items+=("pip_cache:1:$pip_cache")
        total_cleanable=$((total_cleanable + pip_cache))
    fi
    if (( uv_cache > THRESH_UV )); then
        items+=("uv_cache:1:$uv_cache")
        total_cleanable=$((total_cleanable + uv_cache))
    fi
    if (( npm_cache > THRESH_NPM )); then
        items+=("npm_cache:1:$npm_cache")
        total_cleanable=$((total_cleanable + npm_cache))
    fi
    if (( cargo_cache > THRESH_CARGO )); then
        items+=("cargo_cache:1:$cargo_cache")
        total_cleanable=$((total_cleanable + cargo_cache))
    fi
    if (( yarn_cache > THRESH_YARN )); then
        items+=("yarn_cache:1:$yarn_cache")
        total_cleanable=$((total_cleanable + yarn_cache))
    fi
    if (( thumb_cache > THRESH_THUMBS )); then
        items+=("thumbnails:1:$thumb_cache")
        total_cleanable=$((total_cleanable + thumb_cache))
    fi
    if (( hf_cache > THRESH_HF )); then
        items+=("hf_cache:1:$hf_cache")
        total_cleanable=$((total_cleanable + hf_cache))
    fi

    # New tier-1 cache categories: claude-cli-nodejs, go-build, drkonqi,
    # wrangler, puppeteer. All safe to delete (regenerate on next use).
    local claude_cli go_build drkonqi_cache wrangler_cache puppeteer_cache
    claude_cli=$(_du claude_cli)
    go_build=$(_du go_build)
    drkonqi_cache=$(_du drkonqi)
    wrangler_cache=$(_du wrangler)
    puppeteer_cache=$(_du puppeteer)
    : "${claude_cli:=0}" "${go_build:=0}" "${drkonqi_cache:=0}"
    : "${wrangler_cache:=0}" "${puppeteer_cache:=0}"

    if (( claude_cli > THRESH_CLAUDE_CLI )); then
        items+=("claude_cli:1:$claude_cli")
        total_cleanable=$((total_cleanable + claude_cli))
    fi
    if (( go_build > THRESH_GO_BUILD )); then
        items+=("go_build:1:$go_build")
        total_cleanable=$((total_cleanable + go_build))
    fi
    if (( drkonqi_cache > THRESH_DRKONQI )); then
        items+=("drkonqi:1:$drkonqi_cache")
        total_cleanable=$((total_cleanable + drkonqi_cache))
    fi
    if (( wrangler_cache > THRESH_WRANGLER )); then
        items+=("wrangler:1:$wrangler_cache")
        total_cleanable=$((total_cleanable + wrangler_cache))
    fi
    if (( puppeteer_cache > THRESH_PUPPETEER )); then
        items+=("puppeteer:1:$puppeteer_cache")
        total_cleanable=$((total_cleanable + puppeteer_cache))
    fi
    # Playwright: flag only the PRUNABLE bytes (stale browser versions + stale
    # mcp-chrome* hash builds), not the whole cache — newest + in-use stay.
    local playwright_prunable
    playwright_prunable=$(playwright_prunable_bytes)
    : "${playwright_prunable:=0}"
    if (( playwright_prunable > THRESH_PLAYWRIGHT )); then
        items+=("playwright:1:$playwright_prunable")
        total_cleanable=$((total_cleanable + playwright_prunable))
    fi

    # Browser disk caches: sum Brave + Chrome + Firefox + Google (all pure cache).
    local browser_total
    browser_total=$(( $(_du browser_brave) + $(_du browser_chrome) \
                    + $(_du browser_firefox) + $(_du browser_google) ))
    if (( browser_total > THRESH_BROWSER_CACHE )); then
        items+=("browser_caches:1:$browser_total")
        total_cleanable=$((total_cleanable + browser_total))
    fi

    # Misc tier-1 regenerable caches: gradle, pipenv, node-gyp, torch, tsc, bun.
    local gradle_c pipenv_c nodegyp_c torch_c tsc_c bun_c
    gradle_c=$(_du gradle_cache); pipenv_c=$(_du pipenv_cache)
    nodegyp_c=$(_du node_gyp); torch_c=$(_du torch_ext)
    tsc_c=$(_du tsc_cache); bun_c=$(_du bun_cache)
    : "${gradle_c:=0}" "${pipenv_c:=0}" "${nodegyp_c:=0}"
    : "${torch_c:=0}" "${tsc_c:=0}" "${bun_c:=0}"
    if (( gradle_c > THRESH_GRADLE )); then
        items+=("gradle_cache:1:$gradle_c"); total_cleanable=$((total_cleanable + gradle_c))
    fi
    if (( pipenv_c > THRESH_PIPENV )); then
        items+=("pipenv_cache:1:$pipenv_c"); total_cleanable=$((total_cleanable + pipenv_c))
    fi
    if (( nodegyp_c > THRESH_NODE_GYP )); then
        items+=("node_gyp:1:$nodegyp_c"); total_cleanable=$((total_cleanable + nodegyp_c))
    fi
    if (( torch_c > THRESH_TORCH_EXT )); then
        items+=("torch_ext:1:$torch_c"); total_cleanable=$((total_cleanable + torch_c))
    fi
    if (( tsc_c > THRESH_TSC_CACHE )); then
        items+=("tsc_cache:1:$tsc_c"); total_cleanable=$((total_cleanable + tsc_c))
    fi
    if (( bun_c > THRESH_BUN_CACHE )); then
        items+=("bun_cache:1:$bun_c"); total_cleanable=$((total_cleanable + bun_c))
    fi

    # Docker tier output: 5 lines (containers, builder, images, volumes, dangling-count)
    local d_containers d_builder d_images d_volumes d_dangling
    d_containers=$(sed -n '1p' "$TMPDIR_PARALLEL/docker" 2>/dev/null || echo 0)
    d_builder=$(sed -n '2p' "$TMPDIR_PARALLEL/docker" 2>/dev/null || echo 0)
    d_images=$(sed -n '3p' "$TMPDIR_PARALLEL/docker" 2>/dev/null || echo 0)
    d_volumes=$(sed -n '4p' "$TMPDIR_PARALLEL/docker" 2>/dev/null || echo 0)
    d_dangling=$(sed -n '5p' "$TMPDIR_PARALLEL/docker" 2>/dev/null || echo 0)
    : "${d_containers:=0}" "${d_builder:=0}" "${d_images:=0}" "${d_volumes:=0}" "${d_dangling:=0}"

    if (( d_containers > THRESH_DOCKER )); then
        items+=("docker_containers:1:$d_containers")
        total_cleanable=$((total_cleanable + d_containers))
    fi
    if (( d_builder > THRESH_DOCKER )); then
        items+=("docker_builder:1:$d_builder")
        total_cleanable=$((total_cleanable + d_builder))
    fi
    # Tier 2: unused images. Don't add to total_cleanable (not safe-by-default).
    if (( d_images > THRESH_DOCKER )); then
        items+=("docker_images:1:$d_images")
    fi
    # Tier 3: unused volumes. Risky; report only.
    if (( d_volumes > 0 )); then
        items+=("docker_volumes:1:$d_volumes")
    fi
    # d_dangling is a COUNT of dangling images (not bytes). Stored in `val`
    # column of the cache entry so renderers can show "N images".
    if (( d_dangling > 0 )); then
        items+=("docker_dangling:$d_dangling:0")
    fi

    # --- Info items (manual-only) ---
    local conda_size devc_size steam_size
    conda_size=$(_du conda)
    devc_size=$(_du devcontainer_homes)
    steam_size=$(_du steam)
    : "${conda_size:=0}" "${devc_size:=0}" "${steam_size:=0}"

    if (( conda_size > THRESH_CONDA )); then
        info_items+=("conda:1:$conda_size")
    fi
    if (( devc_size > THRESH_DEVC )); then
        info_items+=("devcontainer_homes:1:$devc_size")
    fi

    # git_bloat: zero-or-more "repo_name:size" lines.
    if [[ -s "$TMPDIR_PARALLEL/git_bloat" ]]; then
        local gb_line repo size
        while IFS=: read -r repo size; do
            [[ -z "$repo" ]] && continue
            info_items+=("git_bloat:$repo:$size")
        done < "$TMPDIR_PARALLEL/git_bloat"
    fi

    if (( steam_size > THRESH_STEAM )); then
        info_items+=("steam:1:$steam_size")
    fi

    # windows: optional "pct:avail"
    if [[ -s "$TMPDIR_PARALLEL/windows" ]]; then
        local win_line
        win_line=$(head -1 "$TMPDIR_PARALLEL/windows")
        local win_pct="${win_line%%:*}"
        local win_avail="${win_line#*:}"
        info_items+=("windows:$win_pct:$win_avail")
    fi

    # Emit cache
    echo "$CACHE_VERSION"
    echo "$disk_pct"
    echo "$total_cleanable"
    printf '%s\n' "${items[@]+"${items[@]}"}"
    echo "---"
    printf '%s\n' "${info_items[@]+"${info_items[@]}"}"

    # Explicit cleanup (EXIT trap is a belt-and-braces fallback).
    rm -rf "$TMPDIR_PARALLEL"
    if [[ -n "$SUDO_KEEPALIVE_PID" ]]; then
        trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT
    else
        trap - EXIT
    fi
}

# Ensure the cache exists and is current. Re-build if version mismatched.
ensure_cache() {
    local force="${1:-false}"
    local need_refresh=true

    if [[ "$force" == "true" ]]; then
        need_refresh=true
    elif [[ -f "$CACHE_FILE" ]]; then
        local first_line cache_age
        first_line=$(sed -n '1p' "$CACHE_FILE" 2>/dev/null || echo "")
        cache_age=$(($(date +%s) - $(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0)))
        if [[ "$first_line" == "$CACHE_VERSION" ]] && (( cache_age <= CACHE_MAX_AGE )); then
            need_refresh=false
        fi
    fi

    if [[ "$need_refresh" == "true" ]]; then
        # Serialize concurrent refreshes (multiple shells starting at once) to
        # avoid the 0-byte-cache race where two writers truncate the same file
        # via `>`. flock is non-blocking via -n: if another refresh is already
        # running, skip and let it own the rebuild.
        local lock_file="${CACHE_FILE}.lock"
        local tmp_file
        tmp_file=$(mktemp "${CACHE_FILE}.XXXXXX")
        (
            exec 9>"$lock_file"
            if flock -n 9; then
                if check_cleanup > "$tmp_file"; then
                    mv -f "$tmp_file" "$CACHE_FILE"
                else
                    rm -f "$tmp_file"
                fi
            else
                rm -f "$tmp_file"
            fi
        )
    fi
}

# True iff cache exists and is the current version. Does NOT trigger a rebuild.
cache_is_readable() {
    [[ -f "$CACHE_FILE" && -s "$CACHE_FILE" ]] || return 1
    local first_line
    first_line=$(sed -n '1p' "$CACHE_FILE" 2>/dev/null || echo "")
    [[ "$first_line" == "$CACHE_VERSION" ]]
}

# Read the cache and emit the human-friendly summary. Pure reader — never scans.
# Cache is populated by `cleanup --refresh` (called from shell-status-refresh).
show_suggestions() {
    if ! cache_is_readable; then
        # Silent — bare invocation runs at shell startup. If the cache hasn't
        # been built yet, defer to `cleanup --refresh` instead of blocking the
        # prompt. shell-status-refresh kicks off a background refresh.
        return 0
    fi

    local disk_pct total_cleanable
    disk_pct=$(sed -n '2p' "$CACHE_FILE")
    total_cleanable=$(sed -n '3p' "$CACHE_FILE")

    # Only show if disk >75% or >5GB cleanable
    if (( disk_pct < 75 && total_cleanable < 5368709120 )); then
        return 0
    fi

    local age_s; age_s=$(file_age_human "$CACHE_FILE")
    local age_suffix=""
    [[ -n "$age_s" ]] && age_suffix="${NC}  ${CYAN}(scanned $age_s)${NC}"
    if (( disk_pct >= 80 )); then
        echo -e "${RED}${BOLD}Disk usage: ${disk_pct}%${age_suffix}"
    elif (( disk_pct >= 75 )); then
        echo -e "${YELLOW}${BOLD}Disk usage: ${disk_pct}%${age_suffix}"
    else
        echo -e "${CYAN}Disk usage: ${disk_pct}%${age_suffix}"
    fi

    if (( total_cleanable > 0 )); then
        echo -e "  ${GREEN}--clean will free ~$(human_size "$total_cleanable") (tier-1 safe):${NC}"
    fi

    # We want Docker grouped under a "Docker" header even though the cache
    # is otherwise flat. Buffer items per tier so we can render tier 1 first.
    local docker_t1=() docker_t2=() docker_t3=()
    local other_lines=()

    while IFS=: read -r type count size; do
        [[ "$type" == "---" ]] && break
        [[ -z "$type" ]] && continue
        case "$type" in
            node_modules)
                other_lines+=("    rm $count stale node_modules: $(human_size "$size")  ${DIM}(parent inactive >180d)${NC}")
                ;;
            next_cache)
                other_lines+=("    rm $count .next/cache dirs: $(human_size "$size")  ${DIM}(regenerable; keeps .next/ build)${NC}")
                ;;
            pnpm_store)
                other_lines+=("    pnpm store prune: up to $(human_size "$size")  ${DIM}(unreferenced packages only)${NC}")
                ;;
            rust_target)
                other_lines+=("  ${YELLOW}tier 2${NC} rm $count Rust target/ dirs:           $(human_size "$size")")
                ;;
            python_venvs)
                other_lines+=("  ${YELLOW}tier 2${NC} rm $count stale .venv/venv dirs:       $(human_size "$size")  ${DIM}(parent inactive >90d)${NC}")
                ;;
            elixir_build)
                other_lines+=("  ${YELLOW}tier 2${NC} rm $count stale Elixir _build/ dirs:    $(human_size "$size")  ${DIM}(mix compile; parent inactive >90d)${NC}")
                ;;
            elixir_deps)
                other_lines+=("  ${YELLOW}tier 2${NC} rm $count stale Elixir deps/ dirs:      $(human_size "$size")  ${DIM}(mix deps.get; needs network)${NC}")
                ;;
            unity_library)
                other_lines+=("  ${YELLOW}tier 2${NC} rm $count stale Unity Library/ dirs:    $(human_size "$size")  ${DIM}(reimports on reopen; parent inactive >90d)${NC}")
                ;;
            pycache)
                other_lines+=("    rm $count Python caches: $(human_size "$size")  ${DIM}(__pycache__/.pytest_cache/.mypy_cache/.ruff_cache)${NC}")
                ;;
            snap_revs)
                other_lines+=("  ${YELLOW}tier 2${NC} snap remove $count disabled revisions:   $(human_size "$size")  ${DIM}(drops rollback; needs sudo)${NC}")
                ;;
            pip_cache)
                other_lines+=("    pip cache purge: $(human_size "$size")")
                ;;
            uv_cache)
                other_lines+=("    uv cache clean: $(human_size "$size")")
                ;;
            npm_cache)
                other_lines+=("    npm cache clean --force: $(human_size "$size")")
                ;;
            cargo_cache)
                other_lines+=("    rm -rf ~/.cargo/registry: $(human_size "$size")")
                ;;
            yarn_cache)
                other_lines+=("    yarn cache clean: $(human_size "$size")")
                ;;
            thumbnails)
                other_lines+=("    rm thumbnail cache: $(human_size "$size")")
                ;;
            hf_cache)
                other_lines+=("    HuggingFace cache: $(human_size "$size")  ${DIM}(huggingface-cli delete-cache)${NC}")
                ;;
            claude_cli)
                other_lines+=("    rm Claude CLI cache: $(human_size "$size")")
                ;;
            go_build)
                other_lines+=("    go clean -cache: $(human_size "$size")")
                ;;
            drkonqi)
                other_lines+=("    rm KDE crash dumps: $(human_size "$size")  ${DIM}(drkonqi)${NC}")
                ;;
            wrangler)
                other_lines+=("    rm Wrangler cache: $(human_size "$size")")
                ;;
            puppeteer)
                other_lines+=("    prune Puppeteer Chrome versions: $(human_size "$size")  ${DIM}(keep newest)${NC}")
                ;;
            playwright)
                other_lines+=("    prune Playwright stale browsers: $(human_size "$size")  ${DIM}(keep newest + in-use)${NC}")
                ;;
            browser_caches)
                other_lines+=("    rm browser caches: $(human_size "$size")  ${DIM}(Brave/Chrome/Firefox/Google)${NC}")
                ;;
            gradle_cache)
                other_lines+=("    prune Gradle caches: $(human_size "$size")  ${DIM}(stops daemons, keeps wrapper/jdks)${NC}")
                ;;
            pipenv_cache)
                other_lines+=("    rm pipenv cache: $(human_size "$size")")
                ;;
            node_gyp)
                other_lines+=("    rm node-gyp cache: $(human_size "$size")")
                ;;
            torch_ext)
                other_lines+=("    rm PyTorch extensions cache: $(human_size "$size")")
                ;;
            tsc_cache)
                other_lines+=("    rm TypeScript cache: $(human_size "$size")")
                ;;
            bun_cache)
                other_lines+=("    bun pm cache rm: $(human_size "$size")")
                ;;
            docker_dangling)
                # $count holds the number of dangling images; size is unreliable.
                docker_t1+=("  ${GREEN}tier 1${NC} docker image prune       (dangling images):   ${count} image(s)")
                ;;
            docker_containers)
                docker_t1+=("  ${GREEN}tier 1${NC} docker container prune   (stopped):           $(human_size "$size")")
                ;;
            docker_builder)
                docker_t1+=("  ${GREEN}tier 1${NC} docker builder prune -af (build cache):       $(human_size "$size")")
                ;;
            docker_images)
                docker_t2+=("  ${YELLOW}tier 2${NC} docker image prune -af   (all unused images): $(human_size "$size")")
                ;;
            docker_volumes)
                docker_t3+=("  ${RED}tier 3${NC} docker volume prune       (unused volumes):    $(human_size "$size")")
                ;;
        esac
    done < <(tail -n +4 "$CACHE_FILE")

    if (( ${#other_lines[@]} > 0 )); then
        for l in "${other_lines[@]}"; do echo -e "$l"; done
    fi
    if (( ${#docker_t1[@]} + ${#docker_t2[@]} + ${#docker_t3[@]} > 0 )); then
        echo -e "  ${CYAN}Docker:${NC}"
        for l in "${docker_t1[@]+"${docker_t1[@]}"}"; do echo -e "$l"; done
        for l in "${docker_t2[@]+"${docker_t2[@]}"}"; do echo -e "$l"; done
        for l in "${docker_t3[@]+"${docker_t3[@]}"}"; do echo -e "$l"; done
    fi

    # Info items
    local has_manual=false
    while IFS=: read -r type val size; do
        [[ -z "$type" ]] && continue
        if [[ "$has_manual" == "false" ]]; then
            echo -e "  ${CYAN}Manual:${NC}"
            has_manual=true
        fi
        case "$type" in
            steam)              echo -e "    Steam games: $(human_size "$size")" ;;
            conda)              echo -e "    Conda envs: $(human_size "$size")  ${DIM}conda env list${NC}" ;;
            devcontainer_homes) echo -e "    Devcontainer homes: $(human_size "$size")  ${DIM}du -sh ~/.devcontainer-homes/*${NC}" ;;
            git_bloat)          echo -e "    .git bloat: ${val} ($(human_size "$size"))  ${DIM}git gc --prune=now${NC}" ;;
            windows)            echo -e "    ${RED}Windows partition: ${val}% full${NC} ($(human_size "$size") free)" ;;
        esac
    done < <(sed -n '/^---$/,$ p' "$CACHE_FILE" | tail -n +2)
}

# ---------------------------------------------------------------------------
# Cleanup execution
# ---------------------------------------------------------------------------

# Globals set by parse_clean_args
DRY_RUN=false
ASSUME_YES=false
INCLUDE_TIER_2=false
INCLUDE_TIER_3=false
declare -A SKIP_CAT
declare -A ONLY_CAT
ONLY_MODE=false

is_enabled() {
    local cat="$1"
    if [[ "$ONLY_MODE" == "true" ]]; then
        [[ -n "${ONLY_CAT[$cat]:-}" ]] && return 0 || return 1
    fi
    [[ -n "${SKIP_CAT[$cat]:-}" ]] && return 1
    return 0
}

# Returns 0 if the user confirms (or --yes is set).
# Interactive (stdin is a tty): wait forever — no timeout. A destructive prompt
# that auto-skips on distraction is a foot-gun.
# Non-interactive: 30s timeout to "no", so piped/CI use never hangs.
confirm() {
    local msg="$1"
    if [[ "$ASSUME_YES" == "true" ]]; then
        echo -e "${DIM}${msg} [auto-yes]${NC}"
        return 0
    fi
    local ans=""
    if [[ -t 0 ]]; then
        echo -ne "${msg} [y/N]: "
        read -r ans || return 1
    else
        echo -ne "${msg} [y/N] (30s, default N): "
        if ! read -t 30 -r ans; then
            echo "(timeout)"
            return 1
        fi
    fi
    case "${ans,,}" in
        y|yes) return 0 ;;
        *)     return 1 ;;
    esac
}

# Wraps an action with confirmation + dry-run. Echoes the command in dry-run mode.
maybe_run() {
    local label="$1" est_size="$2"
    shift 2
    # Remaining args = the command to run (executed via eval to allow pipes/glob).
    local cmd="$*"

    echo ""
    echo -e "${BOLD}${label}${NC}  (${YELLOW}$(human_size "${est_size:-0}")${NC})"
    echo -e "  ${DIM}\$ ${cmd}${NC}"

    if [[ "$DRY_RUN" == "true" ]]; then
        echo -e "  ${CYAN}[preview] would run${NC}"
        return 0
    fi

    if ! confirm "  Proceed?"; then
        echo -e "  ${DIM}skipped${NC}"
        return 1
    fi

    eval "$cmd"
}

# Read a value from the cache by type key (returns size bytes for tier items).
cache_size_for() {
    local key="$1"
    local val
    val=$(awk -F: -v k="$key" '$1 == k {print $3; exit}' "$CACHE_FILE" 2>/dev/null || true)
    echo "${val:-0}"
}

do_cleanup() {
    ensure_cache false

    if [[ "$DRY_RUN" == "true" ]]; then
        echo -e "${BOLD}${CYAN}Preview mode — no changes will be made.${NC}"
    else
        echo -e "${BOLD}Running cleanup...${NC}"
    fi

    local freed=0

    # ----- node_modules -----
    if is_enabled node_modules; then
        local nm_size
        nm_size=$(cache_size_for node_modules)
        if (( nm_size > 0 )); then
            local nm_paths=()
            # Read NUL-separated paths into an array (bash arrays cannot store
            # NUL bytes themselves, but mapfile -d '' splits cleanly on NUL).
            while IFS= read -r -d '' p; do
                nm_paths+=("$p")
            done < <(find_stale_node_modules)

            if (( ${#nm_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}Stale node_modules${NC}  (${YELLOW}$(human_size "$nm_size")${NC}, ${#nm_paths[@]} dirs)"
                local shown=0
                for p in "${nm_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#nm_paths[@]} - 5 ))
                        if (( remaining > 0 )); then
                            echo -e "  ${DIM}... and $remaining more${NC}"
                        fi
                        break
                    fi
                done

                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}"
                    freed=$((freed + nm_size))
                elif confirm "  Delete all stale node_modules?"; then
                    for p in "${nm_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + nm_size))
                fi
            fi
        fi
    fi

    # ----- .next/cache (tier-1) -----
    if is_enabled next_cache; then
        local nc_size
        nc_size=$(cache_size_for next_cache)
        if (( nc_size > 0 )); then
            local nc_paths=()
            while IFS= read -r -d '' p; do
                [[ -d "$p/cache" ]] && nc_paths+=("$p/cache")
            done < <(find "$CODE_ROOT" -maxdepth 5 -type d -name .next -prune -print0 2>/dev/null)

            if (( ${#nc_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}.next/cache${NC}  (${YELLOW}$(human_size "$nc_size")${NC}, ${#nc_paths[@]} dirs)"
                local shown=0
                for p in "${nc_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#nc_paths[@]} - 5 ))
                        (( remaining > 0 )) && echo -e "  ${DIM}... and $remaining more${NC}"
                        break
                    fi
                done
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}"
                    freed=$((freed + nc_size))
                elif confirm "  Delete all .next/cache dirs?"; then
                    for p in "${nc_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + nc_size))
                fi
            fi
        fi
    fi

    # ----- Python __pycache__/.pytest_cache/.mypy_cache/.ruff_cache (tier-1) -----
    if is_enabled pycache; then
        local pyc_size
        pyc_size=$(cache_size_for pycache)
        if (( pyc_size > 0 )); then
            local pyc_paths=()
            # Re-derive at run time (same dir-name set + depth as the probe).
            while IFS= read -r -d '' p; do
                pyc_paths+=("$p")
            done < <(find "$CODE_ROOT" -maxdepth "$NESTED_ARTIFACT_MAXDEPTH" -type d \
                \( -name __pycache__ -o -name .pytest_cache -o -name .mypy_cache \
                   -o -name .ruff_cache \) -prune -print0 2>/dev/null)

            if (( ${#pyc_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}Python caches${NC}  (${YELLOW}$(human_size "$pyc_size")${NC}, ${#pyc_paths[@]} dirs)"
                local shown=0
                for p in "${pyc_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#pyc_paths[@]} - 5 ))
                        (( remaining > 0 )) && echo -e "  ${DIM}... and $remaining more${NC}"
                        break
                    fi
                done
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}"
                    freed=$((freed + pyc_size))
                elif confirm "  Delete all Python caches?"; then
                    for p in "${pyc_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + pyc_size))
                fi
            fi
        fi
    fi

    # ----- pnpm store prune (tier-1) -----
    if is_enabled pnpm_store; then
        local ps_size
        ps_size=$(cache_size_for pnpm_store)
        if (( ps_size > 0 )) && command -v pnpm &>/dev/null; then
            if maybe_run "pnpm store prune" "$ps_size" "pnpm store prune"; then
                # Re-measure to learn actual freed; if pnpm reports nothing,
                # account it as 0 rather than the pre-prune size.
                local store_dir new_size
                store_dir=$(pnpm config get store-dir 2>/dev/null | { grep -v '^undefined$' || true; } | head -1)
                [[ -z "$store_dir" || ! -d "$store_dir" ]] && store_dir="$CODE_ROOT/.pnpm-store"
                if [[ -d "$store_dir" ]]; then
                    new_size=$(du -sb "$store_dir" 2>/dev/null | cut -f1 || echo "$ps_size")
                    freed=$((freed + ps_size - new_size))
                fi
            fi
        fi
    fi

    # ----- pip cache -----
    if is_enabled pip_cache; then
        local s; s=$(cache_size_for pip_cache)
        if (( s > 0 )); then
            if maybe_run "pip cache" "$s" "rm -rf ~/.cache/pip"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- uv cache -----
    if is_enabled uv_cache; then
        local s; s=$(cache_size_for uv_cache)
        if (( s > 0 )); then
            # `uv cache clean` (without --force) blocks indefinitely while any
            # process is executing from ~/.cache/uv — common when MCP servers
            # spawned via `uvx` are alive. Detect and warn; prefer `rm -rf` as
            # a fallback because it's non-blocking. Skipping is also fine —
            # uv re-populates on next use.
            local uv_holders
            uv_holders=$(pgrep -af 'uv|/.cache/uv/' 2>/dev/null \
                | grep -vE 'pgrep|cleanup' \
                | grep -E '/.cache/uv/|^[[:space:]]*[0-9]+[[:space:]]+uv ' \
                | wc -l)
            if (( uv_holders > 0 )) && command -v uv >/dev/null; then
                echo ""
                echo -e "${BOLD}uv cache${NC}  (${YELLOW}$(human_size "$s")${NC})"
                echo -e "  ${YELLOW}skipped: ${uv_holders} process(es) are using ~/.cache/uv${NC}"
                echo -e "  ${DIM}likely uvx-spawned tools (MCP servers, etc.). Close them and re-run,${NC}"
                echo -e "  ${DIM}or run 'uv cache clean --force' manually to yank live archives.${NC}"
            else
                local cmd="uv cache clean"
                command -v uv >/dev/null || cmd="rm -rf ~/.cache/uv"
                if maybe_run "uv cache" "$s" "$cmd"; then
                    freed=$((freed + s))
                fi
            fi
        fi
    fi

    # ----- npm cache -----
    if is_enabled npm_cache; then
        local s; s=$(cache_size_for npm_cache)
        if (( s > 0 )); then
            local cmd="npm cache clean --force"
            command -v npm >/dev/null || cmd="rm -rf ~/.npm"
            if maybe_run "npm cache" "$s" "$cmd"; then
                freed=$((freed + s))
            elif [[ "$DRY_RUN" != "true" ]]; then
                # npm exits ENOTEMPTY when live npm/npx processes (e.g. agent
                # MCP servers) write into _cacache mid-clean. If the cache
                # still shrank substantially, count the partial clean as
                # success instead of surfacing npm's scary stderr. A declined
                # prompt leaves the size unchanged and takes neither branch.
                local after; after=$(du -sb "$HOME/.npm/_cacache" 2>/dev/null | cut -f1); : "${after:=0}"
                if (( after < s / 2 )); then
                    echo -e "  ${DIM}npm raced live npm processes (ENOTEMPTY) but cache shrank $(human_size "$s") → $(human_size "$after"); counting as cleaned${NC}"
                    freed=$((freed + s - after))
                fi
            fi
        fi
    fi

    # ----- cargo cache -----
    if is_enabled cargo_cache; then
        local s; s=$(cache_size_for cargo_cache)
        if (( s > 0 )); then
            if maybe_run "cargo registry" "$s" "rm -rf ~/.cargo/registry"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- yarn cache -----
    if is_enabled yarn_cache; then
        local s; s=$(cache_size_for yarn_cache)
        if (( s > 0 )); then
            local cmd="yarn cache clean"
            command -v yarn >/dev/null || cmd="rm -rf ~/.yarn/cache"
            if maybe_run "yarn cache" "$s" "$cmd"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- thumbnail cache -----
    if is_enabled thumbnails; then
        local s; s=$(cache_size_for thumbnails)
        if (( s > 0 )); then
            if maybe_run "thumbnail cache" "$s" "rm -rf ~/.cache/thumbnails/*"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Claude CLI cache -----
    if is_enabled claude_cli; then
        local s; s=$(cache_size_for claude_cli)
        if (( s > 0 )); then
            if maybe_run "Claude CLI cache" "$s" "rm -rf ~/.cache/claude-cli-nodejs"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Go build cache -----
    if is_enabled go_build; then
        local s; s=$(cache_size_for go_build)
        if (( s > 0 )); then
            local cmd="go clean -cache"
            command -v go >/dev/null || cmd="rm -rf ~/.cache/go-build"
            if maybe_run "Go build cache" "$s" "$cmd"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- KDE drkonqi crash dumps -----
    if is_enabled drkonqi; then
        local s; s=$(cache_size_for drkonqi)
        if (( s > 0 )); then
            if maybe_run "KDE crash dumps" "$s" "rm -rf ~/.cache/drkonqi"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Wrangler cache -----
    if is_enabled wrangler; then
        local s; s=$(cache_size_for wrangler)
        if (( s > 0 )); then
            if maybe_run "Wrangler cache" "$s" "rm -rf ~/.cache/.wrangler"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Puppeteer Chrome versions (prune old, keep newest) -----
    if is_enabled puppeteer; then
        local s; s=$(cache_size_for puppeteer)
        if (( s > 0 )) && [[ -d "$HOME/.cache/puppeteer" ]]; then
            # Compose a script that keeps the newest version per dir.
            local prune_cmd='for sub in chrome chrome-headless-shell; do
                d="$HOME/.cache/puppeteer/$sub"
                [[ -d "$d" ]] || continue
                latest=$(ls "$d" 2>/dev/null | sort -V | tail -1)
                for v in "$d"/*; do
                    [[ -d "$v" && "$(basename "$v")" != "$latest" ]] && rm -rf "$v"
                done
            done'
            if maybe_run "Puppeteer Chrome (keep newest)" "$s" "$prune_cmd"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Playwright stale browsers (prune old versions + stale mcp-chrome builds) -----
    if is_enabled playwright; then
        local s; s=$(playwright_prunable_bytes)
        if (( s > 0 )); then
            # Re-derive the exact dir list at run time (same selector as the size
            # calc) and rm each. Keeps newest version per family + in-use mcp build.
            local prune_cmd='while IFS= read -r d; do [[ -n "$d" ]] && rm -rf "$d"; done < <(playwright_prune_dirs)'
            if maybe_run "Playwright stale browsers (keep newest + in-use)" "$s" "$prune_cmd"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Browser disk caches (Brave/Chrome/Firefox/Google) -----
    if is_enabled browser_caches; then
        # Size is the summed item persisted under the browser_caches key (the
        # individual browser_* probe keys are not cached, only their sum).
        local s; s=$(cache_size_for browser_caches)
        if (( s > 0 )); then
            local prune_cmd='rm -rf ~/.cache/BraveSoftware ~/.cache/google-chrome ~/.cache/mozilla ~/.cache/Google'
            if maybe_run "Browser caches" "$s" "$prune_cmd"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Gradle caches (stop daemons first; keep wrapper/ + jdks/) -----
    if is_enabled gradle_cache; then
        local s; s=$(cache_size_for gradle_cache)
        if (( s > 0 )) && [[ -d "$HOME/.gradle/caches" ]]; then
            # Stop daemons so we don't delete caches out from under a live build.
            local prune_cmd='command -v gradle >/dev/null && gradle --stop >/dev/null 2>&1; pkill -f "GradleDaemon" 2>/dev/null; rm -rf ~/.gradle/caches'
            if maybe_run "Gradle caches (keep wrapper/jdks)" "$s" "$prune_cmd"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- pipenv download cache -----
    if is_enabled pipenv_cache; then
        local s; s=$(cache_size_for pipenv_cache)
        if (( s > 0 )); then
            if maybe_run "pipenv cache" "$s" "rm -rf ~/.cache/pipenv"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- node-gyp header cache -----
    if is_enabled node_gyp; then
        local s; s=$(cache_size_for node_gyp)
        if (( s > 0 )); then
            if maybe_run "node-gyp cache" "$s" "rm -rf ~/.cache/node-gyp"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- PyTorch compiled extensions cache -----
    if is_enabled torch_ext; then
        local s; s=$(cache_size_for torch_ext)
        if (( s > 0 )); then
            if maybe_run "PyTorch extensions cache" "$s" "rm -rf ~/.cache/torch_extensions"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- TypeScript compiler cache -----
    if is_enabled tsc_cache; then
        local s; s=$(cache_size_for tsc_cache)
        if (( s > 0 )); then
            if maybe_run "TypeScript cache" "$s" "rm -rf ~/.cache/typescript"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- Bun install cache -----
    if is_enabled bun_cache; then
        local s; s=$(cache_size_for bun_cache)
        if (( s > 0 )); then
            # Prefer the bun-native command (keeps cache dir structure sane).
            local prune_cmd='command -v bun >/dev/null && bun pm cache rm >/dev/null 2>&1 || rm -rf ~/.bun/install/cache'
            if maybe_run "Bun install cache" "$s" "$prune_cmd"; then
                freed=$((freed + s))
            fi
        fi
    fi

    # ----- HuggingFace cache -----
    if is_enabled hf_cache; then
        local s; s=$(cache_size_for hf_cache)
        if (( s > 0 )); then
            echo ""
            echo -e "${BOLD}HuggingFace cache${NC}  (${YELLOW}$(human_size "$s")${NC})"
            if command -v huggingface-cli >/dev/null; then
                echo -e "  ${DIM}\$ huggingface-cli scan-cache${NC}"
                echo -e "  ${CYAN}tip: run 'huggingface-cli delete-cache' for an interactive picker${NC}"
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would invoke huggingface-cli delete-cache${NC}"
                elif confirm "  Run huggingface-cli delete-cache now?"; then
                    huggingface-cli delete-cache || true
                fi
            else
                if maybe_run "HuggingFace cache (full rm)" "$s" "rm -rf ~/.cache/huggingface"; then
                    freed=$((freed + s))
                fi
            fi
        fi
    fi

    # ----- Docker tier 1: containers + builder + dangling images -----
    if command -v docker &>/dev/null && docker info &>/dev/null; then
        local dc db
        dc=$(cache_size_for docker_containers)
        db=$(cache_size_for docker_builder)

        if is_enabled docker_containers && (( dc > 0 )); then
            if maybe_run "Docker tier 1: stopped containers" "$dc" "docker container prune -f"; then
                freed=$((freed + dc))
            fi
        fi
        if is_enabled docker_builder && (( db > 0 )); then
            if maybe_run "Docker tier 1: build cache" "$db" "docker builder prune -af"; then
                freed=$((freed + db))
            fi
        fi
        # Dangling images: cache stores the COUNT in the "val" column.
        local dd_count=0
        if is_enabled docker_dangling; then
            dd_count=$(awk -F: '$1 == "docker_dangling" {print $2; exit}' "$CACHE_FILE" 2>/dev/null || echo 0)
        fi
        if (( ${dd_count:-0} > 0 )); then
            echo ""
            echo -e "${BOLD}Docker tier 1: dangling images${NC}  (${YELLOW}${dd_count} image(s)${NC})"
            echo -e "  ${DIM}\$ docker image prune -f${NC}"
            if [[ "$DRY_RUN" == "true" ]]; then
                echo -e "  ${CYAN}[preview] would run${NC}"
            elif confirm "  Proceed?"; then
                docker image prune -f
            else
                echo -e "  ${DIM}skipped${NC}"
            fi
        fi

        if [[ "$INCLUDE_TIER_2" == "true" ]] && is_enabled docker_images; then
            local di; di=$(cache_size_for docker_images)
            if (( di > 0 )); then
                if maybe_run "Docker tier 2: all unused images" "$di" "docker image prune -af"; then
                    freed=$((freed + di))
                fi
            fi
        fi

        if [[ "$INCLUDE_TIER_3" == "true" ]] && is_enabled docker_volumes; then
            local dv; dv=$(cache_size_for docker_volumes)
            if (( dv > 0 )); then
                echo ""
                echo -e "${RED}${BOLD}DESTRUCTIVE: docker volume prune permanently deletes unreferenced volumes.${NC}"
                if maybe_run "Docker tier 3: unused volumes" "$dv" "docker volume prune -f"; then
                    freed=$((freed + dv))
                fi
            fi
        fi
    fi

    # ----- Rust target/ dirs (tier-2) -----
    if [[ "$INCLUDE_TIER_2" == "true" ]] && is_enabled rust_target; then
        local rt_size
        rt_size=$(cache_size_for rust_target)
        if (( rt_size > 0 )); then
            local rt_paths=()
            while IFS= read -r -d '' p; do
                local parent; parent=$(dirname "$p")
                [[ -f "$parent/Cargo.toml" ]] && rt_paths+=("$p")
            done < <(find "$CODE_ROOT" -maxdepth 5 -type d -name target -prune -print0 2>/dev/null)

            if (( ${#rt_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}Rust target/ dirs${NC}  (${YELLOW}$(human_size "$rt_size")${NC}, ${#rt_paths[@]} dirs)"
                local shown=0
                for p in "${rt_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#rt_paths[@]} - 5 ))
                        (( remaining > 0 )) && echo -e "  ${DIM}... and $remaining more${NC}"
                        break
                    fi
                done
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}"
                    freed=$((freed + rt_size))
                elif confirm "  Delete all Rust target/ dirs?"; then
                    for p in "${rt_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + rt_size))
                fi
            fi
        fi
    fi

    # ----- Stale Python venvs (tier-2) -----
    if [[ "$INCLUDE_TIER_2" == "true" ]] && is_enabled python_venvs; then
        local pv_size
        pv_size=$(cache_size_for python_venvs)
        if (( pv_size > 0 )); then
            local pv_paths=()
            while IFS= read -r -d '' p; do
                pv_paths+=("$p")
            done < <(find_stale_venvs)

            if (( ${#pv_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}Stale Python venvs${NC}  (${YELLOW}$(human_size "$pv_size")${NC}, ${#pv_paths[@]} dirs)"
                local shown=0
                for p in "${pv_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#pv_paths[@]} - 5 ))
                        (( remaining > 0 )) && echo -e "  ${DIM}... and $remaining more${NC}"
                        break
                    fi
                done
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}"
                    freed=$((freed + pv_size))
                elif confirm "  Delete all stale venvs?"; then
                    for p in "${pv_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + pv_size))
                fi
            fi
        fi
    fi

    # ----- Stale Elixir _build/ (tier-2) -----
    if [[ "$INCLUDE_TIER_2" == "true" ]] && is_enabled elixir_build; then
        local eb_size
        eb_size=$(cache_size_for elixir_build)
        if (( eb_size > 0 )); then
            local eb_paths=()
            while IFS= read -r -d '' p; do
                eb_paths+=("$p")
            done < <(find_stale_project_artifacts _build _is_elixir_project)

            if (( ${#eb_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}Stale Elixir _build/ dirs${NC}  (${YELLOW}$(human_size "$eb_size")${NC}, ${#eb_paths[@]} dirs)"
                local shown=0
                for p in "${eb_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#eb_paths[@]} - 5 ))
                        (( remaining > 0 )) && echo -e "  ${DIM}... and $remaining more${NC}"
                        break
                    fi
                done
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}  ${DIM}(mix compile rebuilds)${NC}"
                    freed=$((freed + eb_size))
                elif confirm "  Delete all stale Elixir _build/ dirs?"; then
                    for p in "${eb_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + eb_size))
                fi
            fi
        fi
    fi

    # ----- Stale Elixir deps/ (tier-2; needs network to refetch) -----
    if [[ "$INCLUDE_TIER_2" == "true" ]] && is_enabled elixir_deps; then
        local ed_size
        ed_size=$(cache_size_for elixir_deps)
        if (( ed_size > 0 )); then
            local ed_paths=()
            while IFS= read -r -d '' p; do
                ed_paths+=("$p")
            done < <(find_stale_project_artifacts deps _is_elixir_project)

            if (( ${#ed_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}Stale Elixir deps/ dirs${NC}  (${YELLOW}$(human_size "$ed_size")${NC}, ${#ed_paths[@]} dirs)"
                local shown=0
                for p in "${ed_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#ed_paths[@]} - 5 ))
                        (( remaining > 0 )) && echo -e "  ${DIM}... and $remaining more${NC}"
                        break
                    fi
                done
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}  ${DIM}(mix deps.get refetches; needs network)${NC}"
                    freed=$((freed + ed_size))
                elif confirm "  Delete all stale Elixir deps/ dirs?"; then
                    for p in "${ed_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + ed_size))
                fi
            fi
        fi
    fi

    # ----- Stale Unity Library/ (tier-2) -----
    if [[ "$INCLUDE_TIER_2" == "true" ]] && is_enabled unity_library; then
        local ul_size
        ul_size=$(cache_size_for unity_library)
        if (( ul_size > 0 )); then
            local ul_paths=()
            while IFS= read -r -d '' p; do
                ul_paths+=("$p")
            done < <(find_stale_project_artifacts Library _is_unity_project)

            if (( ${#ul_paths[@]} > 0 )); then
                echo ""
                echo -e "${BOLD}Stale Unity Library/ dirs${NC}  (${YELLOW}$(human_size "$ul_size")${NC}, ${#ul_paths[@]} dirs)"
                local shown=0
                for p in "${ul_paths[@]}"; do
                    echo -e "  ${DIM}$p${NC}"
                    shown=$((shown+1))
                    if (( shown >= 5 )); then
                        local remaining=$(( ${#ul_paths[@]} - 5 ))
                        (( remaining > 0 )) && echo -e "  ${DIM}... and $remaining more${NC}"
                        break
                    fi
                done
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would rm -rf each${NC}  ${DIM}(Unity reimports on reopen)${NC}"
                    freed=$((freed + ul_size))
                elif confirm "  Delete all stale Unity Library/ dirs?"; then
                    for p in "${ul_paths[@]}"; do
                        rm -rf "$p" 2>/dev/null || true
                    done
                    echo -e "  ${GREEN}done${NC}"
                    freed=$((freed + ul_size))
                fi
            fi
        fi
    fi

    # ----- Disabled snap revisions (tier-2) -----
    # Removal needs root; `snap remove` re-derives the list live so it stays
    # correct even if revisions changed since the cache was built.
    if [[ "$INCLUDE_TIER_2" == "true" ]] && is_enabled snap_revs; then
        local sr_size
        sr_size=$(cache_size_for snap_revs)
        if (( sr_size > 0 )); then
            local sr_list
            sr_list=$(snap list --all 2>/dev/null | awk '$NF ~ /disabled/ {print $1, $3}')
            if [[ -n "$sr_list" ]]; then
                local sr_n; sr_n=$(printf '%s\n' "$sr_list" | grep -c .)
                echo ""
                echo -e "${BOLD}Disabled snap revisions${NC}  (${YELLOW}$(human_size "$sr_size")${NC}, ${sr_n} revisions)"
                printf '%s\n' "$sr_list" | head -5 | while read -r n r; do echo -e "  ${DIM}${n} (r${r})${NC}"; done
                (( sr_n > 5 )) && echo -e "  ${DIM}... and $((sr_n - 5)) more${NC}"
                local snap_sudo=""
                sudo -n true 2>/dev/null || snap_sudo="needpw"
                if [[ "$DRY_RUN" == "true" ]]; then
                    echo -e "  ${CYAN}[preview] would: sudo snap remove <name> --revision=<rev> for each${NC}"
                    freed=$((freed + sr_size))
                elif confirm "  Remove all disabled snap revisions (sudo)?"; then
                    [[ "$snap_sudo" == "needpw" ]] && echo -e "  ${DIM}(sudo will prompt)${NC}"
                    local sr_ok=0
                    while read -r n r; do
                        [[ -z "$n" ]] && continue
                        if sudo snap remove "$n" --revision="$r" >/dev/null 2>&1; then
                            echo -e "  ${GREEN}removed${NC} ${n} r${r}"; sr_ok=$((sr_ok+1))
                        else
                            echo -e "  ${RED}failed${NC} ${n} r${r}"
                        fi
                    done <<< "$sr_list"
                    echo -e "  ${GREEN}done${NC} (${sr_ok} removed)"
                    (( sr_ok > 0 )) && freed=$((freed + sr_size))
                fi
            fi
        fi
    fi

    echo ""
    if [[ "$DRY_RUN" == "true" ]]; then
        echo -e "${BOLD}Preview total: $(human_size "$freed")${NC}"
    else
        echo -e "${BOLD}Total freed (estimate): $(human_size "$freed")${NC}"
        echo -e "Disk now: $(df -h / | tail -1 | awk '{print $5}')"
        # Repopulate cache synchronously — same pattern as `updates --apply`.
        # Cheap (sub-second after `freed > 0` removed paths from the walk),
        # and guarantees the next bare invocation reflects post-cleanup state.
        if (( freed > 0 )) && [[ "$REFRESH_CACHE_AFTER_CLEANUP" == "true" ]]; then
            echo "Refreshing cache..."
            ensure_cache true
        fi
    fi
}

refresh_cache() {
    ensure_cache true
    echo "Cache refreshed"
}

# ---------------------------------------------------------------------------
# Dedupe: rmlint-driven duplicate detection (report-only by default)
# ---------------------------------------------------------------------------
#
# Why this isn't wired into --clean:
#  - Hardlinking writable files (node_modules, target/, .venv/) can silently
#    corrupt data when a tool does an in-place write to one of the linked copies.
#  - rmlint itself produces a SHELL SCRIPT and never deletes/links on its own.
#    The user reviewing and running `./rmlint.sh` is the safety boundary.
#  - Good targets are read-mostly trees (model caches, photos, music). Code
#    directories have high false-positive risk.
#
# This action: install rmlint if missing, run it on PATH with build-dir
# exclusions, print the saved-bytes estimate, then exit. User is responsible
# for reviewing/executing the generated rmlint.sh.

DEDUPE_EXCLUDES_DEFAULT=(
    node_modules
    target
    .next
    .venv
    venv
    __pycache__
    .git
    dist
    build
    .cache
    .tox
    .gradle
)

ensure_rmlint() {
    if command -v rmlint &>/dev/null; then
        return 0
    fi
    echo -e "${YELLOW}rmlint is not installed.${NC}"
    echo -e "  ${DIM}\$ sudo apt-get install -y rmlint${NC}"
    if ! confirm "  Install rmlint now (requires sudo)?"; then
        echo -e "  ${DIM}skipped — cannot run --dedupe without rmlint${NC}"
        return 1
    fi
    sudo apt-get install -y rmlint
}

do_dedupe() {
    local target="${1:-}"
    if [[ -z "$target" ]]; then
        echo "Usage: cleanup --dedupe PATH [--include-builds] [--script|--preview]" >&2
        echo "  Default: scan, show summary, prompt to hardlink duplicates." >&2
        echo "  --script:  write ./rmlint.sh for offline review, don't prompt." >&2
        echo "  --preview: scan only; no prompt, no script written." >&2
        return 2
    fi
    if [[ ! -d "$target" ]]; then
        echo "Not a directory: $target" >&2
        return 2
    fi

    local include_builds=false
    local mode="prompt"   # prompt | script | preview
    shift
    while (( $# > 0 )); do
        case "$1" in
            --include-builds) include_builds=true ;;
            --script)         mode="script" ;;
            --preview|--dry-run) mode="preview" ;;
            *) echo "Unknown --dedupe flag: $1" >&2; return 2 ;;
        esac
        shift
    done

    # Filesystem safety check. Hardlinking requires (a) a filesystem that
    # supports hardlinks reliably and (b) `du -sB1` accurately reflecting
    # block-level dedup. ext4/btrfs/xfs are known-good. CIFS/NFS handle
    # hardlinks unreliably or not at all, and `du` over the network gives
    # numbers we don't control. Refuse to dedupe outside the allowlist.
    local fs_type
    fs_type=$(stat -f -c '%T' "$target" 2>/dev/null || echo unknown)
    case "$fs_type" in
        ext2/ext3|ext4|btrfs|xfs|reiserfs|jfs)
            ;;
        *)
            echo -e "${RED}refusing to dedupe on filesystem type '${fs_type}'${NC}" >&2
            echo -e "  ${DIM}Hardlink semantics are unreliable on this filesystem.${NC}" >&2
            echo -e "  ${DIM}Supported: ext4, btrfs, xfs.${NC}" >&2
            return 1
            ;;
    esac

    ensure_rmlint || return 1

    # Strategy:
    #   1. Scan the whole target to JSON (with --no-crossdev so no group
    #      spans filesystems — see safety note below).
    #   2. Filter the JSON to drop duplicate groups touching excluded paths.
    #   3. Re-emit rmlint.sh via `rmlint --replay` on the filtered JSON.
    #
    # CRITICAL: rmlint's sh formatter, when handler=hardlink, does
    #   `rm -rf "$dup"; ln "$orig" "$dup"`.
    # If `ln` fails (cross-device), the dup is already gone — data loss.
    # `-x` (--no-crossdev) prevents rmlint from EVER pairing files on
    # different filesystems, so the cross-device case can't arise.
    #
    # `-c sh:handler=hardlink` is explicit (no symlink fallback). The
    # shortcut `-c sh:hardlink` is equivalent in practice because the
    # fallback only triggers for duplicate *directories*, which we don't
    # scan (--types=duplicates is file-only). Use the explicit form to
    # avoid ambiguity for readers.
    local raw_args=( --types=duplicates --hidden \
        --no-crossdev \
        -c sh:handler=hardlink \
        -o json:./rmlint-raw.json \
        -o pretty -o summary )

    echo ""
    echo -e "${BOLD}rmlint scan${NC}  target: ${CYAN}$target${NC}"
    if [[ "$include_builds" == "false" ]]; then
        echo -e "  ${DIM}post-filter excludes: ${DEDUPE_EXCLUDES_DEFAULT[*]}${NC}"
        echo -e "  ${DIM}override with --include-builds (advanced; risky for code dirs)${NC}"
    else
        echo -e "  ${YELLOW}WARNING:${NC} scanning build/cache dirs. Review carefully before hardlinking."
    fi
    echo ""

    local out_dir
    out_dir=$(mktemp -d -t rmlint-XXXXXX)
    (
        cd "$out_dir" || exit 1
        rmlint "${raw_args[@]}" "$target"
    )
    local rc=$?

    if [[ ! -f "$out_dir/rmlint-raw.json" ]]; then
        echo -e "${DIM}rmlint produced no output.${NC}"
        rm -rf "$out_dir"
        return $rc
    fi

    # Build the JS-style filter: keep duplicate groups iff NO member touches
    # an excluded segment. Re-emit a filtered JSON for --replay. python3 is
    # always present; jq is not.
    local excludes_csv=""
    if [[ "$include_builds" == "false" ]]; then
        local first=true e
        for e in "${DEDUPE_EXCLUDES_DEFAULT[@]}"; do
            if $first; then excludes_csv="$e"; first=false
            else excludes_csv="$excludes_csv,$e"; fi
        done
    fi

    if ! python3 - "$out_dir/rmlint-raw.json" "$out_dir/rmlint-filtered.json" "$excludes_csv" <<'PY'
import json, sys, os
raw_path, filtered_path, excludes_csv = sys.argv[1], sys.argv[2], sys.argv[3]
excludes = [e for e in excludes_csv.split(",") if e]

with open(raw_path) as f:
    data = json.load(f)

if not isinstance(data, list) or len(data) < 2:
    sys.stderr.write("rmlint JSON has unexpected shape (not a list or empty)\n")
    sys.exit(2)

# rmlint JSON: [header, dup_file*, footer]. Verify exactly one footer.
footers = [e for e in data
           if isinstance(e, dict) and "total_lint_size" in e]
if len(footers) != 1:
    sys.stderr.write(f"expected exactly 1 JSON footer, got {len(footers)}\n")
    sys.exit(2)
footer = footers[0]

def has_excluded_segment(path):
    parts = path.split(os.sep)
    return any(seg in excludes for seg in parts)

# Pass 1: find checksums where any member's path hits an exclude.
bad_checksums = set()
for entry in data:
    if isinstance(entry, dict) and entry.get("type") == "duplicate_file":
        if has_excluded_segment(entry.get("path", "")):
            bad_checksums.add(entry.get("checksum"))

# Pass 2: rebuild array, dropping bad groups; track removed counts.
kept = []
removed_dups = 0
removed_bytes = 0
for entry in data:
    if not isinstance(entry, dict):
        kept.append(entry); continue
    if "total_lint_size" in entry:
        continue   # append rewritten footer at the end
    if entry.get("type") == "duplicate_file":
        if entry.get("checksum") in bad_checksums:
            if not entry.get("is_original"):
                removed_dups += 1
                removed_bytes += entry.get("size", 0)
            continue
    kept.append(entry)

# Rewrite footer. `duplicates` counts non-original duplicate_file entries
# (verified empirically: 1 group of 2 identical files → duplicates=1).
new_footer = dict(footer)
new_footer["duplicates"] = max(0, footer.get("duplicates", 0) - removed_dups)
new_footer["total_lint_size"] = max(0, footer.get("total_lint_size", 0) - removed_bytes)
sets = {e.get("checksum") for e in kept
        if isinstance(e, dict) and e.get("type") == "duplicate_file"}
new_footer["duplicate_sets"] = len(sets)
kept.append(new_footer)

with open(filtered_path, "w") as f:
    json.dump(kept, f)
PY
    then
        echo -e "${RED}filter step failed — aborting to avoid acting on unverified data${NC}" >&2
        rm -rf "$out_dir"
        return 1
    fi

    if [[ ! -f "$out_dir/rmlint-filtered.json" ]]; then
        echo -e "${RED}filter wrote no output — aborting${NC}" >&2
        rm -rf "$out_dir"
        return 1
    fi

    # Re-emit rmlint.sh from the filtered JSON. -c sh:handler=hardlink MUST
    # be set here — replay re-applies formatter config from the current
    # command line, not from the saved JSON. Without it, rmlint.sh defaults
    # to `remove_cmd` (delete). VERIFIED: tested both forms; replay without
    # this flag emits `remove_cmd '...'` lines.
    (
        cd "$out_dir" || exit 1
        rmlint --replay ./rmlint-filtered.json -c sh:handler=hardlink \
            -o sh:./rmlint.sh -o summary "$target" >/dev/null 2>&1
    )

    # Defense-in-depth: positive whitelist for rmlint.sh action lines.
    # With `--types=duplicates -c sh:handler=hardlink`, rmlint produces exactly
    # two action-line shapes (verified against rmlint 2.10.2):
    #   original_cmd  '<path>' # original         (cosmetic, prints "Keeping")
    #   cp_hardlink   '<path>' '<path>' # duplicate
    # Any other prefix (remove_cmd, cp_symlink, cp_clone, usercmd_cmd,
    # handle_bad_symlink) means rmlint chose a different handler than we
    # configured. Abort rather than trust.
    if [[ -f "$out_dir/rmlint.sh" ]]; then
        local bad_lines
        bad_lines=$(grep -nE "# (duplicate|original)$" "$out_dir/rmlint.sh" 2>/dev/null \
                    | grep -vE "^[0-9]+:(original_cmd|cp_hardlink) " || true)
        if [[ -n "$bad_lines" ]]; then
            echo -e "${RED}rmlint.sh contains unexpected action lines — refusing to run${NC}" >&2
            echo -e "${DIM}${bad_lines}${NC}" >&2
            rm -rf "$out_dir"
            return 1
        fi
    fi

    if [[ ! -f "$out_dir/rmlint.sh" ]]; then
        echo -e "${DIM}rmlint produced no script — no duplicates after filtering.${NC}"
        rm -rf "$out_dir"
        return 0
    fi

    # Authoritative size from filtered JSON's footer.
    local saved_bytes
    saved_bytes=$(python3 -c '
import json, sys
with open(sys.argv[1]) as f:
    data = json.load(f)
for entry in reversed(data):
    if isinstance(entry, dict) and "total_lint_size" in entry:
        print(entry["total_lint_size"]); break
' "$out_dir/rmlint-filtered.json" 2>/dev/null)
    : "${saved_bytes:=0}"

    if (( saved_bytes <= 0 )); then
        echo -e "${DIM}no duplicates remain after filtering.${NC}"
        rm -rf "$out_dir"
        return 0
    fi
    local saved_human
    saved_human=$(human_size "$saved_bytes")

    case "$mode" in
        preview)
            echo ""
            echo -e "${CYAN}preview: would dedupe up to ${saved_human}${NC}"
            echo -e "  ${DIM}rerun without --preview to act, or with --script to save the rmlint.sh${NC}"
            rm -rf "$out_dir"
            return 0
            ;;
        script)
            local dest="${PWD}/rmlint.sh"
            cp "$out_dir/rmlint.sh" "$dest"
            chmod +x "$dest"
            rm -rf "$out_dir"
            echo ""
            echo -e "${GREEN}Wrote review script:${NC} ${BOLD}$dest${NC}  (~${saved_human})"
            echo -e "  ${DIM}Script is configured to HARDLINK duplicates (not delete).${NC}"
            echo -e "  ${DIM}\$ less rmlint.sh      # review${NC}"
            echo -e "  ${DIM}\$ ./rmlint.sh -n      # dry-run${NC}"
            echo -e "  ${DIM}\$ ./rmlint.sh         # execute (prompts before running)${NC}"
            return 0
            ;;
        prompt)
            echo ""
            echo -e "${BOLD}Found duplicates worth up to ${YELLOW}${saved_human}${NC}${BOLD}.${NC}"
            echo -e "  ${DIM}Action: hardlink duplicates. Files still exist by name but share${NC}"
            echo -e "  ${DIM}disk blocks. Safe for read-only data; risky for files that get${NC}"
            echo -e "  ${DIM}in-place writes (rare — most tools write atomically via rename).${NC}"
            if ! confirm "  Hardlink duplicates now?"; then
                local dest="${PWD}/rmlint.sh"
                cp "$out_dir/rmlint.sh" "$dest"
                chmod +x "$dest"
                rm -rf "$out_dir"
                echo -e "  ${DIM}skipped. Saved script for later: ${dest}${NC}"
                return 0
            fi

            # Measure precisely: du -sB1 counts allocated blocks per inode.
            # Hardlinks share inodes, so post-dedup du drops by exactly the
            # blocks the duplicates used to consume — no noise from other
            # filesystem activity.
            # -x stays on the same filesystem as rmlint (--no-crossdev).
            local du_before du_after
            du_before=$(du -sxB1 "$target" 2>/dev/null | cut -f1)
            : "${du_before:=0}"

            chmod +x "$out_dir/rmlint.sh"
            # -d  : skip rmlint.sh's own "are you sure" prompt (we already did)
            # -p  : paranoid re-check — re-compare each pair byte-by-byte
            #       before the `rm + ln`. Catches files that changed between
            #       scan time and execute time. Costs an extra read pass; for
            #       safety vs speed at this stage, safety wins.
            ( cd "$out_dir" && ./rmlint.sh -d -p ) || rc=$?

            du_after=$(du -sxB1 "$target" 2>/dev/null | cut -f1)
            : "${du_after:=0}"
            local freed=$((du_before - du_after))
            if (( freed > 0 )); then
                echo -e "  ${GREEN}freed $(human_size "$freed") in $target${NC}  ${DIM}(rmlint estimated ${saved_human})${NC}"
            elif (( freed < 0 )); then
                echo -e "  ${YELLOW}target grew by $(human_size "$((-freed))") during dedup — concurrent writes?${NC}"
            else
                echo -e "  ${DIM}no bytes freed — duplicates may already share blocks (reflinks/existing hardlinks), or all candidates were skipped.${NC}"
            fi
            rm -rf "$out_dir"
            return $rc
            ;;
    esac
}

show_help() {
    cat <<EOF
cleanup — disk-cleanup advisor with tiered execution

USAGE:
  cleanup                     Show suggestions (uses 1h cache)
  cleanup --preview           Show what --clean would do; no execution
  cleanup --clean             Execute cleanup with per-category prompts
  cleanup --clean --yes       Execute without prompts (CI / automation)
  cleanup --refresh           Re-scan and rebuild cache (prints output)
  cleanup --dedupe PATH       Scan PATH for duplicates; prompt to hardlink
  cleanup --quiet             Single '!' if action is warranted (prompt use)
  cleanup --help              This message

CLEAN FLAGS:
  --yes, -y                 Skip every per-category prompt
  --dry-run                 Same as --preview when combined with --clean
  --preview                 Dry-run regardless of other flags
  --include-tier-2          Also run tier-2 actions: unused docker images,
                            Rust target/ dirs, stale Python venvs, stale Elixir
                            _build/ + deps/, stale Unity Library/
  --include-tier-3          Also run 'docker volume prune'    (DESTRUCTIVE)
  --skip-CATEGORY           Exclude a category (repeatable)
  --only-CATEGORY           Restrict to listed categories (repeatable)

DEDUPE FLAGS:
  --include-builds          Don't exclude build/cache dirs from scan
                            (risky for code dirs; safe for media/photos)
  --preview, --dry-run      Scan only; print saved-bytes estimate and exit
  --script                  Don't prompt; write ./rmlint.sh for offline review

CATEGORIES:
  node_modules        Stale project node_modules (parent inactive >180d)
  next_cache          .next/cache/ dirs under ~/code  (tier 1, safe)
  pycache             __pycache__/.pytest_cache/.mypy_cache/.ruff_cache (tier 1)
  pnpm_store          pnpm content-addressed store    (via 'pnpm store prune')
  pip_cache           ~/.cache/pip
  uv_cache            ~/.cache/uv  (via 'uv cache clean')
  npm_cache           ~/.npm       (via 'npm cache clean --force')
  cargo_cache         ~/.cargo/registry
  yarn_cache          ~/.yarn/cache
  thumbnails          ~/.cache/thumbnails
  hf_cache            ~/.cache/huggingface  (prefers huggingface-cli delete-cache)
  claude_cli          ~/.cache/claude-cli-nodejs
  go_build            ~/.cache/go-build     (via 'go clean -cache')
  drkonqi             ~/.cache/drkonqi      (KDE crash dumps)
  wrangler            ~/.cache/.wrangler    (Cloudflare CLI cache)
  puppeteer           ~/.cache/puppeteer    (keeps newest Chrome version)
  playwright          ~/.cache/ms-playwright (keeps newest browser + in-use mcp build)
  browser_caches      ~/.cache/{Brave,chrome,mozilla,Google}  (pure disk cache)
  gradle_cache        ~/.gradle/caches      (stops daemons, keeps wrapper/jdks)
  pipenv_cache        ~/.cache/pipenv       (download cache)
  node_gyp            ~/.cache/node-gyp     (native-addon headers)
  torch_ext           ~/.cache/torch_extensions (recompiled on next use)
  tsc_cache           ~/.cache/typescript   (TS compiler cache)
  bun_cache           ~/.bun/install/cache  (bun pm cache rm)
  docker_containers   tier 1, safe         (docker container prune -f)
  docker_builder      tier 1, safe         (docker builder prune -af)
  docker_dangling     tier 1, safe         (docker image prune -f)
  docker_images       tier 2, opt-in       (docker image prune -af)
  docker_volumes      tier 3, destructive  (docker volume prune -f)
  rust_target         tier 2, opt-in       (rm target/ dirs; rebuild expensive)
  python_venvs        tier 2, opt-in       (stale .venv; parent inactive >90d)
  elixir_build        tier 2, opt-in       (stale _build/; sibling mix.exs; mix compile)
  elixir_deps         tier 2, opt-in       (stale deps/; sibling mix.exs; needs network)
  unity_library       tier 2, opt-in       (stale Library/; sibling Assets/+ProjectSettings/)

EXAMPLES:
  cleanup --preview
  cleanup --clean --only-pip_cache --only-npm_cache
  cleanup --clean --skip-node_modules
  cleanup --clean --yes --include-tier-2
  cleanup --dedupe ~/Pictures
  cleanup --dedupe ~/.cache/huggingface

OPTIONAL STRUCTURAL FIX:
  To avoid duplicate Rust builds across projects, you can add this to your
  shell rc (NOT enabled by default — some workflows assume in-tree target/):
    export CARGO_TARGET_DIR=\$HOME/.cargo-target
EOF
}

parse_clean_args() {
    while (( $# > 0 )); do
        case "$1" in
            --yes|-y)             ASSUME_YES=true ;;
            --dry-run|--preview)  DRY_RUN=true ;;
            --include-tier-2)     INCLUDE_TIER_2=true ;;
            --include-tier-3)     INCLUDE_TIER_3=true ;;
            --skip-*)             SKIP_CAT["${1#--skip-}"]=1 ;;
            --only-*)             ONLY_CAT["${1#--only-}"]=1; ONLY_MODE=true ;;
            *)                    echo "Unknown flag: $1" >&2; show_help >&2; exit 2 ;;
        esac
        shift
    done
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
    local cmd="${1:-}"
    case "$cmd" in
        --help|-h)
            show_help
            ;;
        --clean|-c)
            shift
            parse_clean_args "$@"
            if [[ "$DRY_RUN" != "true" ]] && (( EUID != 0 )) && [[ -t 0 ]]; then
                # Cache sudo credentials upfront so cleanup doesn't prompt mid-run.
                sudo -v
                while sudo -n -v; do sleep 60; done &
                SUDO_KEEPALIVE_PID=$!
                trap 'kill "$SUDO_KEEPALIVE_PID" 2>/dev/null || true' EXIT
            fi
            do_cleanup
            ;;
        --preview)
            shift
            parse_clean_args "$@"
            DRY_RUN=true
            do_cleanup
            ;;
        --refresh|-r)
            refresh_cache
            ;;
        --quiet|-q)
            # Pure reader — never scans. If cache is missing or stale, stay silent.
            cache_is_readable || exit 0
            local disk_pct total
            disk_pct=$(sed -n '2p' "$CACHE_FILE")
            total=$(sed -n '3p' "$CACHE_FILE")
            if (( disk_pct >= 80 || total > 5368709120 )); then
                echo "!"
            fi
            ;;
        --dedupe)
            shift
            do_dedupe "$@"
            ;;
        "")
            show_suggestions
            ;;
        *)
            echo "Unknown command: $cmd" >&2
            show_help >&2
            exit 2
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
