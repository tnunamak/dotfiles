    # ----- Puppeteer Chrome versions (prune old, keep newest) -----
    if is_enabled puppeteer; then
        local s; s=$(cache_size_for puppeteer)
        if (( s > 0 )) && [[ -d "$HOME/.cache/puppeteer" ]]; then
            local prune_cmd='while IFS= read -r d; do [[ -n "$d" ]] && rm -rf "$d"; done < <(puppeteer_prune_dirs)'
            if maybe_run "Puppeteer Chrome (keep newest)" "$s" "$prune_cmd"; then
