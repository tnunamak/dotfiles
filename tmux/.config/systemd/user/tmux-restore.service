[Unit]
Description=tmux-resurrect restore (bypasses continuum race)
Documentation=file:///home/tnunamak/code/dotfiles/CLAUDE.md
After=tmux.service
# BindsTo + PartOf so this unit is re-activated whenever tmux.service
# (re)starts — including automatic recovery cycles, so a crashed tmux
# comes back populated instead of empty. The script itself decides whether
# restoring is appropriate (fresh empty tmux? restore. tmux with in-flight
# sessions? skip) — no time-based gating.
BindsTo=tmux.service
PartOf=tmux.service

[Service]
Type=oneshot
RemainAfterExit=no
TimeoutStartSec=10min
# Re-apply patches to tmux-assistant-resurrect's save script before restore
# runs. TPM auto-updates of the plugin can wipe these in-place sed patches,
# and without them the next continuum save records pane addresses against
# ephemeral grouped session names (main-N:N.0) that won't resolve at restore
# time. Idempotent — exits cleanly if patches are already applied.
ExecStartPre=-/home/tnunamak/.config/tmux/scripts/patch-assistant-resurrect.sh
ExecStart=/home/tnunamak/.config/tmux/scripts/systemd-restore.sh

[Install]
WantedBy=tmux.service
