#!/usr/bin/env bash
# File-only transaction bundles for tmux-resurrect state.
#
# This intentionally does not call tmux. It stages layout and assistant
# sidecar files together, verifies their hashes and counts, then atomically
# advances a last-good pointer only after the immutable bundle directory exists.
set -euo pipefail

RESURRECT_DIR="${TMUX_RESURRECT_DIR:-${HOME}/.tmux/resurrect}"
TRANSACTION_DIR="${RESURRECT_DIR}/transactions"
POINTER="${TRANSACTION_DIR}/last-good.json"
CLIFF_THRESHOLD_PCT="${TMUX_RESURRECT_SAVE_MIN_PCT:-${TMUX_RESURRECT_BUNDLE_MIN_PCT:-20}}"

usage() {
  cat >&2 <<'EOF'
usage:
  resurrect-transaction-bundle commit --layout FILE [--assistant FILE] [--desktop-manifest FILE] [--provenance TEXT] [--id ID]
  resurrect-transaction-bundle resolve

Environment:
  TMUX_RESURRECT_DIR                 default: $HOME/.tmux/resurrect
  XDG_STATE_HOME                     desktop layout state root
  TMUX_RESURRECT_SAVE_MIN_PCT        default: 20; tmux-service-stop exports 80
  TMUX_RESURRECT_BUNDLE_MIN_PCT      deprecated fallback if SAVE_MIN_PCT is unset
EOF
}

die() {
  printf 'ERROR: %s\n' "$*" >&2
  exit 1
}

need() {
  command -v "$1" >/dev/null 2>&1 || die "missing required command: $1"
}

fsync_path() {
  sync -f "$1" 2>/dev/null || die "fsync failed: $1"
}

sha256() {
  sha256sum "$1" | awk '{print $1}'
}

pane_count() {
  grep -c '^pane' "$1" 2>/dev/null || true
}

assistant_count() {
  jq -er '.sessions | length' "$1" 2>/dev/null || printf '0\n'
}

iso_now() {
  if [[ -n "${TMUX_RESURRECT_BUNDLE_NOW_ISO:-}" ]]; then
    printf '%s\n' "$TMUX_RESURRECT_BUNDLE_NOW_ISO"
  else
    date -u +%Y-%m-%dT%H:%M:%SZ
  fi
}

file_mtime_ns() {
  stat -c '%Y:%n' "$1" 2>/dev/null || printf 'unknown:%s\n' "$1"
}

component_filename() {
  local kind="$1" file="$2" base
  base="$(basename "$file")"
  printf '%s-%s\n' "$kind" "$base"
}

stable_id() {
  local layout="$1" assistant="${2:-}" seed
  seed="$(iso_now)|$(sha256 "$layout")|$(file_mtime_ns "$layout")"
  if [[ -n "$assistant" ]]; then
    seed="${seed}|$(sha256 "$assistant")|$(file_mtime_ns "$assistant")"
  fi
  printf 'bundle-%s\n' "$(printf '%s' "$seed" | sha256sum | awk '{print substr($1,1,16)}')"
}

validate_id() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "invalid bundle id: $1"
}

component_count() {
  local kind="$1" file="$2"
  case "$kind" in
    layout) pane_count "$file" ;;
    assistant) assistant_count "$file" ;;
    *) die "unknown component kind: $kind" ;;
  esac
}

desktop_state_dir() {
  printf '%s/desktop-layout\n' "${XDG_STATE_HOME:-$HOME/.local/state}"
}

desktop_manifest_default() {
  printf '%s/manifest.json\n' "$(desktop_state_dir)"
}

activation_desktop_manifest_path() {
  printf '%s/manifest.json\n' "$(desktop_state_dir)"
}

activation_native_session_path() {
  local file="$1"
  printf '%s/kitty-sessions/%s\n' "$(desktop_state_dir)" "$file"
}

safe_component_name() {
  local kind="$1" file="$2" hash="$3" base
  base="$(basename "$file")"
  base="${base//[^A-Za-z0-9._-]/_}"
  printf '%s-%s-%s\n' "$kind" "${hash:0:16}" "$base"
}

sidecar_identity_count() {
  local assistant="$1" provider="$2" session_id="$3" config_namespace="$4" pane="$5"
  jq -r \
    --arg provider "$provider" \
    --arg session_id "$session_id" \
    --arg config_namespace "$config_namespace" \
    --arg pane "$pane" \
    '[.sessions[]?
      | select(.tool == $provider)
      | select(.session_id == $session_id)
      | select((.env.CLAUDE_CONFIG_DIR? // "") == $config_namespace)
      | select(.pane == $pane)
    ] | length' "$assistant" 2>/dev/null || printf '0\n'
}

stage_no_desktop_receipt() {
  local stage="$1" reason="$2"
  jq -n --arg reason "$reason" \
    '{schema:"tmux-resurrect-transaction-bundle/desktop/v1",status:"not-bundled",reason:$reason}' \
    >"${stage}/desktop-none.json"
}

stage_desktop_component() {
  local stage="$1" manifest="$2" assistant="$3" assistant_hash="$4" assistant_activation_path="$5"
  local row provider session_id config_namespace pane pane_index row_index matches native_path native_hash native_name tmp native_map native_count manifest_name manifest_hash
  [[ -f "$manifest" ]] || { stage_no_desktop_receipt "$stage" "desktop manifest missing"; return 0; }
  tmp="${stage}/desktop-manifest.input.json"
  jq -S '.' "$manifest" >"$tmp" 2>/dev/null \
    || { stage_no_desktop_receipt "$stage" "desktop manifest incompatible"; return 0; }
  if [[ -n "${TMUX_RESURRECT_BUNDLE_AFTER_DESKTOP_COPY_HOOK:-}" ]]; then
    "$TMUX_RESURRECT_BUNDLE_AFTER_DESKTOP_COPY_HOOK" "$manifest" "$tmp"
  fi
  jq -e '.version == 2 and (.windows | type == "array")' "$tmp" >/dev/null 2>&1 \
    || { stage_no_desktop_receipt "$stage" "desktop manifest incompatible"; return 0; }
  [[ -f "$assistant" ]] || { stage_no_desktop_receipt "$stage" "assistant sidecar missing"; return 0; }

  while IFS= read -r row; do
    provider="$(jq -r '.identity_receipt.agent_identity.provider // empty' <<<"$row")"
    session_id="$(jq -r '.identity_receipt.agent_identity.assistant_session_id // empty' <<<"$row")"
    config_namespace="$(jq -r '.identity_receipt.agent_identity.config_namespace // empty' <<<"$row")"
    pane="$(jq -r '.identity_receipt.agent_identity.pane // empty' <<<"$row")"
    row_index="$(jq -r '.tmux_window_index // empty' <<<"$row")"
    if [[ -z "$provider" || -z "$session_id" || -z "$pane" || ! "$row_index" =~ ^[0-9]+$ ]]; then
      stage_no_desktop_receipt "$stage" "desktop agent receipt missing durable identity"
      return 0
    fi
    pane_index="$(sed -nE 's/^main(-[0-9]+)?:([0-9]+)\.[0-9]+$/\2/p' <<<"$pane")"
    if [[ "$pane_index" != "$row_index" ]]; then
      stage_no_desktop_receipt "$stage" "desktop agent receipt pane/index mismatch"
      return 0
    fi
    matches="$(sidecar_identity_count "$assistant" "$provider" "$session_id" "$config_namespace" "$pane")"
    if [[ "$matches" != 1 ]]; then
      stage_no_desktop_receipt "$stage" "desktop agent receipt not present exactly once in accepted assistant sidecar"
      return 0
    fi
  done < <(jq -c '.windows[] | select((.identity_receipt.assurance // "") == "agent-sidecar")' "$tmp")

  native_map="${stage}/desktop-native-map.json"
  printf '{}\n' >"$native_map"
  native_count=0
  while IFS= read -r native_path; do
    [[ -n "$native_path" && "$native_path" != "null" ]] || continue
    [[ -f "$native_path" ]] || { stage_no_desktop_receipt "$stage" "desktop native session missing"; return 0; }
    native_hash="$(sha256 "$native_path")"
    native_name="$(safe_component_name native "$native_path" "$native_hash")"
    if [[ ! -f "${stage}/${native_name}" ]]; then
      cp "$native_path" "${stage}/${native_name}"
    fi
    jq --arg src "$native_path" --arg file "$native_name" --arg hash "$native_hash" \
      --arg activation_path "$(activation_native_session_path "$native_name")" \
      '. + {($src): {file:$file, sha256:$hash, activation_path:$activation_path}}' "$native_map" >"${native_map}.tmp"
    mv "${native_map}.tmp" "$native_map"
    native_count=$((native_count + 1))
  done < <(jq -r '.windows[] | (.native_session // empty), (.identity_receipt.capture_metadata.native_session // empty)' "$tmp" | sort -u)

  tmp2="${tmp}.rebinding"
  jq \
    --arg path "$assistant_activation_path" \
    --arg hash "$assistant_hash" \
    --argjson native_map "$(cat "$native_map")" '
    .windows |= map(
      if ((.identity_receipt.assurance // "") == "agent-sidecar") then
        .identity_receipt.agent_identity.sidecar = {path:$path, sha256:$hash}
      else . end
      | if (.native_session // null) != null then
          .native_session = ($native_map[.native_session].activation_path // .native_session)
        else . end
      | if (.identity_receipt.capture_metadata.native_session // null) != null then
          .identity_receipt.capture_metadata.native_session =
            ($native_map[.identity_receipt.capture_metadata.native_session].activation_path // .identity_receipt.capture_metadata.native_session)
        else . end
    )' "$tmp" >"$tmp2"
  mv "$tmp2" "$tmp"

  manifest_hash="$(sha256 "$tmp")"
  manifest_name="$(safe_component_name desktop-manifest "$manifest" "$manifest_hash")"
  mv "$tmp" "${stage}/${manifest_name}"
  jq -n \
    --arg file "$manifest_name" \
    --arg hash "$manifest_hash" \
    --arg activation_path "$(activation_desktop_manifest_path)" \
    --argjson native_map "$(cat "$native_map")" \
    --argjson native_count "$native_count" \
    '{
      status:"bundled",
      file:$file,
      sha256:$hash,
      activation_path:$activation_path,
      native_sessions:($native_map | to_entries | map(.value + {source:.key})),
      native_count:$native_count
    }' >"${stage}/desktop-component.json"
}

previous_component_count() {
  local kind="$1"
  [[ -f "$POINTER" ]] || return 1
  jq -er --arg kind "$kind" '.components[$kind].count' "$POINTER" 2>/dev/null
}

reject_cliff() {
  local kind="$1" new_count="$2" old_count
  old_count="$(previous_component_count "$kind" || true)"
  [[ "$old_count" =~ ^[0-9]+$ ]] || return 0
  (( old_count > 0 )) || return 0
  if (( new_count * 100 < old_count * CLIFF_THRESHOLD_PCT )); then
    die "$kind count cliff rejected: previous=$old_count candidate=$new_count minimum=${CLIFF_THRESHOLD_PCT}%"
  fi
}

write_manifest() {
  local out="$1" id="$2" created_at="$3" provenance="$4" layout_name="$5" layout_hash="$6" layout_count="$7" assistant_name="${8:-}" assistant_hash="${9:-}" assistant_count_value="${10:-}"
  if [[ -n "$assistant_name" ]]; then
    jq -n \
      --arg id "$id" \
      --arg created_at "$created_at" \
      --arg provenance "$provenance" \
      --arg layout_name "$layout_name" \
      --arg layout_hash "$layout_hash" \
      --argjson layout_count "$layout_count" \
      --arg assistant_name "$assistant_name" \
      --arg assistant_hash "$assistant_hash" \
      --argjson assistant_count "$assistant_count_value" \
      '{
        schema: "tmux-resurrect-transaction-bundle/v1",
        id: $id,
        created_at: $created_at,
        provenance: $provenance,
        components: {
          layout: {file: $layout_name, sha256: $layout_hash, count: $layout_count},
          assistant: {file: $assistant_name, sha256: $assistant_hash, count: $assistant_count}
        }
      }' >"$out"
  else
    jq -n \
      --arg id "$id" \
      --arg created_at "$created_at" \
      --arg provenance "$provenance" \
      --arg layout_name "$layout_name" \
      --arg layout_hash "$layout_hash" \
      --argjson layout_count "$layout_count" \
      '{
        schema: "tmux-resurrect-transaction-bundle/v1",
        id: $id,
        created_at: $created_at,
        provenance: $provenance,
        components: {
          layout: {file: $layout_name, sha256: $layout_hash, count: $layout_count}
        }
      }' >"$out"
  fi
}

merge_desktop_manifest() {
  local manifest="$1" desktop_component="$2" no_desktop="$3"
  if [[ -f "$desktop_component" ]]; then
    jq -s '.[0].components.desktop = .[1] | .[0]' "$manifest" "$desktop_component" >"${manifest}.tmp"
  else
    jq -s '.[0].components.desktop = .[1] | .[0]' "$manifest" "$no_desktop" >"${manifest}.tmp"
  fi
  mv "${manifest}.tmp" "$manifest"
}

verify_bundle_dir() {
  local bundle_dir="$1" expected_id="${2:-}" manifest id kind file expected_hash actual_hash expected_count actual_count
  manifest="${bundle_dir}/bundle.json"
  [[ -f "$manifest" ]] || die "bundle manifest missing: $manifest"
  jq -e '.schema == "tmux-resurrect-transaction-bundle/v1" and (.id | type == "string") and (.components.layout.file | type == "string")' "$manifest" >/dev/null \
    || die "bundle manifest is invalid: $manifest"
  id="$(jq -r '.id' "$manifest")"
  if [[ -n "$expected_id" ]]; then
    [[ "$expected_id" == "$id" ]] || die "bundle id does not match expected id: $id"
  else
    [[ "$(basename "$bundle_dir")" == "$id" ]] || die "bundle id does not match directory: $id"
  fi

  while IFS= read -r kind; do
    file="$(jq -r --arg kind "$kind" '.components[$kind].file' "$manifest")"
    [[ "$file" != */* && -n "$file" && "$file" != "null" ]] || die "unsafe component filename for $kind"
    [[ -f "${bundle_dir}/${file}" ]] || die "component missing for $kind: $file"
    expected_hash="$(jq -r --arg kind "$kind" '.components[$kind].sha256' "$manifest")"
    actual_hash="$(sha256 "${bundle_dir}/${file}")"
    [[ "$actual_hash" == "$expected_hash" ]] || die "component hash mismatch for $kind"
    expected_count="$(jq -r --arg kind "$kind" '.components[$kind].count' "$manifest")"
    actual_count="$(component_count "$kind" "${bundle_dir}/${file}")"
    [[ "$actual_count" == "$expected_count" ]] || die "component count mismatch for $kind: expected=$expected_count actual=$actual_count"
  done < <(jq -r '.components | keys[] | select(. == "layout" or . == "assistant")' "$manifest")

  if jq -e '.components.desktop.status == "bundled"' "$manifest" >/dev/null 2>&1; then
    file="$(jq -r '.components.desktop.file' "$manifest")"
    [[ "$file" != */* && -n "$file" && "$file" != "null" ]] || die "unsafe desktop manifest filename"
    [[ -f "${bundle_dir}/${file}" ]] || die "desktop manifest component missing"
    expected_hash="$(jq -r '.components.desktop.sha256' "$manifest")"
    actual_hash="$(sha256 "${bundle_dir}/${file}")"
    [[ "$actual_hash" == "$expected_hash" ]] || die "desktop manifest hash mismatch"
    while IFS= read -r row; do
      file="$(jq -r '.file' <<<"$row")"
      [[ "$file" != */* && -n "$file" && "$file" != "null" ]] || die "unsafe desktop native session filename"
      [[ -f "${bundle_dir}/${file}" ]] || die "desktop native session component missing"
      expected_hash="$(jq -r '.sha256' <<<"$row")"
      actual_hash="$(sha256 "${bundle_dir}/${file}")"
      [[ "$actual_hash" == "$expected_hash" ]] || die "desktop native session hash mismatch"
    done < <(jq -c '.components.desktop.native_sessions[]?' "$manifest")
  fi
}

commit_bundle() {
  local layout="" assistant="" desktop_manifest="" provenance="manual" id="" arg
  while (($#)); do
    arg="$1"; shift
    case "$arg" in
      --layout) layout="${1:-}"; shift || true ;;
      --assistant) assistant="${1:-}"; shift || true ;;
      --desktop-manifest) desktop_manifest="${1:-}"; shift || true ;;
      --provenance) provenance="${1:-}"; shift || true ;;
      --id) id="${1:-}"; shift || true ;;
      *) usage; die "unknown argument: $arg" ;;
    esac
  done

  need jq
  need sha256sum
  need sync
  [[ -f "$layout" ]] || die "layout file missing"
  if [[ -n "$assistant" ]]; then
    [[ -f "$assistant" ]] || die "assistant file missing"
    jq -e '.sessions | type == "array"' "$assistant" >/dev/null || die "assistant sidecar must contain a sessions array"
  fi

  mkdir -p "$TRANSACTION_DIR"
  local layout_count_value assistant_count_value layout_hash assistant_hash created_at stage final layout_name assistant_name pointer_tmp
  layout_count_value="$(pane_count "$layout")"
  [[ "$layout_count_value" =~ ^[0-9]+$ ]] || die "layout pane count is not numeric"
  reject_cliff layout "$layout_count_value"

  layout_hash="$(sha256 "$layout")"
  layout_name="$(component_filename layout "$layout")"
  created_at="$(iso_now)"
  if [[ -n "$assistant" ]]; then
    assistant_count_value="$(assistant_count "$assistant")"
    [[ "$assistant_count_value" =~ ^[0-9]+$ ]] || die "assistant session count is not numeric"
    reject_cliff assistant "$assistant_count_value"
    assistant_hash="$(sha256 "$assistant")"
    assistant_name="$(component_filename assistant "$assistant")"
  fi
  id="${id:-$(stable_id "$layout" "$assistant")}"
  validate_id "$id"
  final="${TRANSACTION_DIR}/${id}"
  [[ ! -e "$final" ]] || die "bundle already exists: $id"
  stage="$(mktemp -d "${TRANSACTION_DIR}/.staging.${id}.XXXXXX")"
  trap 'rm -rf "$stage"' RETURN

  cp "$layout" "${stage}/${layout_name}"
  if [[ -n "$assistant" ]]; then
    cp "$assistant" "${stage}/${assistant_name}"
    write_manifest "${stage}/bundle.json" "$id" "$created_at" "$provenance" "$layout_name" "$layout_hash" "$layout_count_value" "$assistant_name" "$assistant_hash" "$assistant_count_value"
  else
    write_manifest "${stage}/bundle.json" "$id" "$created_at" "$provenance" "$layout_name" "$layout_hash" "$layout_count_value"
  fi
  if [[ -n "$assistant" ]]; then
    desktop_manifest="${desktop_manifest:-$(desktop_manifest_default)}"
    stage_desktop_component "$stage" "$desktop_manifest" "$assistant" "$assistant_hash" "${RESURRECT_DIR}/assistant-sessions.json"
    merge_desktop_manifest "${stage}/bundle.json" "${stage}/desktop-component.json" "${stage}/desktop-none.json"
  fi
  verify_bundle_dir "$stage" "$id"
  fsync_path "${stage}/${layout_name}"
  if [[ -n "${assistant_name:-}" ]]; then
    fsync_path "${stage}/${assistant_name}"
  fi
  if [[ -f "${stage}/desktop-component.json" ]]; then
    desktop_file="$(jq -r '.file' "${stage}/desktop-component.json")"
    fsync_path "${stage}/${desktop_file}"
    while IFS= read -r desktop_native_file; do
      fsync_path "${stage}/${desktop_native_file}"
    done < <(jq -r '.native_sessions[]?.file' "${stage}/desktop-component.json")
  fi
  fsync_path "${stage}/bundle.json"
  fsync_path "$stage"
  mv "$stage" "$final"
  fsync_path "$TRANSACTION_DIR"
  chmod -R a-w "$final" 2>/dev/null || true
  fsync_path "$final"

  pointer_tmp="$(mktemp "${TRANSACTION_DIR}/.last-good.XXXXXX")"
  jq -c '{schema,id,created_at,provenance,components}' "${final}/bundle.json" >"$pointer_tmp"
  fsync_path "$pointer_tmp"
  mv "$pointer_tmp" "$POINTER"
  fsync_path "$POINTER"
  fsync_path "$TRANSACTION_DIR"
  printf '%s\n' "$final"
}

resolve_bundle() {
  need jq
  [[ -f "$POINTER" ]] || die "last-good pointer missing"
  jq -e '.schema == "tmux-resurrect-transaction-bundle/v1" and (.id | type == "string")' "$POINTER" >/dev/null \
    || die "last-good pointer is invalid"
  local id bundle_dir pointer_components manifest_components
  id="$(jq -r '.id' "$POINTER")"
  validate_id "$id"
  bundle_dir="${TRANSACTION_DIR}/${id}"
  [[ -d "$bundle_dir" ]] || die "last-good bundle directory missing: $id"
  verify_bundle_dir "$bundle_dir"
  pointer_components="$(jq -c '.components' "$POINTER")"
  manifest_components="$(jq -c '.components' "${bundle_dir}/bundle.json")"
  [[ "$pointer_components" == "$manifest_components" ]] || die "last-good pointer does not match bundle manifest"
  jq -c --arg path "$bundle_dir" '. + {path: $path}' "${bundle_dir}/bundle.json"
}

cmd="${1:-}"
shift || true
case "$cmd" in
  commit) commit_bundle "$@" ;;
  resolve) resolve_bundle "$@" ;;
  -h|--help|help) usage ;;
  *) usage; exit 2 ;;
esac
