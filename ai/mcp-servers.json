{
  "agents": {
    "codex": {},
    "claude": {
      "scope": "user"
    },
    "gemini": {
      "scope": "user"
    },
    "daisy": {
      "reconciler": "~/applications/daisy/scripts/reconcile-pi-mcp",
      "target": "~/applications/daisy/.pi/mcp.json"
    }
  },
  "legacyServerNames": [
    "amplitude",
    "searxng-test"
  ],
  "servers": {
    "codex-cli": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "codex-mcp-server"
      ],
      "agents": [
        "claude",
        "gemini"
      ],
      "reason": "Bridge for non-Codex agents; circular/useless in Codex itself."
    },
    "excalidraw": {
      "transport": "http",
      "url": "https://mcp.excalidraw.com",
      "agents": [
        "codex",
        "claude",
        "gemini"
      ]
    },
    "linear": {
      "transport": "http",
      "url": "https://mcp.linear.app/mcp",
      "auth": {
        "bearerTokenEnv": "LINEAR_API_KEY"
      },
      "agents": [
        "codex",
        "claude",
        "gemini"
      ]
    },
    "pdpp": {
      "transport": "http",
      "url": "https://pdpp.vivid.fish/mcp",
      "agents": [
        "codex",
        "claude",
        "gemini"
      ],
      "reason": "Grant-scoped OAuth at /mcp (no owner bearer; owner token is REST-only and 403s here). First connect per agent does a one-time browser approval, then reconnects silently."
    },
    "playwright": {
      "transport": "http",
      "url": "http://127.0.0.1:3100/mcp",
      "agents": [
        "codex",
        "claude",
        "gemini"
      ]
    },
    "searxng": {
      "transport": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://searxng.home"
      },
      "agents": [
        "codex",
        "claude",
        "gemini",
        "daisy"
      ]
    },
    "vana-knowledge-base": {
      "transport": "http",
      "url": "https://vana-knowledge-mcp.vana.workers.dev/mcp",
      "auth": {
        "bearerTokenEnv": "VANA_KB_TOKEN"
      },
      "agents": [
        "codex",
        "claude",
        "gemini"
      ]
    },
    "google-workspace": {
      "transport": "stdio",
      "command": "workspace-mcp",
      "args": [
        "--single-user",
        "--tools",
        "slides",
        "drive",
        "docs"
      ],
      "env": {
        "GOOGLE_CLIENT_SECRET_PATH": "/home/tnunamak/.config/gogcli/client_secret_432753364585-pags30i1jc73ccco315b5qqvfqjsonn3.apps.googleusercontent.com.json",
        "GOOGLE_MCP_CREDENTIALS_DIR": "/home/tnunamak/.config/workspace-mcp/credentials",
        "USER_GOOGLE_EMAIL": "tim@opendatalabs.xyz",
        "OAUTHLIB_INSECURE_TRANSPORT": "1"
      },
      "agents": [
        "claude",
        "codex",
        "gemini"
      ],
      "reason": "Slides/Docs/Drive text-level read and write; gog covers slide-level operations but cannot edit text inside shapes."
    }
  }
}
