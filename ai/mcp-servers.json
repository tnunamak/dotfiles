{
  "codex": {
    "servers": {
      "playwright": {
        "url": "http://127.0.0.1:3100"
      },
      "linear": {
        "url": "https://mcp.linear.app/mcp",
        "bearer_token_env_var": "LINEAR_API_KEY"
      },
      "vana-knowledge-base": {
        "url": "https://vana-knowledge-mcp.vana.workers.dev/mcp",
        "bearer_token_env_var": "VANA_KB_TOKEN"
      }
    }
  },
  "claude": {
    "servers": {
      "codex-cli": {
        "scope": "user",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "codex-mcp-server"
        ]
      },
      "linear": {
        "scope": "user",
        "transport": "http",
        "url": "https://mcp.linear.app/mcp",
        "header_env_var": "LINEAR_API_KEY"
      },
      "vana-knowledge-base": {
        "scope": "user",
        "transport": "http",
        "url": "https://vana-knowledge-mcp.vana.workers.dev/mcp",
        "header_env_var": "VANA_KB_TOKEN"
      }
    }
  },
  "gemini": {
    "servers": {
      "codex-cli": {
        "scope": "user",
        "transport": "stdio",
        "command": "npx",
        "args": [
          "-y",
          "codex-mcp-server"
        ]
      },
      "linear": {
        "scope": "user",
        "transport": "http",
        "url": "https://mcp.linear.app/mcp",
        "header_env_var": "LINEAR_API_KEY"
      },
      "vana-knowledge-base": {
        "scope": "user",
        "transport": "http",
        "url": "https://vana-knowledge-mcp.vana.workers.dev/mcp",
        "header_env_var": "VANA_KB_TOKEN"
      }
    }
  }
}
