{
  "security": {
    "auth": {
      "selectedType": "oauth-personal"
    }
  },
  "general": {
    "sessionRetention": {
      "enabled": true,
      "maxAge": "30d",
      "warningAcknowledged": true
    },
    "enableAutoUpdate": false
  },
  "mcpServers": {
    "codex-cli": {
      "command": "npx",
      "args": [
        "-y",
        "codex-mcp-server"
      ]
    },
    "excalidraw": {
      "url": "https://mcp.excalidraw.com",
      "type": "http"
    },
    "linear": {
      "url": "https://mcp.linear.app/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      }
    },
    "pdpp": {
      "url": "https://pdpp.vivid.fish/mcp",
      "type": "http"
    },
    "playwright": {
      "url": "http://127.0.0.1:3100",
      "type": "http"
    },
    "searxng": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-searxng"
      ],
      "env": {
        "SEARXNG_URL": "http://searxng.home"
      }
    },
    "vana-knowledge-base": {
      "url": "https://vana-knowledge-mcp.vana.workers.dev/mcp",
      "type": "http",
      "headers": {
        "Authorization": "Bearer ${VANA_KB_TOKEN}"
      }
    }
  },
  "hooks": {
    "AfterTool": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.local/bin/research-capture-detect' 2>/dev/null"
          }
        ]
      }
    ],
    "PreCompress": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.local/bin/research-capture-nudge' 2>/dev/null"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/home/tnunamak/.local/bin/ds-update-check' 2>/dev/null"
          }
        ]
      }
    ]
  }
}