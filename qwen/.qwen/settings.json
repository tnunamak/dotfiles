{
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "$version": 4,
  "ui": {
    "autoModeAcknowledged": true,
    "enableUserFeedback": false
  },
  "mcpServers": {
    "codex-cli": {
      "command": "npx",
      "args": ["-y", "codex-mcp-server"]
    },
    "excalidraw": {
      "httpUrl": "https://mcp.excalidraw.com"
    },
    "linear": {
      "httpUrl": "https://mcp.linear.app/mcp",
      "headers": {
        "Authorization": "Bearer ${LINEAR_API_KEY}"
      }
    },
    "pdpp": {
      "httpUrl": "https://pdpp.vivid.fish/mcp"
    },
    "playwright": {
      "httpUrl": "http://127.0.0.1:3100/mcp"
    },
    "searxng": {
      "command": "npx",
      "args": ["-y", "mcp-searxng"],
      "env": {
        "SEARXNG_URL": "http://searxng.home"
      }
    },
    "vana-knowledge-base": {
      "httpUrl": "https://vana-knowledge-mcp.vana.workers.dev/mcp",
      "headers": {
        "Authorization": "Bearer ${VANA_KB_TOKEN}"
      }
    }
  },
