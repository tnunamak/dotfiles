+bool common_speculative_commit_mtp_replay(common_speculative * spec, llama_seq_id seq_id) {
+    if (spec == nullptr) {
+        return false;
+    }
+
+    bool committed = false;
+    for (auto & impl : spec->impls) {
+        if (impl->type == COMMON_SPECULATIVE_TYPE_DRAFT_MTP) {
+            committed = static_cast<common_speculative_impl_draft_mtp *>(impl.get())->commit_replayed_prefix(seq_id) || committed;
+        }
+    }
+    return committed;
+}
+
+bool common_mtp_select_pending_hidden_row(
+        std::vector<float>       & pending_h,
+        const std::vector<float> & verify_h,
+        int32_t                    verify_h_rows,
+        int32_t                    n_embd,
+        int32_t                    row) {
+    if (verify_h_rows <= 0 || n_embd <= 0 || row < 0 || row >= verify_h_rows ||
+            (int32_t) pending_h.size() != n_embd ||
+            verify_h.size() != (size_t) verify_h_rows * n_embd) {
+        return false;
+    }
+
+    std::memcpy(pending_h.data(), verify_h.data() + (size_t) row * n_embd, (size_t) n_embd * sizeof(float));
+    return true;
+}
+
+bool common_mtp_copy_pending_hidden(
+        const std::vector<float> & pending_h,
+        float                    * dst,
+        int32_t                    n_embd) {
+    if (dst == nullptr || n_embd <= 0 || (int32_t) pending_h.size() != n_embd) {
+        return false;
+    }
+
+    std::memcpy(dst, pending_h.data(), (size_t) n_embd * sizeof(float));
+    return true;
+}
+
