--- /dev/null
+++ b/tests/test-mtp-loop-guard-rollback.cpp
@@ -0,0 +1,131 @@
+#include "reasoning-budget.h"
+
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+static std::string read_file(const std::string & path) {
+    std::ifstream file(path);
+    if (!file.good()) {
+        std::fprintf(stderr, "failed to open %s\n", path.c_str());
+        std::exit(1);
+    }
+
+    std::ostringstream ss;
+    ss << file.rdbuf();
+    return ss.str();
+}
+
+static void expect(bool ok, const char * message) {
+    if (!ok) {
+        std::fprintf(stderr, "%s\n", message);
+        std::exit(1);
+    }
+}
+
+enum rollback_action {
+    ROLLBACK_RETRY,
+    ROLLBACK_REPLAY_COMMITTED_ACCEPT,
+};
+
+static rollback_action mtp_rollback_action(bool loop_guard_control_changed) {
+    return loop_guard_control_changed ? ROLLBACK_REPLAY_COMMITTED_ACCEPT : ROLLBACK_RETRY;
+}
+
+static rollback_action mtp_checkpoint_rollback_action(
+        bool full_checkpoint, bool bounded_checkpoint, int n_rollback, int n_rs_seq,
+        bool loop_guard_control_changed) {
+    const bool uses_checkpoint = full_checkpoint || (bounded_checkpoint && n_rollback > n_rs_seq);
+    return uses_checkpoint ? mtp_rollback_action(loop_guard_control_changed) : ROLLBACK_RETRY;
+}
+
+static bool speculation_allowed(common_reasoning_budget_state state) {
+    return state != REASONING_BUDGET_FORCING;
+}
+
+static void test_force_close_replay_reaches_done_and_visible_progress() {
+    const std::vector<llama_token> forced = { 102, 101 };
+    auto * sampler = common_reasoning_budget_init(
+        nullptr, { 100 }, { 101 }, forced, 8, REASONING_BUDGET_COUNTING);
+
+    // The triggering MTP row was accepted before its callback returned false.
+    const llama_token triggering = 50;
+    const bool callback_accept_more = false;
+    llama_sampler_accept(sampler, triggering);
+    expect(common_reasoning_budget_force_end(sampler), "force-close must start the forced sequence");
+    expect(!callback_accept_more, "loop-guard callback must stop the MTP accept loop after the triggering row");
+    expect(mtp_rollback_action(true) == ROLLBACK_REPLAY_COMMITTED_ACCEPT,
+           "callback-induced force-close must replay the committed accepted prefix");
+    expect(mtp_checkpoint_rollback_action(true, false, 4, 0, true) == ROLLBACK_REPLAY_COMMITTED_ACCEPT,
+           "FULL checkpoint rollback must replay a committed loop-guard transition");
+    expect(mtp_checkpoint_rollback_action(false, true, 4, 2, true) == ROLLBACK_REPLAY_COMMITTED_ACCEPT,
+           "long RS checkpoint rollback must replay a committed loop-guard transition");
+    expect(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_FORCING,
+           "checkpoint rollback must not undo force-close");
+    expect(!speculation_allowed(common_reasoning_budget_get_state(sampler)),
+           "MTP speculation must stay blocked while the forced sequence is active");
+
+    std::vector<llama_token> output = { triggering };
+    expect(common_reasoning_budget_next_forced_token(sampler) == forced[0],
+           "forcing must block another speculative verify before its first ordinary token");
+    llama_sampler_accept(sampler, forced[0]);
+    output.push_back(forced[0]);
+    expect(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_FORCING,
+           "the first forced token must not finish a two-token forced sequence");
+
+    expect(common_reasoning_budget_next_forced_token(sampler) == forced[1],
+           "ordinary decoding must advance to the final forced token exactly once");
+    llama_sampler_accept(sampler, forced[1]);
+    output.push_back(forced[1]);
+    expect(common_reasoning_budget_get_state(sampler) == REASONING_BUDGET_DONE,
+           "the final forced token must commit DONE");
+    expect(speculation_allowed(common_reasoning_budget_get_state(sampler)),
+           "ordinary generation may resume only after the forced sequence reaches DONE");
+
+    output.push_back(200); // ordinary visible generation after DONE
+    expect(output == std::vector<llama_token>({ triggering, 102, 101, 200 }),
+           "force-close replay must preserve token progress and resume visible output");
+
+    llama_sampler_free(sampler);
+}
+
+static void test_stop_replay_terminates_and_ordinary_rollback_stays_a_retry() {
+    const llama_token triggering = 50;
+    const bool stop = true;
+
+    expect(mtp_rollback_action(stop) == ROLLBACK_REPLAY_COMMITTED_ACCEPT,
+           "loop-guard stop must commit its accepted triggering token before termination");
+    const std::vector<llama_token> output = { triggering };
+    expect(output.size() == 1 && stop,
+           "stop mode must emit only the committed triggering token and terminate");
+
+    expect(mtp_rollback_action(false) == ROLLBACK_RETRY,
+           "ordinary MTP partial acceptance must retain the existing rollback-and-retry path");
+}
+
+static void test_server_wires_replay_only_to_non_dflash_mtp(const std::string & server_context) {
+    expect(server_context.find("bool mtp_committed_accept_replay = false;") != std::string::npos,
+           "MTP must record a committed callback accept separately from an ordinary rollback");
+    expect(server_context.find("params_base.speculative.type() != COMMON_SPECULATIVE_TYPE_DFLASH &&\n                slot.mtp_committed_accept_replay") != std::string::npos,
+           "committed replay scheduling must be restricted to non-DFlash MTP");
+    expect(server_context.find("if (loop_guard_control_changed) {") != std::string::npos &&
+           server_context.find("slot.mtp_committed_accept_replay = true;") != std::string::npos,
+           "MTP checkpoint rollback must preserve callback-induced loop-guard control transitions");
+    expect(server_context.find("const int i_last = slot.spec_i_batch.back();") != std::string::npos &&
+           server_context.find("common_sampler_sample(slot.smpl.get(), slot.ctx_tgt, i_last)") != std::string::npos,
+           "committed prefix replay must sample the next forced token after the restored context catches up");
+    expect(server_context.find("} else {\n                                slot.smpl = std::move(smpl_save);") != std::string::npos,
+           "ordinary MTP rollback must continue restoring the sampler snapshot");
+}
+
+int main(int argc, char ** argv) {
+    expect(argc == 2, "expected repo root argument");
+
+    test_force_close_replay_reaches_done_and_visible_progress();
+    test_stop_replay_terminates_and_ordinary_rollback_stays_a_retry();
+    test_server_wires_replay_only_to_non_dflash_mtp(read_file(std::string(argv[1]) + "/tools/server/server-context.cpp"));
+    return 0;
+}
