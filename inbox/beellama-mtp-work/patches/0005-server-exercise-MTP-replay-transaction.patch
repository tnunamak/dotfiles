+#pragma once
+
+#include "common.h"
+
+#include <cstdint>
+
+// The value-side of an MTP checkpoint rollback whose sampler callback already
+// committed a loop-guard transition. Context restore remains in server_context;
+// this state machine keeps its replay, position, output, and release effects
+// coupled to that restore.
+struct server_mtp_replay_checkpoint {
+    common_context_seq_rm_type seq_rm_type = COMMON_CONTEXT_SEQ_RM_TYPE_NO;
+    int64_t n_rollback = 0;
+    int64_t n_rs_seq = 0;
+    bool is_mtp = false;
+    bool is_dflash = false;
+    bool loop_guard_control_changed = false;
+    int64_t checkpoint_tokens = 0;
+    uint16_t replay_tokens = 0;
+};
+
+enum server_mtp_replay_finish {
+    SERVER_MTP_REPLAY_FINISH_INVALID,
+    SERVER_MTP_REPLAY_FINISH_SAMPLE_NEXT,
+    SERVER_MTP_REPLAY_FINISH_RELEASE,
+};
+
+class server_mtp_replay {
+public:
+    // Arms a single replay only for a checkpoint-restored, non-DFlash MTP
+    // rollback whose callback changed loop-guard control state.
+    bool arm(const server_mtp_replay_checkpoint & checkpoint);
+
+    // Replays are scheduled even when forcing made the normal draft limit zero.
+    bool should_schedule(int32_t n_draft_max) const;
+
+    // update_batch() must have appended the prior sampled token and the replay
+    // prefix before replay output can be emitted.
+    bool context_replayed(int64_t prompt_tokens);
+
+    uint16_t accepted_draft_tokens() const;
+    bool record_output();
+    server_mtp_replay_finish finish(bool stop);
+
+    bool is_pending() const;
+    bool is_emitting() const;
+
+    void clear();
+
+private:
+    enum phase {
+        IDLE,
+        PENDING_CONTEXT_REPLAY,
+        EMITTING_REPLAY,
+        RELEASED,
+    } phase_ = IDLE;
+
+    int64_t checkpoint_tokens_ = 0;
+    uint16_t replay_tokens_ = 0;
+    uint16_t emitted_tokens_ = 0;
+};
