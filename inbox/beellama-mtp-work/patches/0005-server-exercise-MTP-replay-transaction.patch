+bool server_mtp_replay_uses_checkpoint(const server_mtp_replay_checkpoint & checkpoint) {
+    return checkpoint.seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_FULL ||
+            (checkpoint.seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_RS &&
+             checkpoint.n_rollback > checkpoint.n_rs_seq);
+}
+
+} // namespace
+
+bool server_mtp_replay::arm(const server_mtp_replay_checkpoint & checkpoint) {
+    if (phase_ != IDLE || !checkpoint.is_mtp || checkpoint.is_dflash ||
+            !checkpoint.loop_guard_control_changed || checkpoint.n_rollback <= 0 ||
+            checkpoint.checkpoint_tokens < 0 || checkpoint.replay_tokens == 0 ||
+            !server_mtp_replay_uses_checkpoint(checkpoint)) {
+        return false;
+    }
+
+    checkpoint_tokens_ = checkpoint.checkpoint_tokens;
+    replay_tokens_ = checkpoint.replay_tokens;
+    emitted_tokens_ = 0;
+    phase_ = PENDING_CONTEXT_REPLAY;
+    return true;
+}
+
+bool server_mtp_replay::should_schedule(int32_t n_draft_max) const {
+    return n_draft_max > 0 || phase_ == PENDING_CONTEXT_REPLAY;
+}
+
+bool server_mtp_replay::context_replayed(int64_t prompt_tokens) {
+    if (phase_ != PENDING_CONTEXT_REPLAY ||
+            prompt_tokens != checkpoint_tokens_ + 1 + replay_tokens_) {
+        return false;
+    }
+
+    phase_ = EMITTING_REPLAY;
+    return true;
+}
+
+uint16_t server_mtp_replay::accepted_draft_tokens() const {
+    return replay_tokens_ > 0 ? replay_tokens_ - 1 : 0;
+}
+
+bool server_mtp_replay::record_output() {
+    if (phase_ != EMITTING_REPLAY || emitted_tokens_ >= replay_tokens_) {
+        return false;
+    }
+
+    ++emitted_tokens_;
+    return true;
+}
+
+server_mtp_replay_finish server_mtp_replay::finish(bool stop) {
+    if (phase_ != EMITTING_REPLAY) {
+        return SERVER_MTP_REPLAY_FINISH_INVALID;
+    }
+
+    if (stop) {
+        phase_ = RELEASED;
+        return SERVER_MTP_REPLAY_FINISH_RELEASE;
+    }
+
+    if (emitted_tokens_ != replay_tokens_) {
+        return SERVER_MTP_REPLAY_FINISH_INVALID;
+    }
+
+    clear();
+    return SERVER_MTP_REPLAY_FINISH_SAMPLE_NEXT;
+}
+
+bool server_mtp_replay::is_pending() const {
+    return phase_ == PENDING_CONTEXT_REPLAY;
+}
+
+bool server_mtp_replay::is_emitting() const {
+    return phase_ == EMITTING_REPLAY;
+}
+
+void server_mtp_replay::clear() {
+    phase_ = IDLE;
+    checkpoint_tokens_ = 0;
+    replay_tokens_ = 0;
+    emitted_tokens_ = 0;
+}
