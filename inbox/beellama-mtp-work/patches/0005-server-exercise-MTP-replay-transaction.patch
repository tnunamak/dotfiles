+static void test_ordinary_rollback_dflash_and_stop() {
+    server_mtp_replay ordinary_rollback;
+    auto ordinary = committed_checkpoint(COMMON_CONTEXT_SEQ_RM_TYPE_FULL, 1, 0);
+    ordinary.loop_guard_control_changed = false;
+    assert(!ordinary_rollback.arm(ordinary));
+    assert(!ordinary_rollback.should_schedule(0));
+    assert(ordinary_rollback.should_schedule(1));
+
+    server_mtp_replay short_rs_rollback;
+    assert(!short_rs_rollback.arm(committed_checkpoint(COMMON_CONTEXT_SEQ_RM_TYPE_RS, 2, 2)));
+
+    server_mtp_replay dflash;
+    auto dflash_checkpoint = committed_checkpoint(COMMON_CONTEXT_SEQ_RM_TYPE_FULL, 1, 0);
+    dflash_checkpoint.is_dflash = true;
+    assert(!dflash.arm(dflash_checkpoint));
+
+    server_mtp_replay stop_replay;
+    assert(stop_replay.arm(committed_checkpoint(COMMON_CONTEXT_SEQ_RM_TYPE_FULL, 1, 0)));
+    assert(stop_replay.context_replayed(13));
+    assert(stop_replay.record_output());
+    assert(stop_replay.finish(true) == SERVER_MTP_REPLAY_FINISH_RELEASE);
+    assert(!stop_replay.should_schedule(0));
+    assert(!stop_replay.record_output());
+}
