-#include "server-queue.h"
-
-#undef NDEBUG
-#include <cassert>
-
-static void test_cancel_stops_after_the_current_sub_batch_and_keeps_release_in_the_queue() {
-    server_queue queue;
-    int n_decoded_sub_batches = 0;
-    int released_task_id = -1;
-    int n_update_calls = 0;
-
-    queue.on_new_task([&](server_task && task) {
-        if (task.type == SERVER_TASK_TYPE_CANCEL) {
-            // This mirrors server_context_impl::process_single_task(): queue processing
-            // owns cancellation release, not the decode checkpoint.
-            released_task_id = task.id_target;
-        }
-    });
-    queue.on_update_slots([&]() {
-        ++n_update_calls;
-        if (n_update_calls > 1) {
-            queue.terminate();
-            return;
-        }
-
-        for (int sub_batch = 0; sub_batch < 2; ++sub_batch) {
-            ++n_decoded_sub_batches;
-
-            if (sub_batch == 0) {
-                server_task cancel(SERVER_TASK_TYPE_CANCEL);
-                cancel.id = queue.get_new_id();
-                cancel.id_target = 42;
-                queue.post(std::move(cancel), true);
-            }
-
-            // Mirrors the completed-sub-batch checkpoint in update_slots().
-            if (queue.has_pending_high_priority_cancel()) {
-                break;
-            }
-        }
-    });
-
-    assert(!queue.has_pending_high_priority_cancel());
-
-    server_task work(SERVER_TASK_TYPE_COMPLETION);
-    work.id = 42;
-    queue.post(std::move(work));
-    queue.start_loop();
-
-    assert(n_decoded_sub_batches == 1);
-    assert(released_task_id == 42);
-    assert(!queue.has_pending_high_priority_cancel());
-}
-
-int main() {
-    test_cancel_stops_after_the_current_sub_batch_and_keeps_release_in_the_queue();
-}
