diff --git a/tools/server/server-mtp-replay.cpp b/tools/server/server-mtp-replay.cpp
index a1417b809..ba0c494cd 100644
--- a/tools/server/server-mtp-replay.cpp
+++ b/tools/server/server-mtp-replay.cpp
@@ -29,6 +29,21 @@ bool server_mtp_replay::should_schedule(int32_t n_draft_max) const {
     return n_draft_max > 0 || phase_ == PENDING_CONTEXT_REPLAY;
 }
 
+bool server_mtp_replay::apply_draft_limit(
+        llama_tokens       & draft,
+        std::vector<float> & draft_log_probs,
+        int32_t              n_draft_max) const {
+    if (phase_ == PENDING_CONTEXT_REPLAY || draft.size() <= (size_t) n_draft_max) {
+        return false;
+    }
+
+    draft.resize(n_draft_max);
+    if (draft_log_probs.size() > (size_t) n_draft_max) {
+        draft_log_probs.resize(n_draft_max);
+    }
+    return true;
+}
+
 bool server_mtp_replay::context_replayed(int64_t prompt_tokens) {
     if (phase_ != PENDING_CONTEXT_REPLAY ||
             prompt_tokens != checkpoint_tokens_ + 1 + replay_tokens_) {
