     void create_checkpoint(server_slot & slot, const int64_t n_tokens_cur, llama_pos pos_min, llama_pos pos_max) {
         const int id_task = slot.task->id;
 
-        // evict checkpoints within min-step of a previous checkpoint, unless they were
-        // created by the current task
-        int64_t last = -1;
-        for (auto it = slot.prompt.checkpoints.begin(); it != slot.prompt.checkpoints.end(); ) {
-            if (it->id_task != id_task && last >= 0 && it->n_tokens <= last + params_base.checkpoint_min_step) {
-                SLT_TRC(slot, "erasing context checkpoint too close to an earlier one (pos_min = %d, pos_max = %d, n_tokens = %" PRId64 ", size = %.3f MiB)\n",
-                        it->pos_min, it->pos_max, it->n_tokens, (float) it->size() / 1024 / 1024);
-
-                it = slot.prompt.checkpoints.erase(it);
-                continue;
-            }
-
-            last = it->n_tokens;
-            ++it;
+        // Do not let prior tasks consume the checkpoint cap with near-duplicates.
+        for (const auto & cur : slot.prompt.take_stale_checkpoints_within_min_step(
+                id_task, params_base.checkpoint_min_step)) {
+            SLT_TRC(slot, "erasing context checkpoint too close to an earlier one (pos_min = %d, pos_max = %d, n_tokens = %" PRId64 ", size = %.3f MiB)\n",
+                    cur.pos_min, cur.pos_max, cur.n_tokens, (float) cur.size() / 1024 / 1024);
         }
 
         while (slot.prompt.checkpoints.size() >= (size_t) params_base.n_ctx_checkpoints) {
@@ -5551,10 +5542,12 @@ private:
 
                         slot.n_prompt_tokens_processed++;
 
-                        // Stop before the latest user input only when this request can create
-                        // a checkpoint. A no-checkpoint request should not fragment its prefill.
-                        if (do_checkpoint && n_before_user_known &&
-                            slot.prompt.n_tokens() == n_before_user) {
+                        // Stop at a user boundary only when it creates a useful checkpoint.
+                        const bool is_user_start = n_before_user_known &&
+                            slot.prompt.n_tokens() == n_before_user;
+                        if (slot.prompt.should_split_prompt_batch_at_user_start(
+                                do_checkpoint, is_user_start, is_user_start,
+                                slot.prompt.n_tokens(), params_base.checkpoint_min_step)) {
                             break;
                         }
 
@@ -5649,7 +5642,7 @@ private:
                     // at the latest user boundary or near the prompt end.
                     do_checkpoint = do_checkpoint && (
                             slot.prompt.checkpoints.empty() ||
-                            is_on_user || near_prompt_end ||
+                            (n_before_user_known && n_tokens_start == n_before_user) || near_prompt_end ||
                             n_tokens_start > slot.prompt.checkpoints.back().n_tokens + params_base.checkpoint_min_step);
                     SLT_DBG(slot, "main/do_checkpoint = %s, pos_min = %d, pos_max = %d\n", do_checkpoint ? "yes" : "no", pos_min, pos_max);
 
diff --git a/tools/server/server-task.h b/tools/server/server-task.h
index 8021d2c09..3fa87b5dc 100644
--- a/tools/server/server-task.h
+++ b/tools/server/server-task.h
@@ -649,6 +649,40 @@ struct server_prompt {
         return tokens.size();
     }
 
+    bool should_split_prompt_batch_at_user_start(
+            bool can_checkpoint,
+            bool is_user_start,
+            bool is_last_user_start,
+            int64_t n_tokens,
+            int32_t checkpoint_min_step) const {
+        if (!can_checkpoint || !is_user_start) {
+            return false;
+        }
+
+        return is_last_user_start || checkpoints.empty() ||
+            n_tokens > checkpoints.back().n_tokens + checkpoint_min_step;
+    }
+
+    std::list<common_prompt_checkpoint> take_stale_checkpoints_within_min_step(
+            int id_task,
+            int32_t checkpoint_min_step) {
+        std::list<common_prompt_checkpoint> removed;
+        int64_t last = -1;
+
+        for (auto it = checkpoints.begin(); it != checkpoints.end();) {
+            if (it->id_task != id_task && last >= 0 &&
+                    it->n_tokens <= last + checkpoint_min_step) {
+                removed.splice(removed.end(), checkpoints, it++);
+                continue;
+            }
+
+            last = it->n_tokens;
+            ++it;
+        }
+
+        return removed;
+    }
+
     server_prompt clone() const {
         return server_prompt {
             tokens.clone(),
