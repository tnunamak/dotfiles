diff --git a/tests/test-server-prompt-checkpoint.cpp b/tests/test-server-prompt-checkpoint.cpp
index 2382ea07d..d079d5869 100644
--- a/tests/test-server-prompt-checkpoint.cpp
+++ b/tests/test-server-prompt-checkpoint.cpp
@@ -3,6 +3,70 @@
 #undef NDEBUG
 #include <cassert>
 
+static common_prompt_checkpoint checkpoint(int64_t n_tokens, int id_task) {
+    common_prompt_checkpoint checkpoint;
+    checkpoint.n_tokens = n_tokens;
+    checkpoint.id_task = id_task;
+    checkpoint.pos_min = n_tokens;
+    checkpoint.pos_max = n_tokens;
+    return checkpoint;
+}
+
+static void test_min_step_controls_prompt_splitting() {
+    server_prompt prompt;
+    prompt.checkpoints.push_back(checkpoint(/* n_tokens = */ 100, /* id_task = */ 1));
+
+    assert(!prompt.should_split_prompt_batch_at_user_start(
+            /* can_checkpoint = */ false,
+            /* is_user_start = */ true,
+            /* is_last_user_start = */ true,
+            /* n_tokens = */ 101,
+            /* checkpoint_min_step = */ 32));
+    assert(!prompt.should_split_prompt_batch_at_user_start(
+            /* can_checkpoint = */ true,
+            /* is_user_start = */ true,
+            /* is_last_user_start = */ false,
+            /* n_tokens = */ 132,
+            /* checkpoint_min_step = */ 32));
+    assert(prompt.should_split_prompt_batch_at_user_start(
+            /* can_checkpoint = */ true,
+            /* is_user_start = */ true,
+            /* is_last_user_start = */ false,
+            /* n_tokens = */ 133,
+            /* checkpoint_min_step = */ 32));
+    assert(prompt.should_split_prompt_batch_at_user_start(
+            /* can_checkpoint = */ true,
+            /* is_user_start = */ true,
+            /* is_last_user_start = */ true,
+            /* n_tokens = */ 101,
+            /* checkpoint_min_step = */ 32));
+}
+
+static void test_hybrid_recurrent_checkpoints_keep_useful_spread() {
+    server_prompt prompt;
+    prompt.checkpoints.push_back(checkpoint(/* n_tokens = */ 64,  /* id_task = */ 1));
+    prompt.checkpoints.push_back(checkpoint(/* n_tokens = */ 80,  /* id_task = */ 2));
+    prompt.checkpoints.push_back(checkpoint(/* n_tokens = */ 320, /* id_task = */ 1));
+    prompt.checkpoints.push_back(checkpoint(/* n_tokens = */ 336, /* id_task = */ 2));
+
+    const auto removed = prompt.take_stale_checkpoints_within_min_step(
+            /* id_task = */ 3,
+            /* checkpoint_min_step = */ 64);
+
+    assert(removed.size() == 2);
+    assert(removed.front().n_tokens == 80);
+    assert(removed.back().n_tokens == 336);
+    assert(prompt.checkpoints.size() == 2);
+    assert(prompt.checkpoints.front().n_tokens == 64);
+    assert(prompt.checkpoints.back().n_tokens == 320);
+
+    prompt.checkpoints.push_back(checkpoint(/* n_tokens = */ 336, /* id_task = */ 4));
+    prompt.checkpoints.push_back(checkpoint(/* n_tokens = */ 352, /* id_task = */ 4));
+    assert(prompt.take_stale_checkpoints_within_min_step(
+            /* id_task = */ 4,
+            /* checkpoint_min_step = */ 64).empty());
+}
+
 int main() {
     server_prompt_checkpoint ckpt {
         /*.pos_min  = */ 1,
@@ -22,5 +86,8 @@ int main() {
     assert(ckpt.ring_data.empty());
     assert(ckpt.ring_data.capacity() == 0);
 
+    test_min_step_controls_prompt_splitting();
+    test_hybrid_recurrent_checkpoints_keep_useful_spread();
+
     return 0;
 }
