#!/usr/bin/env bash
# Wait for a restore-created tmux session/window to become addressable, then
# launch Daisy.  A transient absence is normal while tmux-resurrect rebuilds
# layouts; fail only after a bounded retry so systemd can report a real fault.
set -euo pipefail

CLAIM_COMMAND="${DAISY_TMUX_CLAIM_COMMAND:-$HOME/.local/bin/daisy-tmux-window-claim}"
ATTEMPTS="${DAISY_TMUX_READY_ATTEMPTS:-30}"
RETRY_DELAY="${DAISY_TMUX_READY_RETRY_DELAY:-1}"

[[ "$ATTEMPTS" =~ ^[1-9][0-9]*$ ]] || {
  echo "daisy-tmux-resilient-start: attempts must be a positive integer" >&2
  exit 2
}
[[ "$#" -gt 0 ]] || {
  echo "Usage: daisy-tmux-resilient-start COMMAND [ARG...]" >&2
  exit 2
}

for (( attempt = 1; attempt <= ATTEMPTS; attempt++ )); do
  if "$CLAIM_COMMAND"; then
    exec "$@"
  fi
  if (( attempt < ATTEMPTS )); then
    printf 'daisy-tmux-resilient-start: tmux target unavailable; retrying (%d/%d)\n' \
      "$attempt" "$ATTEMPTS" >&2
    sleep "$RETRY_DELAY"
  fi
done

printf 'daisy-tmux-resilient-start: tmux target did not become ready after %s attempts\n' \
  "$ATTEMPTS" >&2
exit 1
