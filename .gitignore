# Claude Code runtime (repo root only, not the stow package).
# Allow .claude/skills/ so project skills can be committed.
/.claude/*
!/.claude/skills/
.nvimlog

# Python bytecode
__pycache__/
*.py[cod]

# Playwright MCP logs
.playwright-mcp/

# Session artifacts
SESSION-NOTES.md

# tmux plugins (installed by tpm at runtime)
tmux/.config/tmux/plugins/

# Local-only: NVIDIA 595 availability watcher (delete after 595 is installed)
/nvidia-watch/
