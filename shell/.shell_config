# Shared shell config — sourced by both .zshrc and .bashrc

# Complete pam_kwallet5's headless login handoff before attaching to an
# existing tmux server (which has an older environment) or hydrating secrets.
if [[ -n "${PAM_KWALLET5_LOGIN:-}" ]] &&
   [[ -x /usr/share/libpam-kwallet-common/pam_kwallet_init ]]; then
  QT_QPA_PLATFORM=offscreen /usr/share/libpam-kwallet-common/pam_kwallet_init
  unset PAM_KWALLET5_LOGIN
fi

# Auto-attach Kitty and SSH pseudo-terminals to a per-client grouped tmux
# session (skip with NOTMUX=1 for debugging tmux itself). Keep Linux virtual
# consoles (/dev/tty1, /dev/tty2, ...) outside tmux by default: they are the
# recovery shell when the desktop or a terminal UI is broken.
_shell_tty="$(tty 2>/dev/null || true)"
_shell_is_virtual_console=
case "$_shell_tty" in
  /dev/tty[0-9]*) _shell_is_virtual_console=1 ;;
esac
if [[ -z "$NOTMUX" ]] && [[ $- == *i* ]] && [[ -z "$TMUX" ]] &&
   [[ -z "$_shell_is_virtual_console" ]] && command -v tmux &>/dev/null; then
  exec "$HOME/.local/bin/tmux-local-attach-main"
fi
unset _shell_tty _shell_is_virtual_console

# Platform detection
case "$(uname)" in
  Darwin) IS_MACOS=1 ;;
  Linux)  IS_LINUX=1 ;;
esac

# Editor
export EDITOR=nvim
export VISUAL=nvim

# PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/.foundry/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/go/bin:$PATH"

# GPG
export GPG_TTY=$(tty)

# Privacy
export DO_NOT_TRACK=1
export RTK_TELEMETRY_DISABLED=1

# Claude Code: speed up mouse-wheel scrolling in fullscreen rendering mode
# (1-20). Default 1 sends one terminal line per wheel notch which feels glacial
# inside a long conversation. 6 is brisk without being motion-sickness-y.
export CLAUDE_CODE_SCROLL_SPEED=6

# Kitty: use SSH kitten for automatic terminfo + shell integration
[[ "$TERM" == "xterm-kitty" ]] && alias ssh='kitten ssh'

# Aliases
alias ll='ls -lah'
alias la='ls -A'
alias gs='git status'
alias gd='git diff'
alias gl='git log --oneline -20'


if [[ -n "$IS_LINUX" ]]; then
  alias pbcopy='xclip -selection clipboard'
fi

# Systemd (Linux only)
if [[ -n "$IS_LINUX" ]]; then
  alias sbase='systemctl --user'
  alias slist='systemctl --user list-units --type=service --all'
  alias son='systemctl --user start'
  alias soff='systemctl --user stop'
  alias slog='journalctl --user -f -u'
fi

alias lsports="sudo lsof -iTCP -sTCP:LISTEN -n -P | awk 'NR>1 {print \$9, \$1, \$2}' | sed 's/.*://' | while read -r port process pid; do echo \"Port \$port: \$(ps -p \$pid -o command= | sed 's/^-//') (PID: \$pid)\"; done | sort -n"

# Devcontainer helpers
alias link-devcontainer='ln -sf "$HOME/code/dotfiles/devcontainer" .devcontainer'
alias unlink-devcontainer='rm .devcontainer'

# Kimi: ensure AGENTS.md exists in project dir (no global config support)
kimi() {
  [[ ! -e AGENTS.md ]] && [[ -f ~/code/dotfiles/ai/AGENTS.md ]] && \
    ln -s ~/code/dotfiles/ai/AGENTS.md AGENTS.md 2>/dev/null
  command kimi "$@"
}

droot() {
  if [[ -z "$1" ]] || [[ -z "$2" ]]; then
    echo "Usage: droot <container-name> <command...>"
    return 1
  fi
  local container="$1"
  shift
  docker exec -u root "$container" "$@"
}

firewall-on() {
  [[ -z "$1" ]] && { echo "Usage: firewall-on <container-name>"; return 1; }
  docker exec "$1" /workspace/.devcontainer/research-mode-toggle.sh on
}

firewall-off() {
  [[ -z "$1" ]] && { echo "Usage: firewall-off <container-name>"; return 1; }
  docker exec "$1" /workspace/.devcontainer/research-mode-toggle.sh off
}

firewall-status() {
  [[ -z "$1" ]] && { echo "Usage: firewall-status <container-name>"; return 1; }
  docker exec "$1" /workspace/.devcontainer/research-mode-toggle.sh status
}

# SSH agent (persistent across terminals)
if [[ -n "$IS_LINUX" ]]; then
  export SSH_AUTH_SOCK=~/.ssh/ssh_auth_sock
  ssh-add -l > /dev/null 2>&1
  _ssh_agent_status=$?
  if (( _ssh_agent_status == 2 )); then
    # A stale socket can still exist after its ssh-agent died.  Test the agent,
    # not merely the socket path, before reusing it.
    eval "$(ssh-agent -s)" > /dev/null
    ln -sf "$SSH_AUTH_SOCK" ~/.ssh/ssh_auth_sock
    ssh-add -l > /dev/null 2>&1
    _ssh_agent_status=$?
  fi
  # Exit 1 means the agent is healthy but has no identities; 2 means it could
  # not be contacted.  Never leak the latter into every new terminal.
  (( _ssh_agent_status == 1 )) && ssh-add -q > /dev/null 2>&1 || true
  unset _ssh_agent_status
fi

# Secrets — hydrate from Infisical (personal-dev/dev). Its encrypted local cache
# keeps this same export path working during a server outage; there is no
# plaintext fallback. Live export runs per shell (~100-300ms).
if command -v infisical >/dev/null 2>&1; then
  # timeout + </dev/null guard against infisical's expired-session re-auth: on a
  # tty it spawns a blocking `login --silent` that never returns (hung every new
  # terminal on 2026-07-23).
  _inf_timeout=timeout
  command -v "$_inf_timeout" >/dev/null 2>&1 || _inf_timeout=gtimeout
  if command -v "$_inf_timeout" >/dev/null 2>&1 && _inf_secrets="$("$_inf_timeout" 5 infisical export \
    --projectId=894e048b-954c-4c5a-a1d0-888c54c9ce66 \
    --env=dev --format=dotenv-export \
    --domain=https://secrets.vivid.fish 2>/dev/null </dev/null)"; then
    eval "$_inf_secrets"
  elif [[ $- == *i* ]]; then
    printf '%s\n' 'Infisical secrets unavailable. Run: infisical login --domain=https://secrets.vivid.fish'
  fi
  unset _inf_secrets _inf_timeout
elif [[ $- == *i* ]]; then
  printf '%s\n' 'Infisical CLI not installed; managed shell secrets are unavailable.'
fi

# Machine-specific config (nvm, conda, android, etc.)
[[ -f ~/.shell_local ]] && . ~/.shell_local

# Startup status (print cached, refresh in background)
if [[ $- == *i* ]] && [[ -z "$_SHELL_STATUS_RAN" ]]; then
  export _SHELL_STATUS_RAN=1
  [[ -f ~/.cache/shell-status/summary ]] && printf '%b\n' "$(cat ~/.cache/shell-status/summary)"
  ( shell-status-refresh &>/dev/null & )
  ( cleanup --refresh &>/dev/null & )
fi

# Tokensmash crossover study launchers (fail-open; ~/code/tokensmash/PROTOCOL.md).
# Remove these two functions to fully disable actuation.
claude() { tokensmash-launch claude "$@"; }
codex() { tokensmash-launch codex "$@"; }
